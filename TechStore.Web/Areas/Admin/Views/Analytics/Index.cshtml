@model TechStore.Web.Areas.Admin.Models.AnalyticsDashboardViewModel
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu & Phân Tích Kinh Doanh";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var maxRevenue = Model.MonthlyTrends.Any() ? Model.MonthlyTrends.Max(m => m.Revenue) : 1;
    if (maxRevenue == 0) maxRevenue = 1;

    var totalPaymentCount = Model.CodOrdersCount + Model.VietQrOrdersCount;
    var codPercent = totalPaymentCount > 0 ? (int)Math.Round((double)Model.CodOrdersCount / totalPaymentCount * 100) : 0;
    var vietQrPercent = totalPaymentCount > 0 ? (int)Math.Round((double)Model.VietQrOrdersCount / totalPaymentCount * 100) : 0;
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Header & CSV Export Actions -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <svg class="w-7 h-7 text-[#0046be]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Báo Cáo Hoạt Động Kinh Doanh & Doanh Thu
            </h1>
            <p class="text-sm text-slate-500 mt-1">Tổng quan các chỉ số tài chính, phương thức thanh toán, xu hướng doanh thu và xuất file báo cáo</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="ExportOrdersCsv" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 shadow-sm transition">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Xuất Đơn Hàng (.CSV)
            </a>
            <a asp-action="ExportCustomersCsv" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 shadow-sm transition">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Xuất Khách Hàng (.CSV)
            </a>
            <a asp-action="ExportInventoryCsv" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 shadow-sm transition">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Xuất Báo Cáo Kho (.CSV)
            </a>
        </div>
    </div>

    <!-- 5 Core Business KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng Doanh Thu</p>
                <span class="p-2 bg-blue-50 text-[#0046be] rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <h3 class="text-xl font-bold text-[#0046be] mt-2">@Model.TotalRevenue.ToString("N0") ₫</h3>
            <p class="text-[11px] text-slate-400 mt-1">Doanh thu thực tế đã thu tiền</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tháng Hiện Tại</p>
                <span class="p-2 bg-emerald-50 text-emerald-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </span>
            </div>
            <h3 class="text-xl font-bold text-emerald-600 mt-2">@Model.MonthlyRevenue.ToString("N0") ₫</h3>
            <p class="text-[11px] text-slate-400 mt-1">Từ đầu tháng đến hiện tại</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng Số Đơn</p>
                <span class="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                </span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mt-2">@Model.TotalOrdersCount</h3>
            <p class="text-[11px] text-slate-400 mt-1">Bao gồm toàn bộ các trạng thái</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Giá Trị Đơn TB</p>
                <span class="p-2 bg-amber-50 text-amber-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                </span>
            </div>
            <h3 class="text-xl font-bold text-amber-600 mt-2">@Model.AverageOrderValue.ToString("N0") ₫</h3>
            <p class="text-[11px] text-slate-400 mt-1">AOV trên các đơn hoàn tất</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Khách Mới / Tháng</p>
                <span class="p-2 bg-purple-50 text-purple-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                </span>
            </div>
            <h3 class="text-xl font-bold text-purple-600 mt-2">+@Model.NewCustomersThisMonth</h3>
            <p class="text-[11px] text-slate-400 mt-1">Đăng ký mới tháng này</p>
        </div>
    </div>

    <!-- Charts & Payment Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- 6-Month Revenue Trend (8 cols) -->
        <div class="lg:col-span-8 bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <svg class="w-5 h-5 text-[#0046be]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" /></svg>
                        Xu Hướng Doanh Thu (6 Tháng Gần Nhất)
                    </h3>
                    <p class="text-xs text-slate-500">Biểu đồ đối soát doanh thu hoàn tất theo từng tháng</p>
                </div>
            </div>

            <!-- Custom Clean SVG & Bar Chart -->
            <div class="pt-6 pb-2">
                <div class="grid grid-cols-6 gap-3 items-end h-64 border-b border-slate-200 px-2">
                    @foreach (var item in Model.MonthlyTrends)
                    {
                        var heightPercent = (int)Math.Max(5, Math.Round((double)item.Revenue / (double)maxRevenue * 100));
                        <div class="flex flex-col items-center h-full justify-end group relative">
                            <!-- Tooltip on hover -->
                            <div class="opacity-0 group-hover:opacity-100 transition-opacity absolute -top-12 bg-slate-900 text-white text-[10px] font-semibold py-1 px-2 rounded shadow whitespace-nowrap pointer-events-none z-10">
                                @item.Revenue.ToString("N0") ₫ (@item.OrderCount đơn)
                            </div>
                            
                            <div class="w-full max-w-[48px] bg-gradient-to-t from-[#002e7a] to-[#0046be] rounded-t-lg transition-all duration-300 hover:brightness-110 shadow-sm relative"
                                 style="height: @(heightPercent)%;">
                            </div>
                            <span class="text-[11px] font-medium text-slate-600 mt-2 block">@item.MonthLabel</span>
                        </div>
                    }
                </div>
                <div class="flex items-center justify-between text-xs text-slate-400 mt-3 px-2">
                    <span>Cột mốc 6 tháng trước</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-[#0046be] rounded"></span> Doanh thu thực tế (VNĐ)</span>
                    <span>Tháng hiện tại</span>
                </div>
            </div>
        </div>

        <!-- Payment Breakdown & Share (4 cols) -->
        <div class="lg:col-span-4 bg-white border border-slate-200 rounded-xl shadow-sm p-6 space-y-5">
            <div class="border-b border-slate-100 pb-3">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
                    Cơ Cấu Cổng Thanh Toán
                </h3>
                <p class="text-xs text-slate-500">Tỷ lệ thanh toán không tiền mặt (VietQR) vs COD</p>
            </div>

            <!-- Visual Progress Bar -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs font-semibold text-slate-700">
                    <span class="flex items-center gap-1 text-amber-700"><span class="w-2 h-2 rounded-full bg-amber-500"></span> VietQR (@vietQrPercent%)</span>
                    <span class="flex items-center gap-1 text-slate-600"><span class="w-2 h-2 rounded-full bg-slate-400"></span> COD (@codPercent%)</span>
                </div>
                <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden flex shadow-inner">
                    <div class="bg-amber-500 h-full transition-all duration-500" style="width: @(vietQrPercent)%;"></div>
                    <div class="bg-slate-400 h-full transition-all duration-500" style="width: @(codPercent)%;"></div>
                </div>
            </div>

            <!-- Details List -->
            <div class="space-y-3 pt-2">
                <div class="p-3 bg-amber-50/60 border border-amber-200 rounded-xl">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span> Chuyển Khoản VietQR
                        </span>
                        <span class="text-xs font-bold text-amber-700">@Model.VietQrOrdersCount đơn</span>
                    </div>
                    <p class="text-sm font-bold text-amber-900 mt-1">@Model.VietQrRevenue.ToString("N0") ₫</p>
                </div>

                <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-slate-400"></span> Tiền Mặt Khi Nhận (COD)
                        </span>
                        <span class="text-xs font-bold text-slate-600">@Model.CodOrdersCount đơn</span>
                    </div>
                    <p class="text-sm font-bold text-slate-900 mt-1">@Model.CodRevenue.ToString("N0") ₫</p>
                </div>
            </div>

            <!-- Order Status Distribution -->
            <div class="border-t border-slate-100 pt-4 space-y-2">
                <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Phân Bổ Trạng Thái</h4>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="p-2 bg-emerald-50 rounded border border-emerald-100 flex justify-between">
                        <span class="text-emerald-800">Hoàn Tất:</span>
                        <span class="font-bold text-emerald-900">@(Model.StatusDistribution.GetValueOrDefault("Delivered", 0))</span>
                    </div>
                    <div class="p-2 bg-sky-50 rounded border border-sky-100 flex justify-between">
                        <span class="text-sky-800">Đang Giao:</span>
                        <span class="font-bold text-sky-900">@(Model.StatusDistribution.GetValueOrDefault("Shipping", 0))</span>
                    </div>
                    <div class="p-2 bg-indigo-50 rounded border border-indigo-100 flex justify-between">
                        <span class="text-indigo-800">Đang Xử Lý:</span>
                        <span class="font-bold text-indigo-900">@(Model.StatusDistribution.GetValueOrDefault("Processing", 0))</span>
                    </div>
                    <div class="p-2 bg-rose-50 rounded border border-rose-100 flex justify-between">
                        <span class="text-rose-800">Đã Hủy:</span>
                        <span class="font-bold text-rose-900">@(Model.StatusDistribution.GetValueOrDefault("Cancelled", 0))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Selling Products & Recent Orders -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Top 5 Best Sellers (6 cols) -->
        <div class="lg:col-span-6 bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    Top 5 Sản Phẩm Bán Chạy Nhất
                </h3>
            </div>
            <div class="divide-y divide-slate-100">
                @if (!Model.TopProducts.Any())
                {
                    <p class="p-8 text-center text-xs text-slate-400">Chưa có dữ liệu giao dịch sản phẩm.</p>
                }
                @for (int i = 0; i < Model.TopProducts.Count; i++)
                {
                    var p = Model.TopProducts[i];
                    <div class="p-4 flex items-center justify-between hover:bg-slate-50 transition">
                        <div class="flex items-center gap-3 min-w-0">
                            <span class="w-6 text-center font-bold text-sm @(i == 0 ? "text-amber-500" : i == 1 ? "text-slate-400" : i == 2 ? "text-amber-700" : "text-slate-300")">#@(i + 1)</span>
                            <img src="@p.FeaturedImage" alt="@p.Name" class="w-11 h-11 object-cover rounded-lg border border-slate-200 shrink-0" />
                            <div class="min-w-0">
                                <h4 class="text-xs font-bold text-slate-900 truncate">@p.Name</h4>
                                <p class="text-[11px] text-slate-400">Danh mục: @p.CategoryName</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0 ml-3">
                            <span class="text-xs font-bold text-emerald-600 block">Đã bán: @p.TotalQuantitySold</span>
                            <span class="text-[11px] text-slate-500">@p.TotalRevenue.ToString("N0") ₫</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Orders (6 cols) -->
        <div class="lg:col-span-6 bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#0046be]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Đơn Hàng Mới Nhất
                </h3>
                <a asp-controller="Order" asp-action="Index" class="text-xs text-[#0046be] hover:underline font-semibold">Xem tất cả &rarr;</a>
            </div>
            <div class="divide-y divide-slate-100">
                @if (!Model.RecentOrders.Any())
                {
                    <p class="p-8 text-center text-xs text-slate-400">Chưa có đơn hàng nào.</p>
                }
                @foreach (var o in Model.RecentOrders)
                {
                    <div class="p-4 flex items-center justify-between hover:bg-slate-50 transition text-xs">
                        <div>
                            <div class="flex items-center gap-2">
                                <a asp-controller="Order" asp-action="Detail" asp-route-id="@o.OrderId" class="font-bold text-slate-900 hover:text-[#0046be] transition">
                                    @o.OrderCode
                                </a>
                                @if (o.PaymentMethod == "VietQR")
                                {
                                    <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">VietQR</span>
                                }
                                else
                                {
                                    <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">COD</span>
                                }
                            </div>
                            <p class="text-slate-500 text-[11px] mt-0.5">@o.CustomerName &bull; @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="text-right">
                            <span class="font-bold text-slate-900 block">@o.TotalAmount.ToString("N0") ₫</span>
                            <span class="text-[10px] @(o.OrderStatus == "Delivered" ? "text-emerald-600 font-semibold" : o.OrderStatus == "Cancelled" ? "text-rose-600 font-semibold" : "text-slate-400")">
                                @o.OrderStatus
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@model List<TechStore.Core.Entities.Banner>
@{
    ViewData["Title"] = "Quản Lý Banner & Quảng Cáo Động";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Quản Lý Banner CMS</h1>
            <p class="text-sm text-slate-500 mt-1">Cấu hình banner slider trang chủ, banner danh mục và quảng cáo khuyến mãi linh hoạt.</p>
        </div>
        <button onclick="openCreateModal()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Thêm Banner Mới</span>
        </button>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Position Filters -->
    <div class="flex flex-wrap items-center gap-2">
        <a href="/Admin/Banner" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "All" ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Tất Cả Vị Trí</a>
        <a href="/Admin/Banner?position=HomeHeroSlider" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "HomeHeroSlider" ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Slider Trang Chủ</a>
        <a href="/Admin/Banner?position=HomeSubBanner" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "HomeSubBanner" ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Banner Phụ Trang Chủ</a>
        <a href="/Admin/Banner?position=PromoPopup" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "PromoPopup" ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Popup Khuyến Mãi</a>
    </div>

    <!-- Banner Grid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var b in Model)
        {
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm flex flex-col justify-between">
                <div>
                    <!-- Banner Image Preview -->
                    <div class="relative h-44 bg-slate-100 overflow-hidden group">
                        <img src="@b.ImageUrl" alt="@b.Title" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/placeholder.png'" />
                        <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-bold bg-white/90 backdrop-blur rounded-md text-slate-800 shadow-sm">
                            @b.Position
                        </span>
                        <span class="absolute top-3 right-3 px-2 py-0.5 text-xs font-bold rounded-md @(b.IsActive ? "bg-emerald-500 text-white" : "bg-slate-400 text-white")">
                            @(b.IsActive ? "Đang chạy" : "Tạm dừng")
                        </span>
                    </div>

                    <!-- Banner Details -->
                    <div class="p-4 space-y-2">
                        <h3 class="font-bold text-slate-900 text-base line-clamp-1">@b.Title</h3>
                        @if (!string.IsNullOrEmpty(b.Subtitle))
                        {
                            <p class="text-xs text-slate-500 line-clamp-2">@b.Subtitle</p>
                        }
                        <div class="text-xs text-slate-400">
                            <span>Link đích: </span>
                            <span class="text-blue-600 font-medium">@(string.IsNullOrEmpty(b.TargetUrl) ? "Không có" : b.TargetUrl)</span>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                    <button onclick="toggleBannerStatus(@b.BannerId)" class="text-xs font-medium text-slate-600 hover:text-blue-600">
                        Bật/Tắt Trạng Thái
                    </button>
                    <form action="/Admin/Banner/Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa Banner này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.BannerId" />
                        <button type="submit" class="text-xs font-medium text-rose-600 hover:text-rose-700">Xóa</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Form Thêm Banner Mới -->
<div id="bannerModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-900">Thêm Banner Quảng Cáo</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
        </div>
        <form action="/Admin/Banner/Save" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BannerId" value="0" />
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tiêu Đề Banner *</label>
                <input type="text" name="Title" required class="w-full text-sm border border-slate-300 rounded-lg p-2.5 focus:ring-blue-500 focus:border-blue-500" placeholder="VD: Lễ Hội Công Nghệ 2026" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Phụ Đề (Subtitle)</label>
                <input type="text" name="Subtitle" class="w-full text-sm border border-slate-300 rounded-lg p-2.5 focus:ring-blue-500 focus:border-blue-500" placeholder="VD: Giảm ngay 3.000.000đ khi thanh toán VietQR" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Đường Dẫn Ảnh (URL) *</label>
                <input type="text" name="ImageUrl" required class="w-full text-sm border border-slate-300 rounded-lg p-2.5 focus:ring-blue-500 focus:border-blue-500" placeholder="VD: /assets/images/iphone-16-pro-max.png" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Vị Trí Hiển Thị</label>
                    <select name="Position" class="w-full text-sm border border-slate-300 rounded-lg p-2.5">
                        <option value="HomeHeroSlider">Slider Chính</option>
                        <option value="HomeSubBanner">Banner Phụ</option>
                        <option value="PromoPopup">Popup Quảng Cáo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Thứ Tự Ưu Tiên</label>
                    <input type="number" name="DisplayOrder" value="1" class="w-full text-sm border border-slate-300 rounded-lg p-2.5" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Link Điều Hướng (Target URL)</label>
                <input type="text" name="TargetUrl" class="w-full text-sm border border-slate-300 rounded-lg p-2.5" placeholder="VD: /product/iphone-16-pro-max" />
            </div>
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg">Hủy</button>
                <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">Lưu Banner</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCreateModal() { document.getElementById('bannerModal').classList.remove('hidden'); }
    function closeModal() { document.getElementById('bannerModal').classList.add('hidden'); }
    async function toggleBannerStatus(id) {
        const res = await fetch(`/Admin/Banner/ToggleStatus?id=${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) location.reload();
    }
</script>
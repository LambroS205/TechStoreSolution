@using System.Text.Encodings.Web
@model List<TechStore.Core.Entities.Banner>
@{
    ViewData["Title"] = "Quản Lý Banner Quảng Cáo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Quản Lý Banner Quảng Cáo</h1>
            <p class="text-xs text-slate-500 mt-1">Cấu hình các slide trình chiếu Hero Banner, banner phụ và chiến dịch khuyến mãi</p>
        </div>
        <button onclick="openCreateModal()" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center gap-2 self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>Thêm Banner Mới</span>
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between">
            <span>@TempData["SuccessMessage"]</span>
            <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between">
            <span>@TempData["ErrorMessage"]</span>
            <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">&times;</button>
        </div>
    }

    <!-- Position Filters -->
    <div class="flex flex-wrap items-center gap-2">
        <a href="/Admin/Banner" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "All" ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Tất Cả Vị Trí</a>
        <a href="/Admin/Banner?position=HomeHeroSlider" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "HomeHeroSlider" ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Slider Trang Chủ</a>
        <a href="/Admin/Banner?position=HomeSubBanner" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "HomeSubBanner" ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Banner Phụ Trang Chủ</a>
        <a href="/Admin/Banner?position=PromoPopup" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg @(ViewBag.CurrentPosition == "PromoPopup" ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")">Popup Khuyến Mãi</a>
    </div>

    <!-- Banner Grid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var b in Model)
        {
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <!-- Banner Image Preview -->
                    <div class="relative h-44 bg-slate-100 overflow-hidden group">
                        <img src="@b.ImageUrl" alt="@b.Title" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/placeholder.png'" />
                        <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-bold bg-white/90 backdrop-blur rounded-lg text-slate-800 shadow-sm">
                            @b.Position
                        </span>
                        <span class="absolute top-3 right-3 px-2 py-0.5 text-xs font-bold rounded-lg @(b.IsActive ? "bg-emerald-500 text-white" : "bg-slate-400 text-white")">
                            @(b.IsActive ? "Đang chạy" : "Tạm dừng")
                        </span>
                    </div>

                    <!-- Banner Details -->
                    <div class="p-4 space-y-2">
                        <div class="flex items-center justify-between">
                            <h3 class="font-bold text-slate-900 text-base line-clamp-1">@b.Title</h3>
                            <span class="text-[11px] font-mono text-slate-400">#@b.DisplayOrder</span>
                        </div>
                        @if (!string.IsNullOrEmpty(b.Subtitle))
                        {
                            <p class="text-xs text-slate-500 line-clamp-2">@b.Subtitle</p>
                        }
                        <div class="text-xs text-slate-400">
                            <span>Link đích: </span>
                            <span class="text-blue-600 font-medium">@(string.IsNullOrEmpty(b.TargetUrl) ? "Không có" : b.TargetUrl)</span>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2.5">
                        <button onclick="toggleBannerStatus(@b.BannerId)" class="font-bold text-slate-600 hover:text-blue-600">
                            @(b.IsActive ? "Tạm dừng" : "Kích hoạt")
                        </button>
                        <span>&bull;</span>
                        <button type="button" 
                                onclick="openEditModal({ id: @b.BannerId, title: '@Html.Raw(JavaScriptEncoder.Default.Encode(b.Title))', subtitle: '@Html.Raw(JavaScriptEncoder.Default.Encode(b.Subtitle ?? ""))', imageUrl: '@Html.Raw(JavaScriptEncoder.Default.Encode(b.ImageUrl))', targetUrl: '@Html.Raw(JavaScriptEncoder.Default.Encode(b.TargetUrl ?? ""))', position: '@b.Position', displayOrder: @b.DisplayOrder, isActive: @(b.IsActive ? "true" : "false") })" 
                                class="font-bold text-blue-600 hover:underline">
                            Sửa
                        </button>
                    </div>
                    <form action="/Admin/Banner/Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa Banner này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.BannerId" />
                        <button type="submit" class="text-slate-400 hover:text-rose-600 font-medium">Xóa</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Form Thêm / Cập Nhật Banner -->
<div id="bannerModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 border border-slate-100">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 id="modalTitle" class="text-base font-black text-slate-900">Thêm Banner Quảng Cáo</h3>
            <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-lg">&times;</button>
        </div>

        <form action="/Admin/Banner/Save" method="post" enctype="multipart/form-data" class="space-y-3.5">
            @Html.AntiForgeryToken()
            <input type="hidden" id="bannerId" name="BannerId" value="0" />

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tiêu Đề Banner <span class="text-rose-500">*</span></label>
                <input type="text" id="bannerTitle" name="Title" required class="w-full text-xs font-semibold bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" placeholder="VD: Lễ Hội Công Nghệ 2026" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Phụ Đề (Subtitle)</label>
                <input type="text" id="bannerSubtitle" name="Subtitle" class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" placeholder="VD: Giảm ngay 3.000.000đ khi thanh toán VietQR" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tải Ảnh Lên Từ Máy Tính (Khuyên dùng)</label>
                <input type="file" name="imageFile" accept="image/*" class="w-full text-xs text-slate-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Hoặc Nhập URL Hình Ảnh Trực Tiếp</label>
                <input type="text" id="bannerImageUrl" name="ImageUrl" class="w-full text-xs font-mono bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" placeholder="VD: /assets/images/banners/hero-1.webp" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Vị Trí Hiển Thị</label>
                    <select id="bannerPosition" name="Position" class="w-full text-xs font-semibold bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none">
                        <option value="HomeHeroSlider">Slider Chính (Hero)</option>
                        <option value="HomeSubBanner">Banner Phụ Cạnh Slider</option>
                        <option value="PromoPopup">Popup Quảng Cáo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Thứ Tự Ưu Tiên</label>
                    <input type="number" id="bannerDisplayOrder" name="DisplayOrder" value="1" class="w-full text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Link Điều Hướng (Target URL)</label>
                <input type="text" id="bannerTargetUrl" name="TargetUrl" class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" placeholder="VD: /product/iphone-16-pro-max" />
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" id="bannerIsActive" name="IsActive" value="true" checked class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300" />
                <label for="bannerIsActive" class="text-xs font-semibold text-slate-700">Kích hoạt hiển thị ngay</label>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition">Hủy</button>
                <button type="submit" class="px-5 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-xs transition">Lưu Banner</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCreateModal() {
        document.getElementById('modalTitle').innerText = 'Thêm Banner Quảng Cáo Mới';
        document.getElementById('bannerId').value = '0';
        document.getElementById('bannerTitle').value = '';
        document.getElementById('bannerSubtitle').value = '';
        document.getElementById('bannerImageUrl').value = '';
        document.getElementById('bannerTargetUrl').value = '';
        document.getElementById('bannerPosition').value = 'HomeHeroSlider';
        document.getElementById('bannerDisplayOrder').value = '1';
        document.getElementById('bannerIsActive').checked = true;
        document.getElementById('bannerModal').classList.remove('hidden');
    }

    function openEditModal(data) {
        document.getElementById('modalTitle').innerText = 'Cập Nhật Banner';
        document.getElementById('bannerId').value = data.id;
        document.getElementById('bannerTitle').value = data.title;
        document.getElementById('bannerSubtitle').value = data.subtitle;
        document.getElementById('bannerImageUrl').value = data.imageUrl;
        document.getElementById('bannerTargetUrl').value = data.targetUrl;
        document.getElementById('bannerPosition').value = data.position;
        document.getElementById('bannerDisplayOrder').value = data.displayOrder;
        document.getElementById('bannerIsActive').checked = data.isActive;
        document.getElementById('bannerModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('bannerModal').classList.add('hidden');
    }

    async function toggleBannerStatus(id) {
        const res = await adminFetch(`/Admin/Banner/ToggleStatus?id=${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) location.reload();
    }
</script>
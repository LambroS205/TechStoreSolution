@model TechStore.Core.Entities.Order
@{
    Layout = null;
    int stt = 1;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu Giao Hàng - #@Model.OrderCode - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: #0f172a;
        }
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                padding: 0 !important;
            }
            .print-container {
                box-shadow: none !important;
                border: none !important;
                max-width: 100% !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 p-6 min-h-screen">
    <!-- Action Bar (Hidden when printing) -->
    <div class="max-w-3xl mx-auto mb-4 flex items-center justify-between no-print">
        <a href="javascript:window.close()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold rounded-xl transition">
            &larr; Đóng cửa sổ
        </a>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                <span>In Phiếu Giao Hàng</span>
            </button>
        </div>
    </div>

    <!-- Print Container (A4 Formatted) -->
    <div class="print-container max-w-3xl mx-auto bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
        <!-- Header -->
        <div class="flex items-start justify-between border-b-2 border-slate-900 pb-5">
            <div>
                <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-xl bg-blue-600 text-yellow-300 font-black text-lg flex items-center justify-center">T</span>
                    <span class="text-xl font-black text-slate-900 tracking-tight">TechStore</span>
                </div>
                <p class="text-xs font-bold text-slate-600 mt-1">HỆ THỐNG BÁN LẺ THIẾT BỊ CÔNG NGHỆ CHÍNH HÃNG</p>
                <p class="text-[11px] text-slate-500">Website: https://techstore.vn &bull; Hotline hỗ trợ: 1800 6868</p>
            </div>
            <div class="text-right space-y-0.5">
                <h1 class="text-base font-black text-slate-900 uppercase">PHIẾU ĐÓNG GÓI & GIAO HÀNG</h1>
                <p class="text-xs font-mono font-bold text-blue-600">#@Model.OrderCode</p>
                <p class="text-[11px] text-slate-400">Ngày đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="text-[11px] text-slate-400">Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        <!-- Sender & Recipient Box -->
        <div class="grid grid-cols-2 gap-4 text-xs">
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1">
                <p class="font-extrabold uppercase text-slate-500 tracking-wider text-[10px]">BÊN GỬI (KHO HÀNG)</p>
                <p class="font-bold text-slate-900">TechStore Logistics Hub</p>
                <p class="text-slate-600">Số 123 Đường Điện Biên Phủ, Phường Đa Kao, Quận 1, TP. HCM</p>
                <p class="text-slate-600">Hotline điều phối: <strong class="text-slate-900">1800 6868</strong></p>
            </div>
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1">
                <p class="font-extrabold uppercase text-slate-500 tracking-wider text-[10px]">BÊN NHẬN (KHÁCH HÀNG)</p>
                <p class="font-bold text-slate-900 text-sm">@Model.CustomerName</p>
                <p class="text-slate-700 font-bold">SĐT: @Model.CustomerPhone</p>
                <p class="text-slate-600">Địa chỉ: @Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
                {
                    <p class="text-slate-500 italic pt-0.5">Ghi chú: "@Model.OrderNotes"</p>
                }
            </div>
        </div>

        <!-- Items Table -->
        <div class="border border-slate-200 rounded-xl overflow-hidden text-xs">
            <table class="w-full text-left">
                <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                    <tr>
                        <th class="p-2.5 text-center w-10">STT</th>
                        <th class="p-2.5">Sản Phẩm & Phân Loại</th>
                        <th class="p-2.5">Mã SKU</th>
                        <th class="p-2.5 text-center w-14">SL</th>
                        <th class="p-2.5 text-right w-24">Đơn Giá</th>
                        <th class="p-2.5 text-right w-28">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td class="p-2.5 text-center text-slate-400">@(stt++)</td>
                            <td class="p-2.5">
                                <p class="font-bold text-slate-900">@item.ProductName</p>
                                <p class="text-[11px] text-slate-500">@item.VariantName</p>
                            </td>
                            <td class="p-2.5 font-mono text-[11px] text-slate-600">@(item.Variant?.SKU ?? "N/A")</td>
                            <td class="p-2.5 text-center font-bold text-slate-900">@item.Quantity</td>
                            <td class="p-2.5 text-right text-slate-600">@item.UnitPrice.ToString("N0") đ</td>
                            <td class="p-2.5 text-right font-bold text-slate-900">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals & Payment Status Stamp -->
        <div class="flex items-start justify-between gap-6 pt-2">
            <!-- Payment Badge / Instruction Box -->
            <div class="flex-1 p-4 rounded-xl border-2 @(Model.PaymentMethod == "COD" ? "border-amber-400 bg-amber-50/50" : "border-emerald-500 bg-emerald-50/40")">
                <div class="flex items-center gap-2 mb-1">
                    <span class="w-3 h-3 rounded-full @(Model.PaymentMethod == "COD" ? "bg-amber-500" : "bg-emerald-500")"></span>
                    <strong class="text-xs uppercase tracking-wider font-black @(Model.PaymentMethod == "COD" ? "text-amber-900" : "text-emerald-900")">
                        @(Model.PaymentMethod == "COD" ? "HÌNH THỨC: THU TIỀN KHI NHẬN (COD)" : "HÌNH THỨC: CHUYỂN KHOẢN (VIETQR)")
                    </strong>
                </div>
                @if (Model.PaymentMethod == "COD")
                {
                    <p class="text-sm font-black text-amber-900">
                        TIỀN THU HỘ (COD): <span class="text-base text-rose-600">@Model.TotalAmount.ToString("N0") đ</span>
                    </p>
                    <p class="text-[11px] text-amber-700 mt-0.5">Shipper vui lòng thu đúng số tiền trên từ người nhận trước khi bàn giao bưu kiện.</p>
                }
                else
                {
                    <p class="text-sm font-black text-emerald-800">
                        TRẠNG THÁI: @(Model.PaymentStatus == "Paid" ? "ĐÃ THANH TOÁN ĐỦ (0 Đ CẦN THU)" : "CHỜ THANH TOÁN (VIETQR)")
                    </p>
                    <p class="text-[11px] text-emerald-700 mt-0.5">
                        @(Model.PaymentStatus == "Paid" ? "Đơn hàng đã được thanh toán trực tuyến. Shipper KHÔNG thu thêm bất kỳ khoản phí nào." : "Khách hàng quét mã QR thanh toán trước khi nhận.")
                    </p>
                }
            </div>

            <!-- Financial Summary -->
            <div class="w-64 space-y-1.5 text-xs text-slate-600">
                <div class="flex justify-between">
                    <span>Tạm tính:</span>
                    <strong class="text-slate-900 font-bold">@Model.SubTotal.ToString("N0") đ</strong>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="flex justify-between text-emerald-700">
                        <span>Giảm giá coupon:</span>
                        <strong>-@Model.DiscountAmount.ToString("N0") đ</strong>
                    </div>
                }
                <div class="flex justify-between">
                    <span>Phí vận chuyển:</span>
                    <strong class="text-emerald-600">Miễn phí</strong>
                </div>
                <div class="flex justify-between text-sm font-extrabold text-slate-900 pt-2 border-t border-slate-200">
                    <span>TỔNG CỘNG:</span>
                    <span class="text-base text-blue-600 font-black">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <!-- Signatures -->
        <div class="grid grid-cols-3 gap-4 pt-8 text-center text-xs text-slate-600">
            <div>
                <p class="font-bold text-slate-800">Người Đóng Gói</p>
                <p class="text-[11px] text-slate-400 italic mt-0.5">(Ký, ghi rõ họ tên)</p>
                <div class="h-16"></div>
            </div>
            <div>
                <p class="font-bold text-slate-800">Nhân Viên Giao Hàng</p>
                <p class="text-[11px] text-slate-400 italic mt-0.5">(Ký, ghi rõ họ tên)</p>
                <div class="h-16"></div>
            </div>
            <div>
                <p class="font-bold text-slate-800">Người Nhận Hàng</p>
                <p class="text-[11px] text-slate-400 italic mt-0.5">(Đã kiểm tra & nhận đủ hàng)</p>
                <div class="h-16"></div>
            </div>
        </div>

        <!-- Footer Notice -->
        <div class="text-center pt-4 border-t border-dashed border-slate-200 text-[10px] text-slate-400">
            Cảm ơn quý khách đã mua sắm tại TechStore! Quý khách vui lòng đồng kiểm ngoại quan thiết bị cùng shipper trước khi nhận hàng.
        </div>
    </div>

    <script>
        // Tự động mở hộp thoại in sau khi tải trang
        window.addEventListener('load', () => {
            setTimeout(() => {
                window.print();
            }, 500);
        });
    </script>
</body>
</html>

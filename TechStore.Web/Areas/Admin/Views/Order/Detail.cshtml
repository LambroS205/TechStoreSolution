@model TechStore.Core.Entities.Order
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng #{Model.OrderCode}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var histories = Model.StatusHistories.OrderByDescending(h => h.ChangedAt).ToList();
}

<div class="p-6 max-w-6xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a href="/Admin/Order" class="hover:text-blue-600">Đơn hàng</a>
                <span>/</span>
                <span class="text-slate-700">#@Model.OrderCode</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-3">
                <span>Đơn Hàng #@Model.OrderCode</span>
                <span class="text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider @(Model.OrderStatus switch {
                    "Pending" => "bg-amber-100 text-amber-800",
                    "Processing" => "bg-blue-100 text-blue-800",
                    "Shipping" => "bg-indigo-100 text-indigo-800",
                    "Delivered" => "bg-emerald-100 text-emerald-800",
                    "Cancelled" => "bg-rose-100 text-rose-800",
                    _ => "bg-slate-100 text-slate-700"
                })">
                    @Model.OrderStatus
                </span>
            </h1>
            <p class="text-xs text-slate-400 mt-0.5">Đặt lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </div>

        <a href="/Admin/Order" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
            Quay Lại Danh Sách
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between shadow-xs">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }

    <!-- Grid Layout: Customer Info & Status Updater -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Customer Info Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-3">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider pb-2 border-b border-slate-100">
                Thông Tin Khách Hàng
            </h2>
            <div class="space-y-1.5 text-xs text-slate-700">
                <p><span class="text-slate-400">Người nhận:</span> <strong class="text-slate-900 font-bold">@Model.CustomerName</strong></p>
                <p><span class="text-slate-400">Số điện thoại:</span> <strong class="text-slate-900">@Model.CustomerPhone</strong></p>
                <p><span class="text-slate-400">Email:</span> @(Model.CustomerEmail ?? "Không cung cấp")</p>
                <p><span class="text-slate-400">Địa chỉ:</span> @Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
                {
                    <p class="pt-2 border-t border-slate-100 text-slate-500 italic">"Ghi chú: @Model.OrderNotes"</p>
                }
            </div>
        </div>

        <!-- Payment Info Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-3">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider pb-2 border-b border-slate-100">
                Thanh Toán & Cổng Giao Dịch
            </h2>
            <div class="space-y-2 text-xs text-slate-700">
                <div class="flex items-center justify-between">
                    <span class="text-slate-400">Hình thức:</span>
                    <strong class="font-bold text-slate-900">@(Model.PaymentMethod == "VietQR" ? "Chuyển khoản VietQR" : "Thanh toán COD")</strong>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-400">Trạng thái tiền:</span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold @(Model.PaymentStatus == "Paid" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                        @(Model.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                    </span>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                    <span class="text-slate-400 font-bold">Tổng thanh toán:</span>
                    <span class="text-base font-black text-blue-600">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <!-- Update Order Status Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-3">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider pb-2 border-b border-slate-100">
                Cập Nhật Trạng Thái
            </h2>
            <form method="post" action="/Admin/Order/UpdateStatus" class="space-y-3 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.OrderId" />

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Trạng thái mới</label>
                    <select name="newStatus" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-blue-600 focus:outline-none">
                        <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Chờ xử lý (Pending)</option>
                        <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Đang đóng gói (Processing)</option>
                        <option value="Shipping" selected="@(Model.OrderStatus == "Shipping")">Đang vận chuyển (Shipping)</option>
                        <option value="Delivered" selected="@(Model.OrderStatus == "Delivered")">Đã giao thành công (Delivered)</option>
                        <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Đã hủy đơn (Cancelled)</option>
                    </select>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Ghi chú cập nhật</label>
                    <input type="text" name="note" placeholder="VD: Đã chuyển giao cho bưu tá Viettel Post..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>

                <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-xs transition-colors">
                    Lưu Trạng Thái & Ghi Log
                </button>
            </form>
        </div>
    </div>

    <!-- Items List Table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden space-y-4 p-5">
        <h2 class="text-sm font-bold text-slate-900">Danh Sách Thiết Bị Đặt Mua</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-slate-700 uppercase font-semibold text-xs border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-4">Sản Phẩm</th>
                        <th class="py-3 px-4">Biến Thể / SKU</th>
                        <th class="py-3 px-4 text-right">Đơn Giá</th>
                        <th class="py-3 px-4 text-center">Số Lượng</th>
                        <th class="py-3 px-4 text-right">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    @foreach (var item in Model.OrderDetails)
                    {
                        var product = item.Variant?.Product;
                        <tr class="hover:bg-slate-50/50">
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-3">
                                    <img src="@(product?.FeaturedImage ?? "/assets/images/placeholder.png")" alt="@item.ProductName" class="w-10 h-10 object-contain rounded-lg border border-slate-200 bg-slate-50" onerror="this.src='/assets/images/placeholder.png'" />
                                    <div>
                                        <div class="font-bold text-slate-900">@item.ProductName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <span class="font-mono text-slate-500">@(item.Variant?.SKU ?? "N/A")</span>
                                <div class="text-[11px] text-slate-400">@item.VariantName</div>
                            </td>
                            <td class="py-3 px-4 text-right font-semibold text-slate-800">
                                @item.UnitPrice.ToString("N0") đ
                            </td>
                            <td class="py-3 px-4 text-center font-bold text-slate-900">
                                @item.Quantity
                            </td>
                            <td class="py-3 px-4 text-right font-bold text-blue-600">
                                @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Order Status History Audit Timeline -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xs p-5 space-y-4">
        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Lịch Sử Tiến Trình Đơn Hàng (Audit Timeline)</span>
        </h2>

        @if (histories.Any())
        {
            <div class="relative pl-6 border-l-2 border-blue-200 space-y-6 my-2">
                @foreach (var h in histories)
                {
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-blue-600 ring-4 ring-blue-100"></div>
                        <div class="space-y-1">
                            <div class="flex items-center gap-2 text-xs">
                                <span class="font-bold text-slate-900">
                                    @(string.IsNullOrEmpty(h.PreviousStatus) ? "Khởi tạo đơn" : $"{h.PreviousStatus} &rarr; {h.NewStatus}")
                                </span>
                                <span class="text-slate-400">&bull;</span>
                                <span class="text-slate-400 text-[11px]">@h.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            </div>
                            <p class="text-xs text-slate-600">@h.Note</p>
                            <div class="text-[11px] text-slate-400">
                                Thực hiện bởi: <strong class="text-slate-700 font-semibold">@(h.User?.FullName ?? "Hệ thống tự động")</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-xs text-slate-400 italic">Chưa có bản ghi lịch sử tiến trình nào cho đơn hàng này.</p>
        }
    </div>
</div>

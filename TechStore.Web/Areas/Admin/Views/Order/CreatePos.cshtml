@{
    ViewData["Title"] = "POS Bán Hàng Tại Quầy";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-4">
    <!-- Header bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-bestbuy-blue text-white flex items-center justify-center font-black">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
            </div>
            <div>
                <h1 class="text-lg font-black text-slate-900 leading-tight">Điểm Bán Hàng Tại Quầy (POS Showroom)</h1>
                <p class="text-xs text-slate-500">Tạo đơn bán lẻ trực tiếp, trừ kho tức thì và xuất phiếu giao hàng</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Ca bán hàng online: @User.Identity?.Name</span>
            </span>
            <a href="/Admin/Order" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                &larr; Quản lý đơn
            </a>
        </div>
    </div>

    <!-- POS Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Cột trái: Tìm kiếm sản phẩm & Giỏ hàng POS (7/12) -->
        <div class="lg:col-span-7 space-y-4">
            <!-- Ô tìm kiếm SKU / Tên máy -->
            <div class="relative bg-white p-3 rounded-2xl border border-slate-200 shadow-xs">
                <div class="relative">
                    <input type="text" id="posSearchInput" 
                           placeholder="🔍 Quét mã vạch, gõ SKU hoặc tên sản phẩm... (Ctrl + F)" 
                           autocomplete="off"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-10 py-3 text-xs font-semibold text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white transition" />
                    <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    <button type="button" id="posClearSearch" onclick="clearPosSearch()" class="hidden absolute right-3.5 top-3 text-slate-400 hover:text-slate-600 font-bold">&times;</button>
                </div>

                <!-- Dropdown kết quả tìm kiếm -->
                <div id="posSearchResults" class="hidden absolute inset-x-0 top-full mt-2 bg-white rounded-2xl border border-slate-200 shadow-2xl max-h-80 overflow-y-auto z-30 divide-y divide-slate-100 p-1">
                    <!-- Dynamic search items -->
                </div>
            </div>

            <!-- Bảng danh sách hàng hóa trong đơn POS -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden flex flex-col min-h-[420px]">
                <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <span class="text-xs font-black uppercase tracking-wider text-slate-600 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                        Mặt Hàng Đã Chọn (<span id="posItemCount">0</span>)
                    </span>
                    <button type="button" onclick="clearPosCart()" class="text-[11px] text-rose-600 font-bold hover:underline">
                        Xóa tất cả
                    </button>
                </div>

                <div class="flex-1 overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50/80 text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100">
                            <tr>
                                <th class="p-3">Sản phẩm</th>
                                <th class="p-3 text-right">Đơn giá</th>
                                <th class="p-3 text-center w-28">SL</th>
                                <th class="p-3 text-right">Thành tiền</th>
                                <th class="p-3 text-center w-12"></th>
                            </tr>
                        </thead>
                        <tbody id="posCartBody" class="divide-y divide-slate-100 font-medium text-slate-800">
                            <tr id="posEmptyRow">
                                <td colspan="5" class="p-12 text-center text-slate-400">
                                    <div class="w-12 h-12 rounded-2xl bg-slate-100 mx-auto mb-2 flex items-center justify-center text-slate-400">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                    </div>
                                    <p class="font-bold text-slate-600 text-xs">Chưa có sản phẩm nào trong đơn</p>
                                    <p class="text-[11px]">Sử dụng ô tìm kiếm phía trên hoặc quét mã vạch để thêm máy vào đơn</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin khách hàng & Bảng thanh toán (5/12) -->
        <div class="lg:col-span-5 space-y-4">
            <!-- Khối Khách Hàng -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <span class="text-xs font-black uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        Thông Tin Khách Mua Hàng
                    </span>
                    <button type="button" onclick="setGuestCustomer()" class="text-[11px] text-blue-600 font-bold hover:underline">
                        Khách vãng lai
                    </button>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Họ tên</label>
                        <input type="text" id="posCustomerName" value="Khách Lẻ Mua Tại Quầy" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Số điện thoại</label>
                        <input type="tel" id="posCustomerPhone" value="0900000000" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-900 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Email (Tùy chọn - Nhận hóa đơn điện tử)</label>
                    <input type="email" id="posCustomerEmail" placeholder="khachhang@gmail.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
            </div>

            <!-- Khối Thanh Toán & Tính Tiền -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4">
                <span class="text-xs font-black uppercase tracking-wider text-slate-700 flex items-center gap-1.5 pb-2 border-b border-slate-100">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    Chi Tiết Thanh Toán
                </span>

                <!-- Phương thức thanh toán -->
                <div class="grid grid-cols-3 gap-2">
                    <label class="flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 hover:border-blue-500 cursor-pointer transition text-center has-checked:border-blue-600 has-checked:bg-blue-50/60 has-checked:text-blue-700">
                        <input type="radio" name="posPaymentMethod" value="Cash" checked onchange="handlePaymentMethodChange()" class="sr-only" />
                        <span class="text-base mb-0.5">💵</span>
                        <span class="text-[11px] font-black">Tiền mặt</span>
                    </label>
                    <label class="flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 hover:border-blue-500 cursor-pointer transition text-center has-checked:border-blue-600 has-checked:bg-blue-50/60 has-checked:text-blue-700">
                        <input type="radio" name="posPaymentMethod" value="VietQR" onchange="handlePaymentMethodChange()" class="sr-only" />
                        <span class="text-base mb-0.5">📱</span>
                        <span class="text-[11px] font-black">VietQR</span>
                    </label>
                    <label class="flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 hover:border-blue-500 cursor-pointer transition text-center has-checked:border-blue-600 has-checked:bg-blue-50/60 has-checked:text-blue-700">
                        <input type="radio" name="posPaymentMethod" value="Card" onchange="handlePaymentMethodChange()" class="sr-only" />
                        <span class="text-base mb-0.5">💳</span>
                        <span class="text-[11px] font-black">Quẹt thẻ</span>
                    </label>
                </div>

                <!-- Bảng tạm tính -->
                <div class="space-y-2 text-xs text-slate-600">
                    <div class="flex justify-between items-center">
                        <span>Tổng tiền hàng:</span>
                        <strong id="posSubTotal" class="text-slate-900 font-extrabold text-sm">0 đ</strong>
                    </div>

                    <div class="flex justify-between items-center gap-2">
                        <span>Chiết khấu / Giảm giá (VNĐ):</span>
                        <input type="number" id="posDiscountInput" value="0" min="0" step="10000" oninput="calculatePosTotals()" 
                               class="w-32 text-right bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1 text-xs font-bold text-rose-600 focus:bg-white focus:ring-1 focus:ring-blue-600 focus:outline-none" />
                    </div>

                    <div class="flex justify-between items-center text-sm pt-2 border-t border-slate-100">
                        <strong class="text-slate-900 font-extrabold">KHÁCH PHẢI TRẢ:</strong>
                        <strong id="posFinalTotal" class="text-xl font-black text-blue-600">0 đ</strong>
                    </div>
                </div>

                <!-- Khối tiền khách đưa (Hiện khi chọn Tiền mặt) -->
                <div id="posCashPanel" class="space-y-2 pt-2 border-t border-slate-100">
                    <div class="flex justify-between items-center gap-2">
                        <label class="text-xs font-bold text-slate-700">Tiền khách đưa:</label>
                        <input type="number" id="posCashGivenInput" value="0" min="0" step="50000" oninput="calculateChange()" 
                               class="w-36 text-right bg-amber-50/70 border border-amber-300 rounded-xl px-3 py-1.5 text-sm font-black text-slate-900 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                    </div>

                    <!-- Gợi ý mệnh giá tiền nhanh -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <button type="button" onclick="setCashGivenExact()" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">Đủ tiền</button>
                        <button type="button" onclick="setCashGiven(500000)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">500k</button>
                        <button type="button" onclick="setCashGiven(1000000)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">1tr</button>
                        <button type="button" onclick="setCashGiven(2000000)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">2tr</button>
                        <button type="button" onclick="setCashGiven(5000000)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">5tr</button>
                        <button type="button" onclick="setCashGiven(10000000)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">10tr</button>
                        <button type="button" onclick="setCashGiven(20000000)" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-[10px] font-bold">20tr</button>
                    </div>

                    <div class="flex justify-between items-center text-xs pt-1.5">
                        <span class="font-bold text-slate-600">Tiền thừa trả khách:</span>
                        <strong id="posChangeAmount" class="text-sm font-black text-emerald-600">0 đ</strong>
                    </div>
                </div>

                <!-- Khối QR Code (Hiện khi chọn VietQR) -->
                <div id="posQrPanel" class="hidden text-center p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                    <p class="text-xs font-bold text-slate-700">Mã QR Thanh Toán Tức Thì</p>
                    <img id="posQrImg" src="" alt="VietQR" class="w-44 h-44 mx-auto rounded-xl border border-slate-300 shadow-sm object-contain" />
                    <p class="text-[11px] text-slate-500">Bảo khách mở ứng dụng Ngân hàng quét mã</p>
                </div>

                <div>
                    <input type="text" id="posOrderNotes" placeholder="Ghi chú đơn (IMEI máy, quà tặng kèm...)" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-800 focus:bg-white focus:outline-none" />
                </div>

                <!-- Nút Submit Hoàn Tất -->
                <button type="button" id="posSubmitBtn" onclick="submitPosOrder()" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm rounded-xl shadow-lg transition-all active:scale-[0.99] flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    <span>HOÀN TẤT & IN PHIẾU GIAO HÀNG</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let posCart = [];
    let searchDebounce = null;

    const searchInput = document.getElementById('posSearchInput');
    const searchResults = document.getElementById('posSearchResults');
    const clearSearchBtn = document.getElementById('posClearSearch');

    searchInput.addEventListener('input', function() {
        clearTimeout(searchDebounce);
        const term = this.value.trim();
        if (term.length > 0) {
            clearSearchBtn.classList.remove('hidden');
        } else {
            clearSearchBtn.classList.add('hidden');
            searchResults.classList.add('hidden');
            return;
        }

        searchDebounce = setTimeout(() => {
            searchPosProducts(term);
        }, 250);
    });

    async function searchPosProducts(term) {
        try {
            const res = await fetch(`/Admin/Order/SearchVariantsForPos?term=${encodeURIComponent(term)}`);
            if (!res.ok) return;
            const items = await res.json();
            if (items.length === 0) {
                searchResults.innerHTML = '<div class="p-4 text-center text-xs text-slate-400">Không tìm thấy sản phẩm nào khớp với từ khóa!</div>';
            } else {
                searchResults.innerHTML = items.map(item => `
                    <div onclick="addPosItem(${JSON.stringify(item).replace(/"/g, '&quot;')})" 
                         class="p-2.5 hover:bg-blue-50 cursor-pointer flex items-center justify-between rounded-xl transition ${item.stock <= 0 ? 'opacity-50' : ''}">
                        <div class="flex items-center gap-3">
                            <img src="${item.image}" alt="${item.productName}" class="w-10 h-10 object-contain rounded-lg border border-slate-200 bg-white" />
                            <div>
                                <div class="text-xs font-bold text-slate-900">${item.productName}</div>
                                <div class="text-[11px] text-slate-500 font-mono">SKU: <span class="text-blue-600 font-bold">${item.sku}</span> &bull; ${item.variantName}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-xs font-black text-blue-600">${item.price.toLocaleString('vi-VN')} đ</div>
                            <span class="text-[10px] font-bold ${item.stock > 0 ? 'text-emerald-600' : 'text-rose-500'}">Kho: ${item.stock}</span>
                        </div>
                    </div>
                `).join('');
            }
            searchResults.classList.remove('hidden');
        } catch(e) {
            console.error('POS Search Error:', e);
        }
    }

    function clearPosSearch() {
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        searchResults.classList.add('hidden');
        searchInput.focus();
    }

    // Close search dropdown on click outside
    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
            searchResults.classList.add('hidden');
        }
    });

    function addPosItem(item) {
        if (item.stock <= 0) {
            alert('Mặt hàng này hiện đã hết hàng trong kho!');
            return;
        }

        const existing = posCart.find(i => i.variantId === item.variantId);
        if (existing) {
            if (existing.quantity >= item.stock) {
                alert(`Kho chỉ còn ${item.stock} sản phẩm!`);
                return;
            }
            existing.quantity++;
        } else {
            posCart.push({
                variantId: item.variantId,
                productName: item.productName,
                variantName: item.variantName,
                sku: item.sku,
                price: item.price,
                stock: item.stock,
                image: item.image,
                quantity: 1
            });
        }

        clearPosSearch();
        renderPosCart();
    }

    function renderPosCart() {
        const tbody = document.getElementById('posCartBody');
        const countSpan = document.getElementById('posItemCount');

        if (posCart.length === 0) {
            tbody.innerHTML = `
                <tr id="posEmptyRow">
                    <td colspan="5" class="p-12 text-center text-slate-400">
                        <div class="w-12 h-12 rounded-2xl bg-slate-100 mx-auto mb-2 flex items-center justify-center text-slate-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                        </div>
                        <p class="font-bold text-slate-600 text-xs">Chưa có sản phẩm nào trong đơn</p>
                        <p class="text-[11px]">Sử dụng ô tìm kiếm phía trên hoặc quét mã vạch để thêm máy vào đơn</p>
                    </td>
                </tr>
            `;
            countSpan.innerText = '0';
            calculatePosTotals();
            return;
        }

        countSpan.innerText = posCart.reduce((sum, i) => sum + i.quantity, 0);

        tbody.innerHTML = posCart.map((item, idx) => `
            <tr class="hover:bg-slate-50/50 transition">
                <td class="p-3">
                    <div class="flex items-center gap-2.5">
                        <img src="${item.image}" alt="${item.productName}" class="w-9 h-9 object-contain rounded-lg border border-slate-200 bg-white" />
                        <div>
                            <div class="font-bold text-slate-900 leading-snug">${item.productName}</div>
                            <div class="text-[11px] text-slate-400 font-mono">${item.sku} &bull; ${item.variantName}</div>
                        </div>
                    </div>
                </td>
                <td class="p-3 text-right font-semibold text-slate-700">
                    ${item.price.toLocaleString('vi-VN')} đ
                </td>
                <td class="p-3">
                    <div class="flex items-center justify-center border border-slate-200 rounded-lg bg-slate-50 overflow-hidden w-24 mx-auto">
                        <button type="button" onclick="updatePosQty(${item.variantId}, -1)" class="w-7 h-7 flex items-center justify-center text-slate-600 hover:bg-slate-200 font-bold">-</button>
                        <input type="number" value="${item.quantity}" min="1" max="${item.stock}" onchange="setPosQty(${item.variantId}, this.value)" class="w-10 text-center bg-transparent border-0 text-xs font-black text-slate-900 p-0 focus:outline-none" />
                        <button type="button" onclick="updatePosQty(${item.variantId}, 1)" class="w-7 h-7 flex items-center justify-center text-slate-600 hover:bg-slate-200 font-bold">+</button>
                    </div>
                </td>
                <td class="p-3 text-right font-black text-blue-600">
                    ${(item.price * item.quantity).toLocaleString('vi-VN')} đ
                </td>
                <td class="p-3 text-center">
                    <button type="button" onclick="removePosItem(${item.variantId})" class="p-1 text-slate-400 hover:text-rose-600 rounded-lg transition" title="Xóa dòng">&times;</button>
                </td>
            </tr>
        `).join('');

        calculatePosTotals();
    }

    function updatePosQty(variantId, delta) {
        const item = posCart.find(i => i.variantId === variantId);
        if (!item) return;
        const newQty = item.quantity + delta;
        if (newQty <= 0) {
            removePosItem(variantId);
            return;
        }
        if (newQty > item.stock) {
            alert(`Kho chỉ còn ${item.stock} sản phẩm!`);
            return;
        }
        item.quantity = newQty;
        renderPosCart();
    }

    function setPosQty(variantId, val) {
        const item = posCart.find(i => i.variantId === variantId);
        if (!item) return;
        let qty = parseInt(val) || 1;
        if (qty <= 0) qty = 1;
        if (qty > item.stock) {
            alert(`Kho chỉ còn ${item.stock} sản phẩm!`);
            qty = item.stock;
        }
        item.quantity = qty;
        renderPosCart();
    }

    function removePosItem(variantId) {
        posCart = posCart.filter(i => i.variantId !== variantId);
        renderPosCart();
    }

    function clearPosCart() {
        if (posCart.length === 0) return;
        if (confirm('Bạn có chắc muốn xóa tất cả sản phẩm khỏi đơn này?')) {
            posCart = [];
            renderPosCart();
        }
    }

    function calculatePosTotals() {
        const subTotal = posCart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
        const discount = parseFloat(document.getElementById('posDiscountInput').value) || 0;
        const finalTotal = Math.max(0, subTotal - discount);

        document.getElementById('posSubTotal').innerText = subTotal.toLocaleString('vi-VN') + ' đ';
        document.getElementById('posFinalTotal').innerText = finalTotal.toLocaleString('vi-VN') + ' đ';

        calculateChange();
        updateVietQrCode(finalTotal);
    }

    function calculateChange() {
        const subTotal = posCart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
        const discount = parseFloat(document.getElementById('posDiscountInput').value) || 0;
        const finalTotal = Math.max(0, subTotal - discount);

        const cashGiven = parseFloat(document.getElementById('posCashGivenInput').value) || 0;
        const change = Math.max(0, cashGiven - finalTotal);

        document.getElementById('posChangeAmount').innerText = change.toLocaleString('vi-VN') + ' đ';
    }

    function setCashGiven(val) {
        document.getElementById('posCashGivenInput').value = val;
        calculateChange();
    }

    function setCashGivenExact() {
        const subTotal = posCart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
        const discount = parseFloat(document.getElementById('posDiscountInput').value) || 0;
        const finalTotal = Math.max(0, subTotal - discount);
        setCashGiven(finalTotal);
    }

    function handlePaymentMethodChange() {
        const method = document.querySelector('input[name="posPaymentMethod"]:checked').value;
        const cashPanel = document.getElementById('posCashPanel');
        const qrPanel = document.getElementById('posQrPanel');

        if (method === 'Cash') {
            cashPanel.classList.remove('hidden');
            qrPanel.classList.add('hidden');
        } else if (method === 'VietQR') {
            cashPanel.classList.add('hidden');
            qrPanel.classList.remove('hidden');
            const subTotal = posCart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            const discount = parseFloat(document.getElementById('posDiscountInput').value) || 0;
            updateVietQrCode(Math.max(0, subTotal - discount));
        } else {
            cashPanel.classList.add('hidden');
            qrPanel.classList.add('hidden');
        }
    }

    function updateVietQrCode(amount) {
        const qrImg = document.getElementById('posQrImg');
        if (amount > 0) {
            qrImg.src = `https://img.vietqr.io/image/970422-0869162534-compact2.png?amount=${amount}&addInfo=POS%20Showroom&accountName=CONG%20TY%20TECHSTORE`;
        }
    }

    function setGuestCustomer() {
        document.getElementById('posCustomerName').value = 'Khách Lẻ Mua Tại Quầy';
        document.getElementById('posCustomerPhone').value = '0900000000';
        document.getElementById('posCustomerEmail').value = '';
    }

    async function submitPosOrder() {
        if (posCart.length === 0) {
            alert('Vui lòng thêm ít nhất một sản phẩm vào đơn hàng!');
            return;
        }

        const btn = document.getElementById('posSubmitBtn');
        btn.disabled = true;
        btn.classList.add('opacity-50');

        const payload = {
            customerName: document.getElementById('posCustomerName').value,
            customerPhone: document.getElementById('posCustomerPhone').value,
            customerEmail: document.getElementById('posCustomerEmail').value,
            paymentMethod: document.querySelector('input[name="posPaymentMethod"]:checked').value,
            cashGiven: parseFloat(document.getElementById('posCashGivenInput').value) || 0,
            discountAmount: parseFloat(document.getElementById('posDiscountInput').value) || 0,
            notes: document.getElementById('posOrderNotes').value,
            items: posCart.map(i => ({ variantId: i.variantId, quantity: i.quantity }))
        };

        try {
            const res = await fetch('/Admin/Order/CreatePos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                // Mở cửa sổ in phiếu giao hàng
                window.open(`/Admin/Order/PrintInvoice/${data.orderId}`, '_blank');

                alert(`Đơn hàng #${data.orderCode} đã tạo thành công!\nTổng tiền: ${data.totalAmount.toLocaleString('vi-VN')} đ\nTiền thừa trả khách: ${data.changeAmount.toLocaleString('vi-VN')} đ`);

                // Reset form
                posCart = [];
                renderPosCart();
                setGuestCustomer();
                document.getElementById('posDiscountInput').value = 0;
                document.getElementById('posCashGivenInput').value = 0;
                document.getElementById('posOrderNotes').value = '';
            } else {
                alert(data.message || 'Có lỗi xảy ra khi tạo đơn hàng!');
            }
        } catch(e) {
            console.error('POS submit error:', e);
            alert('Lỗi kết nối máy chủ!');
        } finally {
            btn.disabled = false;
            btn.classList.remove('opacity-50');
        }
    }
</script>


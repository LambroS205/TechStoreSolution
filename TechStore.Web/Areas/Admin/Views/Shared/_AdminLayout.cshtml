@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@inject TechStore.Infrastructure.Data.TechStoreDbContext DbContext
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

@{
    var tokens = Xsrf.GetAndStoreTokens(Context);
    bool isSuperAdmin = User.IsInRole("SuperAdmin");

    // Đánh giá quyền hạn bất đồng bộ
    bool canDashboard = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Dashboard.View")).Succeeded;
    bool canProducts = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Products.View")).Succeeded;
    bool canCategories = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Categories.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Categories.View")).Succeeded;
    bool canBrands = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Brands.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Brands.View")).Succeeded;
    bool canSuppliers = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Suppliers.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Suppliers.View")).Succeeded;
    bool canInventory = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Inventory.View")).Succeeded;
    bool canOrders = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Orders.View")).Succeeded;
    bool canAnalytics = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Analytics.View")).Succeeded;
    bool canCoupons = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Coupons.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Coupons.View")).Succeeded;
    bool canReviews = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Reviews.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Reviews.View")).Succeeded;
    bool canBlogs = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Blogs.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Blogs.View")).Succeeded;
    bool canBanners = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Banners.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Banners.View")).Succeeded;
    bool canUsers = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Users.View")).Succeeded;
    bool canPermissions = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Permissions.Manage")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:Permissions.View")).Succeeded;
    bool canAuditLog = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:AuditLogs.View")).Succeeded || (await Auth.AuthorizeAsync(User, null, "Permission:AuditLog.View")).Succeeded;
    bool canSettings = isSuperAdmin || (await Auth.AuthorizeAsync(User, null, "Permission:Settings.Manage")).Succeeded;

    bool hasStoreSection = canProducts || canCategories || canBrands || canSuppliers || canInventory;
    bool hasSalesSection = canOrders || canAnalytics || canCoupons || canReviews || canBlogs || canBanners;
    bool hasSystemSection = canUsers || canPermissions || canAuditLog || canSettings;

    // Đếm chỉ số cảnh báo vận hành
    int pendingOrders = canOrders ? DbContext.Orders.Count(o => o.OrderStatus == "Pending") : 0;
    int pendingVietQr = canOrders ? DbContext.Orders.Count(o => o.PaymentMethod == "VietQR" && o.PaymentStatus == "Pending") : 0;
    int lowStockCount = canInventory ? DbContext.ProductVariants.Count(v => v.IsActive && v.StockQuantity <= 10) : 0;
    int totalAlerts = pendingOrders + pendingVietQr + lowStockCount;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string ctrl, string act = "") {
        bool isActive = string.IsNullOrEmpty(act) 
            ? currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
            : currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase) && currentAction.Equals(act, StringComparison.OrdinalIgnoreCase);
        return isActive 
            ? "flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold text-blue-600 bg-blue-50/90 shadow-sm transition-colors"
            : "flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors";
    }

    string IconColor(string ctrl, string act = "") {
        bool isActive = string.IsNullOrEmpty(act) 
            ? currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
            : currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase) && currentAction.Equals(act, StringComparison.OrdinalIgnoreCase);
        return isActive ? "text-blue-600" : "text-slate-400";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@tokens.RequestToken" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống TechStore</title>
    <!-- Tailwind CSS CDN & Google Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&subset=vietnamese,latin,latin-ext&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex">

    <!-- Mobile Drawer Overlay -->
    <div id="mobileSidebarBackdrop" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden transition-opacity" onclick="toggleMobileSidebar()"></div>

    <!-- Sidebar Navigation -->
    <aside id="adminSidebar" class="w-64 bg-white border-r border-slate-200 flex flex-col justify-between shrink-0 fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 md:sticky md:top-0 h-screen transition-transform duration-200 ease-in-out shadow-sm">
        <div class="flex flex-col min-h-0 flex-1">
            <!-- Brand Logo -->
            <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100 shrink-0">
                <a href="/Admin" class="flex items-center gap-3">
                    <span class="p-2 bg-blue-600 text-white rounded-xl shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </span>
                    <div>
                        <span class="font-extrabold text-slate-900 text-lg tracking-tight">TechStore</span>
                        <span class="block text-[10px] uppercase font-bold text-blue-600 tracking-wider">ERP & Admin</span>
                    </div>
                </a>
                <button type="button" class="md:hidden text-slate-400 hover:text-slate-600" onclick="toggleMobileSidebar()">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-4 overflow-y-auto flex-1">
                @if (canDashboard)
                {
                    <div class="space-y-1">
                        <a href="/Admin/Dashboard" class="@NavClass("Dashboard")">
                            <svg class="w-5 h-5 @IconColor("Dashboard")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            <span>Tổng Quan</span>
                        </a>
                    </div>
                }

                @if (hasStoreSection)
                {
                    <div class="space-y-1">
                        <p class="px-3 text-[11px] font-bold tracking-wider text-slate-400 uppercase">Sản Phẩm & Kho</p>
                        @if (canProducts)
                        {
                            <a href="/Admin/Product" class="@NavClass("Product")">
                                <svg class="w-5 h-5 @IconColor("Product")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                                <span>Sản Phẩm</span>
                            </a>
                        }
                        @if (canCategories)
                        {
                            <a href="/Admin/Category" class="@NavClass("Category")">
                                <svg class="w-5 h-5 @IconColor("Category")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                                </svg>
                                <span>Danh Mục</span>
                            </a>
                        }
                        @if (canBrands)
                        {
                            <a href="/Admin/Brand" class="@NavClass("Brand")">
                                <svg class="w-5 h-5 @IconColor("Brand")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                                <span>Thương Hiệu</span>
                            </a>
                        }
                        @if (canSuppliers)
                        {
                            <a href="/Admin/Supplier" class="@NavClass("Supplier")">
                                <svg class="w-5 h-5 @IconColor("Supplier")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                                <span>Nhà Cung Cấp</span>
                            </a>
                        }
                        @if (canInventory)
                        {
                            <a href="/Admin/Inventory" class="@NavClass("Inventory") flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 @IconColor("Inventory")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                    </svg>
                                    <span>Kho & Tồn Kho</span>
                                </div>
                                @if (lowStockCount > 0)
                                {
                                    <span class="px-2 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-700 rounded-full">@lowStockCount</span>
                                }
                            </a>
                        }
                    </div>
                }

                @if (hasSalesSection)
                {
                    <div class="space-y-1">
                        <p class="px-3 text-[11px] font-bold tracking-wider text-slate-400 uppercase">Bán Hàng & Marketing</p>
                        @if (canOrders)
                        {
                            <a href="/Admin/Order" class="@NavClass("Order") flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 @IconColor("Order")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                    </svg>
                                    <span>Quản Lý Đơn Hàng</span>
                                </div>
                                @if (pendingOrders > 0)
                                {
                                    <span class="px-2 py-0.5 text-[10px] font-bold bg-rose-100 text-rose-700 rounded-full">@pendingOrders</span>
                                }
                            </a>
                            <a href="/Admin/Order/CreatePos" class="@NavClass("Order", "CreatePos") text-emerald-700 hover:text-emerald-800">
                                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                                <span class="font-bold text-emerald-700">⚡ POS Bán Tại Quầy</span>
                            </a>
                        }
                        @if (canAnalytics)
                        {
                            <a href="/Admin/Analytics" class="@NavClass("Analytics")">
                                <svg class="w-5 h-5 @IconColor("Analytics")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <span>Báo Cáo Doanh Thu</span>
                            </a>
                        }
                        @if (canCoupons)
                        {
                            <a href="/Admin/Coupon" class="@NavClass("Coupon")">
                                <svg class="w-5 h-5 @IconColor("Coupon")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                                </svg>
                                <span>Mã Khuyến Mãi</span>
                            </a>
                        }
                        @if (canReviews)
                        {
                            <a href="/Admin/Review" class="@NavClass("Review")">
                                <svg class="w-5 h-5 @IconColor("Review")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                                </svg>
                                <span>Đánh Giá SP</span>
                            </a>
                        }
                        @if (canBlogs)
                        {
                            <a href="/Admin/Blog" class="@NavClass("Blog")">
                                <svg class="w-5 h-5 @IconColor("Blog")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                </svg>
                                <span>Bài Viết & Blog</span>
                            </a>
                        }
                        @if (canBanners)
                        {
                            <a href="/Admin/Banner" class="@NavClass("Banner")">
                                <svg class="w-5 h-5 @IconColor("Banner")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span>CMS Banner</span>
                            </a>
                        }
                    </div>
                }

                @if (hasSystemSection)
                {
                    <div class="space-y-1">
                        <p class="px-3 text-[11px] font-bold tracking-wider text-slate-400 uppercase">Hệ Thống</p>
                        @if (canUsers)
                        {
                            <a href="/Admin/User" class="@NavClass("User")">
                                <svg class="w-5 h-5 @IconColor("User")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <span>Người Dùng & KH</span>
                            </a>
                        }
                        @if (canPermissions)
                        {
                            <a href="/Admin/Permission/Matrix" class="@NavClass("Permission", "Matrix")">
                                <svg class="w-5 h-5 @IconColor("Permission", "Matrix")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                <span>Phân Quyền Ma Trận</span>
                            </a>
                        }
                        @if (canAuditLog)
                        {
                            <a href="/Admin/AuditLog" class="@NavClass("AuditLog")">
                                <svg class="w-5 h-5 @IconColor("AuditLog")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <span>Nhật Ký Kiểm Toán</span>
                            </a>
                        }
                        @if (canSettings)
                        {
                            <a href="/Admin/SiteSettings" class="@NavClass("SiteSettings")">
                                <svg class="w-5 h-5 @IconColor("SiteSettings")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                                </svg>
                                <span>Cài Đặt Giao Diện</span>
                            </a>
                        }
                    </div>
                }
            </nav>
        </div>

        <!-- Admin Profile Bottom Card & Safe Logout -->
        <div class="p-3 border-t border-slate-100 shrink-0 bg-white">
            <a href="/Admin/Profile" class="flex items-center gap-3 p-2 rounded-xl mb-2 transition group @(currentController.Equals("Profile", StringComparison.OrdinalIgnoreCase) ? "bg-blue-50 border border-blue-200" : "bg-slate-50 hover:bg-slate-100")" title="Xem & Chỉnh sửa hồ sơ cá nhân">
                <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm shrink-0 overflow-hidden shadow-2xs">
                    @if (!string.IsNullOrEmpty(User.FindFirst("AvatarUrl")?.Value))
                    {
                        <img src="@User.FindFirst("AvatarUrl")?.Value" alt="@User.Identity?.Name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span>@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")</span>
                    }
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-slate-800 truncate group-hover:text-blue-600 transition">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</p>
                    <span class="inline-block px-1.5 py-0.5 text-[10px] font-semibold bg-blue-100 text-blue-700 rounded truncate">
                        @(isSuperAdmin ? "Super Admin" : (User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff"))
                    </span>
                </div>
                <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            
            <form method="post" action="/auth/logout" class="block w-full">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-1.5 text-xs font-bold text-rose-600 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors border border-transparent hover:border-rose-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                    <span>Đăng xuất an toàn</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Top Navigation Bar -->
        <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-6 sticky top-0 z-30 shadow-sm gap-4">
            <div class="flex items-center gap-3">
                <button type="button" class="md:hidden p-2 text-slate-600 hover:text-blue-600 hover:bg-slate-100 rounded-lg" onclick="toggleMobileSidebar()">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <h2 class="text-base font-bold text-slate-800 truncate">@ViewData["Title"]</h2>
            </div>

            <!-- Topbar Global Search & Notifications -->
            <div class="flex items-center gap-3">
                @if (canOrders)
                {
                    <!-- Search bar -->
                    <div class="relative hidden sm:block w-64 lg:w-80">
                        <input type="text" id="adminQuickSearchInput" 
                               placeholder="Tìm nhanh SKU, mã đơn (Ctrl+K)..." 
                               class="w-full pl-9 pr-4 py-1.5 text-xs bg-slate-100 focus:bg-white border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 transition" />
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <div id="adminQuickSearchResults" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg z-50 hidden max-h-72 overflow-y-auto"></div>
                    </div>
                }

                @if (canOrders || canInventory)
                {
                    <!-- Live Notification Bell -->
                    <div class="relative">
                        <button type="button" id="notifDropdownBtn" onclick="toggleNotifDropdown()" class="p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-100 rounded-xl transition relative">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            @if (totalAlerts > 0)
                            {
                                <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-rose-500 rounded-full animate-ping"></span>
                                <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-rose-500 rounded-full"></span>
                            }
                        </button>

                        <!-- Dropdown Content -->
                        <div id="notifDropdown" class="absolute right-0 top-full mt-2 w-80 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 hidden p-3 space-y-2">
                            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                                <span class="text-xs font-bold text-slate-800">Cảnh Báo Vận Hành Live</span>
                                <span class="text-[10px] px-2 py-0.5 bg-blue-50 text-blue-600 font-bold rounded-full">@totalAlerts việc</span>
                            </div>
                            <div class="space-y-1.5 text-xs">
                                @if (canOrders)
                                {
                                    <a href="/Admin/Order?status=Pending" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full @(pendingOrders > 0 ? "bg-rose-500" : "bg-emerald-500")"></span>
                                            <span class="font-medium text-slate-700">Đơn hàng mới chờ duyệt</span>
                                        </div>
                                        <span class="font-bold text-slate-900">@pendingOrders</span>
                                    </a>
                                    <a href="/Admin/Order?paymentStatus=Pending" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full @(pendingVietQr > 0 ? "bg-amber-500" : "bg-emerald-500")"></span>
                                            <span class="font-medium text-slate-700">Đơn VietQR chờ kiểm tra</span>
                                        </div>
                                        <span class="font-bold text-slate-900">@pendingVietQr</span>
                                    </a>
                                }
                                @if (canInventory)
                                {
                                    <a href="/Admin/Inventory" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full @(lowStockCount > 0 ? "bg-rose-500" : "bg-emerald-500")"></span>
                                            <span class="font-medium text-slate-700">Biến thể sắp hết hàng (&le;10)</span>
                                        </div>
                                        <span class="font-bold text-slate-900">@lowStockCount</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Admin Profile Shortcut -->
                <a href="/Admin/Profile" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition" title="Hồ sơ nhân sự cá nhân">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <span class="hidden sm:inline">Hồ Sơ Nhân Viên</span>
                </a>

                <!-- Storefront link -->
                <a href="/" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span class="hidden sm:inline">Xem Cửa Hàng</span>
                </a>
            </div>
        </header>

        <!-- Dynamic Body Page Content -->
        <main class="flex-1">
            @RenderBody()
        </main>
    </div>

    <!-- CSRF Helper & Global Scripts -->
    <script>
        // Global Fetch Wrapper đính kèm Token CSRF chống lỗi HTTP 400 Bad Request
        window.adminFetch = function(url, options = {}) {
            options.headers = options.headers || {};
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
            if (token) {
                options.headers['RequestVerificationToken'] = token;
            }
            return fetch(url, options);
        };

        function toggleMobileSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const backdrop = document.getElementById('mobileSidebarBackdrop');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
            }
        }

        function toggleNotifDropdown() {
            const d = document.getElementById('notifDropdown');
            d.classList.toggle('hidden');
        }

        document.addEventListener('click', function(e) {
            const notifBtn = document.getElementById('notifDropdownBtn');
            const notifDropdown = document.getElementById('notifDropdown');
            if (notifBtn && notifDropdown && !notifBtn.contains(e.target) && !notifDropdown.contains(e.target)) {
                notifDropdown.classList.add('hidden');
            }
            const searchInput = document.getElementById('adminQuickSearchInput');
            const searchResults = document.getElementById('adminQuickSearchResults');
            if (searchInput && searchResults && !searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                searchResults.classList.add('hidden');
            }
        });

        @if (canOrders)
        {
            <text>
            // Phím tắt Ctrl+K mở nhanh ô tìm kiếm
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    const input = document.getElementById('adminQuickSearchInput');
                    if (input) input.focus();
                }
            });

            // Tìm kiếm tức thì khi gõ
            const searchInput = document.getElementById('adminQuickSearchInput');
            let searchTimer = null;
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimer);
                    const q = this.value.trim();
                    const resultsBox = document.getElementById('adminQuickSearchResults');
                    if (q.length < 2) {
                        resultsBox.classList.add('hidden');
                        return;
                    }
                    searchTimer = setTimeout(async () => {
                        try {
                            const res = await fetch(`/Admin/Order/QuickSearch?q=${encodeURIComponent(q)}`);
                            if (res.ok) {
                                const data = await res.json();
                                if (data && data.length > 0) {
                                    resultsBox.innerHTML = data.map(item => `
                                        <a href="${item.url}" class="block p-2.5 hover:bg-slate-50 border-b border-slate-100 last:border-b-0 text-xs">
                                            <div class="font-bold text-slate-800">${item.title}</div>
                                            <div class="text-[11px] text-slate-500">${item.subtitle}</div>
                                        </a>
                                    `).join('');
                                    resultsBox.classList.remove('hidden');
                                } else {
                                    resultsBox.innerHTML = '<div class="p-3 text-xs text-slate-500 text-center">Không tìm thấy kết quả phù hợp</div>';
                                    resultsBox.classList.remove('hidden');
                                }
                            }
                        } catch(e) {}
                    }, 300);
                });
            }
            </text>
        }
    </script>
    <script src="~/js/toast.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
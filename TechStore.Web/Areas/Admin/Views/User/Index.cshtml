@model TechStore.Web.Areas.Admin.Models.UserListViewModel
@{
    ViewData["Title"] = "Quản Lý Người Dùng & Khách Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <svg class="w-7 h-7 text-[#0046be]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                Quản Lý Người Dùng & Khách Hàng
            </h1>
            <p class="text-sm text-slate-500 mt-1">Danh sách tài khoản khách hàng, nhân viên, lịch sử mua hàng và phân quyền hệ thống</p>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 rounded-r-lg flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">✕</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border-l-4 border-rose-500 text-rose-800 rounded-r-lg flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">✕</button>
        </div>
    }

    <!-- Statistics Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng Tài Khoản</p>
                <h3 class="text-2xl font-bold text-slate-900 mt-1">@Model.TotalUsers</h3>
            </div>
            <span class="p-3 bg-blue-50 text-[#0046be] rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            </span>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Khách Hàng</p>
                <h3 class="text-2xl font-bold text-emerald-600 mt-1">@Model.CustomerCount</h3>
            </div>
            <span class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </span>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ban Quản Trị / NV</p>
                <h3 class="text-2xl font-bold text-indigo-600 mt-1">@Model.StaffCount</h3>
            </div>
            <span class="p-3 bg-indigo-50 text-indigo-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </span>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Đang Khóa</p>
                <h3 class="text-2xl font-bold text-rose-600 mt-1">@Model.LockedCount</h3>
            </div>
            <span class="p-3 bg-rose-50 text-rose-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </span>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <form method="get" class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </span>
                <input type="text" name="search" value="@Model.CurrentSearch" placeholder="Tìm kiếm theo Tên, Username, Email hoặc Số điện thoại..." 
                       class="w-full pl-10 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0046be] focus:border-transparent outline-none transition" />
            </div>

            <div class="w-full md:w-56">
                <select name="role" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-[#0046be] focus:border-transparent outline-none bg-white transition">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var r in Model.AvailableRoles)
                    {
                        if (Model.CurrentRole == r.NormalizedName || Model.CurrentRole == r.RoleName)
                        {
                            <option value="@r.NormalizedName" selected>@r.RoleName</option>
                        }
                        else
                        {
                            <option value="@r.NormalizedName">@r.RoleName</option>
                        }
                    }
                </select>
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" class="px-5 py-2 bg-[#0046be] hover:bg-[#002e7a] text-white text-sm font-semibold rounded-lg shadow-sm transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
                    Lọc dữ liệu
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentSearch) || !string.IsNullOrWhiteSpace(Model.CurrentRole))
                {
                    <a asp-action="Index" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-sm font-medium rounded-lg transition">
                        Đặt lại
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-slate-700 uppercase font-semibold text-xs border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-4">Người Dùng</th>
                        <th class="py-3.5 px-4">Email / SĐT</th>
                        <th class="py-3.5 px-4">Vai Trò</th>
                        <th class="py-3.5 px-4">Ngày Đăng Ký</th>
                        <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                        <th class="py-3.5 px-4 text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center space-y-2">
                                    <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
                                    <p class="text-sm font-medium">Không tìm thấy tài khoản người dùng nào khớp với bộ lọc.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        var isLocked = !user.IsActive || (user.LockoutEnd != null && user.LockoutEnd > DateTime.UtcNow);
                        <tr class="hover:bg-slate-50/75 transition">
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-slate-600 text-sm shrink-0 overflow-hidden">
                                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt="@user.FullName" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <span>@(string.IsNullOrEmpty(user.FullName) ? user.Username.Substring(0, 1).ToUpper() : user.FullName.Substring(0, 1).ToUpper())</span>
                                        }
                                    </div>
                                    <div>
                                        <a asp-action="Detail" asp-route-id="@user.UserId" class="font-semibold text-slate-900 hover:text-[#0046be] transition">
                                            @(string.IsNullOrEmpty(user.FullName) ? user.Username : user.FullName)
                                        </a>
                                        <p class="text-xs text-slate-400">@@@user.Username (ID: #@user.UserId)</p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="space-y-0.5">
                                    <div class="text-xs text-slate-800 font-medium flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                        @user.Email
                                    </div>
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        <div class="text-xs text-slate-500 flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                            @user.PhoneNumber
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-wrap gap-1">
                                    @if (!user.UserRoles.Any())
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600">Khách Hàng</span>
                                    }
                                    @foreach (var ur in user.UserRoles)
                                    {
                                        if (ur.Role.NormalizedName == "SUPERADMIN")
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200">Quản Trị Viên</span>
                                        }
                                        else if (ur.Role.NormalizedName == "CUSTOMER")
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-[#0046be]">Khách Hàng</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">@ur.Role.RoleName</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="py-3.5 px-4 text-xs text-slate-500 whitespace-nowrap">
                                @user.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                @if (isLocked)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Đã Khóa
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Hoạt Động
                                    </span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                <a asp-action="Detail" asp-route-id="@user.UserId" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[#0046be] bg-blue-50 hover:bg-blue-100 rounded-lg transition">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    Chi Tiết 360°
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between sm:px-6">
                <div class="text-xs text-slate-500">
                    Trang <span class="font-semibold text-slate-700">@Model.PageNumber</span> / <span class="font-semibold text-slate-700">@Model.TotalPages</span>
                </div>
                <div class="flex items-center gap-1">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.CurrentSearch" asp-route-role="@Model.CurrentRole" 
                           class="px-3 py-1.5 border border-slate-300 rounded text-xs text-slate-600 hover:bg-white transition">
                            Trước
                        </a>
                    }
                    @for (int p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
                    {
                        if (p == Model.PageNumber)
                        {
                            <span class="px-3 py-1.5 bg-[#0046be] text-white rounded text-xs font-semibold">@p</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.CurrentSearch" asp-route-role="@Model.CurrentRole" 
                               class="px-3 py-1.5 border border-slate-300 rounded text-xs text-slate-600 hover:bg-white transition">@p</a>
                        }
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.CurrentSearch" asp-route-role="@Model.CurrentRole" 
                           class="px-3 py-1.5 border border-slate-300 rounded text-xs text-slate-600 hover:bg-white transition">
                            Sau
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@model List<TechStore.Core.Entities.Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var parentCategories = ViewBag.ParentCategories as List<TechStore.Core.Entities.Category> ?? new();
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">&times;</button>
        </div>
    }

    <!-- Header Actions -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-lg font-bold text-slate-900">Danh Mục Sản Phẩm</h1>
            <p class="text-xs text-slate-400 mt-0.5">Quản lý cấu trúc phân cấp, menu điều hướng và phân loại thiết bị</p>
        </div>
        <button type="button" onclick="openAddCategoryModal()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl shadow-xs transition-colors shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>Thêm Danh Mục Mới</span>
        </button>
    </div>

    <!-- Category Table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-slate-700 uppercase font-semibold text-xs border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-4">Tên Danh Mục</th>
                        <th class="py-3.5 px-4">Đường Dẫn Slug</th>
                        <th class="py-3.5 px-4">Danh Mục Cha</th>
                        <th class="py-3.5 px-4 text-center">Sản Phẩm</th>
                        <th class="py-3.5 px-4 text-center">Thứ Tự</th>
                        <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                        <th class="py-3.5 px-4 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-400 text-xs">
                                Chưa có danh mục nào. Hãy bấm "Thêm Danh Mục Mới" để tạo danh mục đầu tiên!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model)
                        {
                            bool isSub = cat.ParentId != null;
                            <tr class="hover:bg-slate-50/70 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2 @(isSub ? "pl-6" : "")">
                                        @if (isSub)
                                        {
                                            <span class="text-slate-300">&boxur;</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(cat.ImageUrl))
                                        {
                                            <img src="@cat.ImageUrl" class="w-7 h-7 object-contain rounded-md border border-slate-100 p-0.5 bg-slate-50" onerror="this.src='/assets/images/placeholder.png'" />
                                        }
                                        else
                                        {
                                            <span class="w-7 h-7 rounded-md bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xs">
                                                @(cat.Name.Substring(0, 1).ToUpper())
                                            </span>
                                        }
                                        <span class="font-bold text-slate-900 text-xs">@cat.Name</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-mono text-xs text-slate-500">
                                    /@cat.Slug
                                </td>
                                <td class="py-3.5 px-4 text-xs">
                                    @if (cat.ParentCategory != null)
                                    {
                                        <span class="inline-block px-2 py-0.5 font-medium bg-slate-100 text-slate-700 rounded-md">
                                            @cat.ParentCategory.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic text-[11px]">(Danh mục gốc)</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <a href="/Admin/Product?categoryId=@cat.CategoryId" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors" title="Xem danh sách sản phẩm">
                                        @cat.Products.Count SP
                                    </a>
                                </td>
                                <td class="py-3.5 px-4 text-center font-bold text-xs text-slate-700">
                                    @cat.DisplayOrder
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <button type="button" onclick="toggleCategoryActive(@cat.CategoryId, this)" class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none @(cat.IsActive ? "bg-blue-600" : "bg-slate-200")" role="switch">
                                        <span class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out @(cat.IsActive ? "translate-x-4" : "translate-x-0")"></span>
                                    </button>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <button type="button" onclick="openEditCategoryModal(@cat.CategoryId, '@Html.Raw(cat.Name.Replace("'", "\\'"))', '@cat.Slug', @(cat.ParentId ?? 0), @cat.DisplayOrder, '@cat.Icon', '@cat.ImageUrl', @(cat.IsActive ? "true" : "false"))" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Chỉnh sửa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                        </button>
                                        <a href="/category/@cat.Slug" target="_blank" class="p-1.5 text-slate-500 hover:bg-slate-100 rounded-lg transition-colors" title="Xem trên cửa hàng">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                        </a>
                                        <form method="post" action="/Admin/Category/Delete" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục \'@cat.Name\'?');" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.CategoryId" />
                                            <button type="submit" class="p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Xóa">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm / Sửa Danh Mục -->
<div id="categoryModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 id="categoryModalTitle" class="text-base font-bold text-slate-900">Thêm Danh Mục Mới</h3>
            <button type="button" onclick="closeCategoryModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
        </div>

        <form method="post" action="/Admin/Category/Save" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalCategoryId" name="CategoryId" value="0" />

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tên Danh Mục <span class="text-rose-500">*</span></label>
                <input type="text" id="modalCategoryName" name="Name" required class="w-full text-xs border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="VD: Laptop & Máy tính" oninput="autoGenCategorySlug(this.value)" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Đường Dẫn Slug (Tự động)</label>
                <div class="flex items-center">
                    <span class="px-2.5 py-2 bg-slate-100 border border-r-0 border-slate-300 rounded-l-xl text-xs text-slate-500">/category/</span>
                    <input type="text" id="modalCategorySlug" name="Slug" class="flex-1 text-xs font-mono border border-slate-300 rounded-r-xl p-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="laptop-may-tinh" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Danh Mục Cha</label>
                    <select id="modalParentId" name="ParentId" class="w-full text-xs border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="">(Không - Danh mục gốc)</option>
                        @foreach (var p in parentCategories)
                        {
                            <option value="@p.CategoryId">@p.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Thứ Tự Hiển Thị</label>
                    <input type="number" id="modalDisplayOrder" name="DisplayOrder" value="0" min="0" class="w-full text-xs border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Hình Ảnh / Biểu Tượng Danh Mục</label>
                <input type="file" name="imageFile" accept="image/*" class="w-full text-xs file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 cursor-pointer" />
                <input type="text" id="modalImageUrl" name="ImageUrl" class="w-full text-xs border border-slate-300 rounded-xl p-2 focus:ring-2 focus:ring-blue-500 outline-none mt-1.5" placeholder="Hoặc đường dẫn ảnh..." />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Mã Icon SVG (Tùy chọn)</label>
                <input type="text" id="modalIcon" name="Icon" class="w-full text-xs font-mono border border-slate-300 rounded-xl p-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="VD: laptop, phone, headphone..." />
            </div>

            <label class="flex items-center gap-2 cursor-pointer pt-1">
                <input type="checkbox" id="modalIsActive" name="IsActive" value="true" checked class="w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
                <span class="text-xs font-bold text-slate-800">Kích Hoạt Hiển Thị Trên Website</span>
            </label>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeCategoryModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                    Hủy
                </button>
                <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors shadow-xs">
                    Lưu Danh Mục
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function autoGenCategorySlug(name) {
        if (!name) return;
        const slug = name.toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/[đĐ]/g, 'd')
            .replace(/[^a-z0-9\s-]/g, '')
            .trim()
            .replace(/[\s-]+/g, '-');
        document.getElementById('modalCategorySlug').value = slug;
    }

    function openAddCategoryModal() {
        document.getElementById('categoryModalTitle').innerText = 'Thêm Danh Mục Mới';
        document.getElementById('modalCategoryId').value = 0;
        document.getElementById('modalCategoryName').value = '';
        document.getElementById('modalCategorySlug').value = '';
        document.getElementById('modalParentId').value = '';
        document.getElementById('modalDisplayOrder').value = 0;
        document.getElementById('modalImageUrl').value = '';
        document.getElementById('modalIcon').value = '';
        document.getElementById('modalIsActive').checked = true;
        document.getElementById('categoryModal').classList.remove('hidden');
    }

    function openEditCategoryModal(id, name, slug, parentId, displayOrder, icon, imgUrl, isActive) {
        document.getElementById('categoryModalTitle').innerText = 'Chỉnh Sửa Danh Mục: ' + name;
        document.getElementById('modalCategoryId').value = id;
        document.getElementById('modalCategoryName').value = name;
        document.getElementById('modalCategorySlug').value = slug;
        document.getElementById('modalParentId').value = parentId > 0 ? parentId : '';
        document.getElementById('modalDisplayOrder').value = displayOrder;
        document.getElementById('modalImageUrl').value = imgUrl || '';
        document.getElementById('modalIcon').value = icon || '';
        document.getElementById('modalIsActive').checked = isActive;
        document.getElementById('categoryModal').classList.remove('hidden');
    }

    function closeCategoryModal() {
        document.getElementById('categoryModal').classList.add('hidden');
    }

    async function toggleCategoryActive(id, btn) {
        try {
            const res = await fetch(`/Admin/Category/ToggleStatus/${id}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();
            if (data.success) {
                const circle = btn.querySelector('span');
                if (data.isActive) {
                    btn.classList.remove('bg-slate-200');
                    btn.classList.add('bg-blue-600');
                    circle.classList.remove('translate-x-0');
                    circle.classList.add('translate-x-4');
                } else {
                    btn.classList.remove('bg-blue-600');
                    btn.classList.add('bg-slate-200');
                    circle.classList.remove('translate-x-4');
                    circle.classList.add('translate-x-0');
                }
            }
        } catch (e) {
            console.error(e);
        }
    }
</script>

@model TechStore.Web.Areas.Admin.Controllers.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Tổng Quan Hệ Thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var monthLabels = JsonSerializer.Serialize(Model.MonthlyRevenues.Select(m => m.MonthLabel));
    var monthData = JsonSerializer.Serialize(Model.MonthlyRevenues.Select(m => m.Revenue));
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Top Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Doanh thu -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tổng Doanh Thu</span>
                    <h3 class="text-2xl font-black text-slate-900 mt-1">@Model.TotalRevenue.ToString("N0") <span class="text-sm font-normal text-slate-500">đ</span></h3>
                    <p class="text-xs text-emerald-600 font-medium mt-1 flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                        <span>Đơn hoàn tất & thanh toán</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
        </div>

        <!-- Tổng Đơn Hàng -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tổng Đơn Hàng</span>
                    <h3 class="text-2xl font-black text-slate-900 mt-1">@Model.TotalOrders</h3>
                    <p class="text-xs text-slate-500 font-medium mt-1">
                        Đang giao / xử lý: <strong class="text-indigo-600">@(Model.ProcessingOrders + Model.ShippingOrders)</strong>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                </div>
            </div>
        </div>

        <!-- Chờ duyệt VietQR -->
        <a href="/Admin/Order" class="bg-white p-5 rounded-2xl border border-amber-200/90 shadow-xs hover:shadow-md transition-all block group @(Model.PendingVietQrCount > 0 ? "bg-amber-50/20" : "")">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">Chờ Duyệt VietQR</span>
                    <h3 class="text-2xl font-black text-amber-600 mt-1">@Model.PendingVietQrCount</h3>
                    <p class="text-xs text-slate-500 font-medium mt-1 group-hover:text-amber-700 flex items-center gap-1">
                        <span>Nhấp xem danh sách</span>
                        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
        </a>

        <!-- Sản Phẩm & Tồn kho -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Sản Phẩm Đang Bán</span>
                    <h3 class="text-2xl font-black text-slate-900 mt-1">@Model.TotalProducts</h3>
                    <p class="text-xs text-slate-500 font-medium mt-1">
                        Cảnh báo tồn kho: <strong class="@(Model.LowStockVariants.Count > 0 ? "text-rose-600 font-bold" : "text-slate-700")">@Model.LowStockVariants.Count mẫu</strong>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Revenue Bar/Line Chart -->
        <div class="lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Biểu Đồ Doanh Thu (6 Tháng Gần Nhất)</h3>
                    <p class="text-xs text-slate-400">Doanh thu ghi nhận từ đơn hàng thành công</p>
                </div>
                <span class="px-2.5 py-1 text-xs font-semibold bg-blue-50 text-blue-700 rounded-lg">VNĐ</span>
            </div>
            <div class="h-64 w-full">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Order Status Doughnut -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col justify-between">
            <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">Cơ Cấu Đơn Hàng</h3>
                <p class="text-xs text-slate-400 mb-4">Tỷ lệ theo các trạng thái xử lý</p>
                <div class="h-44 flex items-center justify-center">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-4 border-t border-slate-100 text-xs text-slate-600">
                <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Chờ xác nhận: <strong>@Model.PendingOrders</strong></div>
                <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Đóng gói: <strong>@Model.ProcessingOrders</strong></div>
                <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> Đang giao: <strong>@Model.ShippingOrders</strong></div>
                <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Hoàn tất: <strong>@Model.DeliveredOrders</strong></div>
            </div>
        </div>
    </div>

    <!-- Bottom Tables Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Low Stock Alerts -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                    <h3 class="text-sm font-bold text-slate-900">Cảnh Báo Tồn Kho Thấp (<= 20)</h3>
                </div>
                <a href="/Admin/Product" class="text-xs text-blue-600 font-semibold hover:underline">Quản lý kho &rarr;</a>
            </div>
            <div class="divide-y divide-slate-100">
                @if (Model.LowStockVariants.Count == 0)
                {
                    <div class="p-6 text-center text-xs text-slate-400">Tất cả sản phẩm đều có mức tồn kho dồi dào!</div>
                }
                else
                {
                    @foreach (var item in Model.LowStockVariants)
                    {
                        <div class="p-3.5 hover:bg-slate-50 flex items-center justify-between gap-3 transition-colors">
                            <div class="flex items-center gap-3 min-w-0">
                                <img src="@item.ThumbnailImage" class="w-10 h-10 object-contain rounded-lg border border-slate-100 bg-slate-50 shrink-0" onerror="this.src='/assets/images/placeholder.png'" />
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold text-slate-800 truncate">@item.ProductName</p>
                                    <p class="text-[11px] text-slate-400 truncate">@item.VariantName | SKU: <span class="font-mono font-medium text-slate-600">@item.SKU</span></p>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold @(item.StockQuantity <= 10 ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700")">
                                    Còn @item.StockQuantity
                                </span>
                                <a href="/Admin/Product/Edit/@item.ProductId" class="block text-[11px] text-blue-600 hover:underline mt-0.5">Cập nhật</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-900">Đơn Hàng Gần Nhất</h3>
                <a href="/Admin/Order" class="text-xs text-blue-600 font-semibold hover:underline">Xem tất cả &rarr;</a>
            </div>
            <div class="divide-y divide-slate-100">
                @if (Model.RecentOrders.Count == 0)
                {
                    <div class="p-6 text-center text-xs text-slate-400">Chưa có đơn hàng nào được ghi nhận.</div>
                }
                else
                {
                    @foreach (var o in Model.RecentOrders)
                    {
                        <div class="p-3.5 hover:bg-slate-50 flex items-center justify-between gap-3 transition-colors">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-xs text-slate-900">@o.OrderCode</span>
                                    <span class="text-[10px] text-slate-400">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <p class="text-xs text-slate-600 mt-0.5">@o.CustomerName - <span class="font-bold text-blue-600">@o.TotalAmount.ToString("N0") đ</span></p>
                            </div>
                            <div class="text-right">
                                <span class="inline-block px-2 py-0.5 text-[10px] font-bold rounded @(o.OrderStatus == "Delivered" ? "bg-emerald-100 text-emerald-700" : o.OrderStatus == "Cancelled" ? "bg-rose-100 text-rose-700" : "bg-blue-100 text-blue-700")">
                                    @o.OrderStatus
                                </span>
                                <div class="text-[10px] text-slate-400 mt-0.5">@o.PaymentMethod</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Recent Audit Logs Timeline -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900">Hoạt Động Quản Trị Gần Nhất</h3>
            <a href="/Admin/AuditLog" class="text-xs text-blue-600 font-semibold hover:underline">Chi tiết kiểm toán &rarr;</a>
        </div>
        <div class="divide-y divide-slate-100">
            @if (Model.RecentAuditLogs.Count == 0)
            {
                <div class="p-6 text-center text-xs text-slate-400">Chưa có bản ghi nhật ký kiểm toán nào.</div>
            }
            else
            {
                @foreach (var log in Model.RecentAuditLogs)
                {
                    <div class="p-3.5 flex items-center justify-between text-xs hover:bg-slate-50 transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-bold flex items-center justify-center shrink-0 text-xs">
                                @(log.User?.Username?.Substring(0, 1).ToUpper() ?? "S")
                            </span>
                            <div>
                                <p class="text-slate-800 font-semibold">
                                    <span class="text-blue-600">@(log.User?.Username ?? "System")</span>
                                    <span> - @log.Action</span>
                                </p>
                                <p class="text-[11px] text-slate-400">Phân hệ: <span class="font-medium text-slate-600">@log.Module</span> | Bản ghi: <span class="font-mono text-slate-500">@log.RecordId</span></p>
                            </div>
                        </div>
                        <span class="text-[11px] text-slate-400 shrink-0">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Revenue Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        const labels = @Html.Raw(monthLabels);
        const data = @Html.Raw(monthData);

        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: data,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.08)',
                    fill: true,
                    tension: 0.35,
                    borderWidth: 2.5,
                    pointRadius: 4,
                    pointBackgroundColor: '#2563eb'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return (value / 1000000).toLocaleString('vi-VN') + ' tr';
                            }
                        },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Order Status Doughnut Chart
        const statusCtx = document.getElementById('orderStatusChart').getContext('2d');
        const statusCounts = [@Model.PendingOrders, @Model.ProcessingOrders, @Model.ShippingOrders, @Model.DeliveredOrders, @Model.CancelledOrders];
        const total = statusCounts.reduce((a, b) => a + b, 0);

        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Chờ xác nhận', 'Đóng gói', 'Đang giao', 'Đã giao', 'Đã hủy'],
                datasets: [{
                    data: total === 0 ? [1] : statusCounts,
                    backgroundColor: total === 0 ? ['#e2e8f0'] : ['#f59e0b', '#3b82f6', '#6366f1', '#10b981', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        enabled: total > 0
                    }
                }
            }
        });
    </script>
}

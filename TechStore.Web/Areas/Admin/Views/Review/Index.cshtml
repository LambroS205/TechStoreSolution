@model List<TechStore.Core.Entities.ProductReview>
@{
    ViewData["Title"] = "Quản Lý Đánh Giá Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string currentStatus = ViewBag.Status ?? "All";
    string? searchQuery = ViewBag.SearchQuery;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="space-y-6">
    <!-- Header & Breadcrumb -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a href="/Admin/Dashboard" class="hover:text-blue-600">Tổng quan</a>
                <span>/</span>
                <span class="text-slate-600">Đánh giá sản phẩm</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900">Quản Lý & Kiểm Duyệt Đánh Giá</h1>
            <p class="text-xs text-slate-500 mt-0.5">Kiểm soát ý kiến khách hàng, lọc bình luận spam và kiểm duyệt chất lượng trải nghiệm</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold rounded-2xl flex items-center gap-2 shadow-xs">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-2xl flex items-center gap-2 shadow-xs">
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Stat Badges & Filter Tabs -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs font-semibold overflow-x-auto pb-1 no-scrollbar">
            <a href="/Admin/Review?status=All&q=@searchQuery" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "All" ? "bg-bestbuy-blue text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100 border border-slate-200")">
                Tất Cả (@ViewBag.TotalAll)
            </a>
            <a href="/Admin/Review?status=Approved&q=@searchQuery" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Approved" ? "bg-emerald-600 text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100 border border-slate-200")">
                Đã Duyệt (@ViewBag.TotalApproved)
            </a>
            <a href="/Admin/Review?status=Pending&q=@searchQuery" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Pending" ? "bg-amber-600 text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100 border border-slate-200")">
                Chờ Duyệt / Đã Ẩn (@ViewBag.TotalPending)
            </a>
        </div>

        <!-- Search input -->
        <form method="get" action="/Admin/Review" class="relative max-w-xs w-full">
            <input type="hidden" name="status" value="@currentStatus" />
            <input type="text" name="q" value="@searchQuery" placeholder="Tìm tên SP, khách hàng, nội dung..." class="w-full bg-white text-slate-800 text-xs rounded-xl pl-9 pr-4 py-2.5 border border-slate-200 outline-none focus:ring-2 focus:ring-blue-600 shadow-xs" />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </form>
    </div>

    <!-- Review Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-600 divide-y divide-slate-100">
                <thead class="bg-slate-50 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                    <tr>
                        <th class="py-3.5 px-4">Sản Phẩm</th>
                        <th class="py-3.5 px-4">Khách Hàng</th>
                        <th class="py-3.5 px-4">Đánh Giá</th>
                        <th class="py-3.5 px-4">Nội Dung Nhận Xét</th>
                        <th class="py-3.5 px-4">Thời Gian</th>
                        <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                        <th class="py-3.5 px-4 text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <img src="@item.Product.FeaturedImage" alt="@item.Product.Name" class="w-10 h-10 object-contain rounded-lg border border-slate-100 bg-slate-50 p-1 shrink-0" onerror="this.src='/assets/images/placeholder.png'" />
                                        <div class="min-w-0 max-w-xs">
                                            <a href="/product/@item.Product.Slug" target="_blank" class="font-bold text-slate-900 hover:text-blue-600 line-clamp-1">
                                                @item.Product.Name
                                            </a>
                                            <span class="text-[10px] text-slate-400">ID: #@item.Product.ProductId</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-800">@(item.User?.FullName ?? "N/A")</div>
                                    <div class="text-[10px] text-slate-400">@(item.User?.Email ?? "")</div>
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <div class="flex items-center text-amber-400">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= item.Rating)
                                            {
                                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3.5 h-3.5 text-slate-200 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                            }
                                        }
                                        <span class="ml-1 text-[11px] font-bold text-slate-700">@item.Rating/5</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 max-w-sm">
                                    <p class="line-clamp-2 text-slate-800 text-[11px] leading-relaxed">
                                        @(string.IsNullOrWhiteSpace(item.Comment) ? "(Không có nhận xét bằng chữ)" : item.Comment)
                                    </p>
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap text-slate-400 text-[11px]">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap text-center">
                                    @if (item.IsApproved)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                            ✓ Đang Hiển Thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                            ✕ Đã Ẩn
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <!-- Toggle Status Form -->
                                        <form method="post" action="/Admin/Review/ToggleStatus/@item.ReviewId">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-2.5 py-1 text-[11px] font-bold rounded-lg border transition-colors @(item.IsApproved ? "border-amber-200 text-amber-700 hover:bg-amber-50" : "border-emerald-200 text-emerald-700 hover:bg-emerald-50")">
                                                @(item.IsApproved ? "Ẩn bài" : "Duyệt hiển thị")
                                            </button>
                                        </form>

                                        <!-- Delete Form -->
                                        <form method="post" action="/Admin/Review/Delete/@item.ReviewId" onsubmit="return confirm('Bạn có chắc muốn xóa vĩnh viễn đánh giá này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Xóa đánh giá">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                Không tìm thấy đánh giá nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="p-4 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-400">Trang @currentPage / @totalPages (Tổng @ViewBag.TotalItems đánh giá)</span>
                <div class="flex items-center gap-1.5">
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <a href="/Admin/Review?status=@currentStatus&q=@searchQuery&page=@p" class="w-7 h-7 rounded-lg flex items-center justify-center font-bold transition-colors @(p == currentPage ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                            @p
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

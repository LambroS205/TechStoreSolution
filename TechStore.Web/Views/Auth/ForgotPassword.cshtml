@model TechStore.Web.Controllers.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8 space-y-6">
        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-bestbuy-blue text-bestbuy-yellow flex items-center justify-center font-black text-2xl shadow-sm">
                🔐
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Quên Mật Khẩu</h1>
            <p class="text-xs text-slate-500 font-medium">Nhập địa chỉ email đã đăng ký để nhận liên kết đặt lại mật khẩu</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold rounded-xl">
                <p>✅ @TempData["SuccessMessage"]</p>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-xl">
                <p>&bull; @TempData["ErrorMessage"]</p>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-xl space-y-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>&bull; @error.ErrorMessage</p>
                }
            </div>
        }

        <form action="/auth/forgot-password" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Địa chỉ Email đã đăng ký *</label>
                <input type="email" name="Email" value="@Model?.Email" required
                       class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue"
                       placeholder="email@example.com" />
            </div>

            <button type="submit" class="w-full py-3.5 bg-bestbuy-blue hover:bg-blue-700 text-white font-black text-sm rounded-xl shadow-md transition-all active:scale-95">
                GỬI LIÊN KẾT KHÔI PHỤC
            </button>
        </form>

        <div class="text-center text-xs text-slate-600 space-y-1">
            <p>Đã nhớ mật khẩu? <a href="/auth/login" class="font-bold text-blue-600 hover:underline">Đăng nhập ngay</a></p>
            <p>Chưa có tài khoản? <a href="/auth/register" class="font-bold text-blue-600 hover:underline">Đăng ký thành viên</a></p>
        </div>
    </div>
</div>

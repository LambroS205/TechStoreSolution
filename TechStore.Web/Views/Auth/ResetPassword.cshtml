@model TechStore.Web.Controllers.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8 space-y-6">
        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-emerald-600 text-white flex items-center justify-center font-black text-2xl shadow-sm">
                🔑
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Đặt Lại Mật Khẩu</h1>
            <p class="text-xs text-slate-500 font-medium">Tạo mật khẩu mới cho tài khoản TechStore của bạn</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-xl">
                <p>&bull; @TempData["ErrorMessage"]</p>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-xl space-y-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>&bull; @error.ErrorMessage</p>
                }
            </div>
        }

        <form action="/auth/reset-password" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Token" value="@Model?.Token" />

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Mật Khẩu Mới *</label>
                <input type="password" name="NewPassword" required minlength="8"
                       class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-emerald-500"
                       placeholder="Nhập mật khẩu mới (tối thiểu 8 ký tự)..." />
                <p class="text-[11px] text-slate-500 mt-1">Mật khẩu phải có tối thiểu 8 ký tự, gồm cả chữ cái và chữ số.</p>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Xác Nhận Mật Khẩu *</label>
                <input type="password" name="ConfirmPassword" required minlength="8"
                       class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-emerald-500"
                       placeholder="Nhập lại mật khẩu mới..." />
            </div>

            <button type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm rounded-xl shadow-md transition-all active:scale-95">
                XÁC NHẬN ĐẶT LẠI MẬT KHẨU
            </button>
        </form>

        <div class="text-center text-xs text-slate-500">
            <p>Liên kết có hiệu lực trong 30 phút kể từ khi yêu cầu.</p>
        </div>
    </div>
</div>

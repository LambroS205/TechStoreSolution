@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto px-4 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8 space-y-6">
        <!-- Logo & Header -->
        <div class="text-center space-y-2">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-bestbuy-blue text-bestbuy-yellow flex items-center justify-center font-black text-2xl shadow-sm">
                T
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Đăng Nhập TechStore</h1>
            <p class="text-xs text-slate-500 font-medium">Truy cập để quản lý đơn hàng & đồng bộ giỏ hàng cá nhân</p>
        </div>

        <!-- ⚡ 1-Click Quick Demo Login (Dành cho việc chấm điểm & demo bài thi) -->
        <div class="bg-gradient-to-br from-amber-50 to-yellow-50 border border-amber-200 rounded-2xl p-4 space-y-2.5">
            <div class="flex items-center gap-1.5 text-xs font-black text-amber-900">
                <span>⚡ ĐĂNG NHẬP NHANH 1-CHẠM (DEMO MODE)</span>
            </div>
            <p class="text-[11px] text-amber-700 leading-snug">
                Bấm nút bên dưới để hệ thống tự điền thông tin và đăng nhập ngay lập tức:
            </p>
            <div class="grid grid-cols-2 gap-2 pt-1">
                <button type="button" onclick="quickLogin('vipcustomer', 'Customer@123')" class="px-3 py-2 bg-white hover:bg-amber-100 text-slate-800 border border-amber-300 rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5 active:scale-95">
                    <span>👑 Khách VIP</span>
                </button>
                <button type="button" onclick="quickLogin('admin', 'Admin@123')" class="px-3 py-2 bg-slate-900 hover:bg-black text-white rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5 active:scale-95">
                    <span>⚙️ Super Admin</span>
                </button>
                <button type="button" onclick="quickLogin('staff_kho', 'Staff@123')" class="px-3 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5 active:scale-95">
                    <span>📦 NV Kho & SP</span>
                </button>
                <button type="button" onclick="quickLogin('staff_order', 'Staff@123')" class="px-3 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-300 rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5 active:scale-95">
                    <span>🚚 NV Đơn & POS</span>
                </button>
                <button type="button" onclick="quickLogin('staff_marketing', 'Marketing@123')" class="px-3 py-2 col-span-2 bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-300 rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5 active:scale-95">
                    <span>📢 NV Marketing & Banner</span>
                </button>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-xl space-y-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>&bull; @error.ErrorMessage</p>
                }
            </div>
        }

        <form id="loginMainForm" action="/auth/login@(ViewBag.ReturnUrl != null ? $"?returnUrl={ViewBag.ReturnUrl}" : "")" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Tên Đăng Nhập hoặc Email *</label>
                <input type="text" id="loginUsername" name="Username" value="@Model?.Username" required 
                       class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" 
                       placeholder="admin hoặc email..." />
            </div>

            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Mật Khẩu *</label>
                    <a href="/auth/forgot-password" class="text-xs text-blue-600 hover:underline">Quên mật khẩu?</a>
                </div>
                <input type="password" id="loginPassword" name="Password" required 
                       class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" 
                       placeholder="Nhập mật khẩu..." />
            </div>

            <div class="flex items-center justify-between pt-1 text-xs">
                <label class="flex items-center gap-2 cursor-pointer text-slate-600 font-medium select-none">
                    <input type="checkbox" name="RememberMe" value="true" class="rounded text-blue-600" />
                    <span>Duy trì đăng nhập 14 ngày</span>
                </label>
            </div>

            <button type="submit" class="w-full py-3.5 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-sm rounded-xl shadow-md transition-all active:scale-95">
                ĐĂNG NHẬP NGAY
            </button>
        </form>

        <div class="text-center text-xs text-slate-600">
            Chưa có tài khoản? <a href="/auth/register@(ViewBag.ReturnUrl != null ? $"?returnUrl={ViewBag.ReturnUrl}" : "")" class="font-bold text-blue-600 hover:underline">Đăng ký thành viên ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickLogin(user, pass) {
            document.getElementById('loginUsername').value = user;
            document.getElementById('loginPassword').value = pass;
            document.getElementById('loginMainForm').submit();
        }
    </script>
}
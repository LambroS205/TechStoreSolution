@model TechStore.Core.Entities.Order?
@{
    ViewData["Title"] = Model != null ? $"Tra Cứu Đơn Hàng #{Model.OrderCode}" : "Tra Cứu Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string? orderCode = ViewBag.OrderCode as string;
    string? phone = ViewBag.Phone as string;
    string? errorMsg = ViewBag.ErrorMessage as string;

    int currentStep = Model?.OrderStatus switch
    {
        "Pending" => 1,
        "Confirmed" => 2,
        "Processing" => 3,
        "Shipping" => 4,
        "Delivered" => 5,
        _ => 0
    };
}

<div class="max-w-4xl mx-auto px-4 py-10 space-y-8">
    <!-- Header -->
    <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-xs font-bold mb-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <span>Tra cứu trực tuyến 24/7</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Tra Cứu Tiến Trình Đơn Hàng</h1>
        <p class="text-xs sm:text-sm text-slate-500 max-w-lg mx-auto">
            Nhập Mã đơn hàng và Số điện thoại đặt hàng để kiểm tra trạng thái đóng gói, lịch trình vận chuyển và thông tin thanh toán.
        </p>
    </div>

    <!-- Lookup Form -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <form method="get" action="/order/tracking" class="grid grid-cols-1 sm:grid-cols-5 gap-4">
            <div class="sm:col-span-2">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Mã Đơn Hàng *</label>
                <input type="text" name="orderCode" value="@orderCode" required placeholder="VD: ORD20261002..." class="w-full text-xs sm:text-sm font-mono font-bold uppercase border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-blue-600 bg-slate-50 focus:bg-white transition" />
            </div>
            <div class="sm:col-span-2">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Số Điện Thoại Đặt Hàng *</label>
                <input type="tel" name="phone" value="@phone" required placeholder="VD: 0909123456" class="w-full text-xs sm:text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-blue-600 bg-slate-50 focus:bg-white transition" />
            </div>
            <div class="sm:col-span-1 flex items-end">
                <button type="submit" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md transition-all active:scale-95 flex items-center justify-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    <span>Tra Cứu</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold rounded-2xl flex items-center gap-3">
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@errorMsg</span>
        </div>
    }

    <!-- Result Box -->
    @if (Model != null)
    {
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-8">
            <!-- Order Header Info -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Mã đơn:</span>
                        <span class="font-mono text-lg font-black text-slate-900">#@Model.OrderCode</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5">Đặt lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider @(Model.OrderStatus switch {
                        "Pending" => "bg-blue-100 text-blue-800",
                        "Confirmed" => "bg-sky-100 text-sky-800",
                        "Processing" => "bg-amber-100 text-amber-800",
                        "Shipping" => "bg-indigo-100 text-indigo-800",
                        "Delivered" => "bg-emerald-100 text-emerald-800",
                        "Cancelled" => "bg-rose-100 text-rose-800",
                        _ => "bg-slate-100 text-slate-700"
                    })">
                        @(Model.OrderStatus switch {
                            "Pending" => "Chờ xác nhận",
                            "Confirmed" => "Đã xác nhận",
                            "Processing" => "Đang đóng gói",
                            "Shipping" => "Đang giao hàng",
                            "Delivered" => "Đã giao thành công",
                            "Cancelled" => "Đơn hàng đã hủy",
                            _ => Model.OrderStatus
                        })
                    </span>
                    <span class="px-3 py-1 rounded-full text-xs font-bold @(Model.PaymentStatus == "Paid" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                        @(Model.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                    </span>
                </div>
            </div>

            <!-- Visual Progress Timeline (5 Steps) -->
            @if (Model.OrderStatus != "Cancelled")
            {
                <div class="py-4">
                    <div class="grid grid-cols-5 gap-2 text-center relative">
                        <!-- Step 1 -->
                        <div class="space-y-2">
                            <div class="w-9 h-9 mx-auto rounded-full flex items-center justify-center font-bold text-xs @(currentStep >= 1 ? "bg-blue-600 text-white shadow-md shadow-blue-200" : "bg-slate-100 text-slate-400")">
                                1
                            </div>
                            <p class="text-[11px] font-bold @(currentStep >= 1 ? "text-slate-900" : "text-slate-400")">Chờ Xác Nhận</p>
                        </div>
                        <!-- Step 2 -->
                        <div class="space-y-2">
                            <div class="w-9 h-9 mx-auto rounded-full flex items-center justify-center font-bold text-xs @(currentStep >= 2 ? "bg-blue-600 text-white shadow-md shadow-blue-200" : "bg-slate-100 text-slate-400")">
                                2
                            </div>
                            <p class="text-[11px] font-bold @(currentStep >= 2 ? "text-slate-900" : "text-slate-400")">Đã Xác Nhận</p>
                        </div>
                        <!-- Step 3 -->
                        <div class="space-y-2">
                            <div class="w-9 h-9 mx-auto rounded-full flex items-center justify-center font-bold text-xs @(currentStep >= 3 ? "bg-blue-600 text-white shadow-md shadow-blue-200" : "bg-slate-100 text-slate-400")">
                                3
                            </div>
                            <p class="text-[11px] font-bold @(currentStep >= 3 ? "text-slate-900" : "text-slate-400")">Đóng Gói</p>
                        </div>
                        <!-- Step 4 -->
                        <div class="space-y-2">
                            <div class="w-9 h-9 mx-auto rounded-full flex items-center justify-center font-bold text-xs @(currentStep >= 4 ? "bg-blue-600 text-white shadow-md shadow-blue-200" : "bg-slate-100 text-slate-400")">
                                4
                            </div>
                            <p class="text-[11px] font-bold @(currentStep >= 4 ? "text-slate-900" : "text-slate-400")">Đang Giao</p>
                        </div>
                        <!-- Step 5 -->
                        <div class="space-y-2">
                            <div class="w-9 h-9 mx-auto rounded-full flex items-center justify-center font-bold text-xs @(currentStep >= 5 ? "bg-emerald-600 text-white shadow-md shadow-emerald-200" : "bg-slate-100 text-slate-400")">
                                5
                            </div>
                            <p class="text-[11px] font-bold @(currentStep >= 5 ? "text-slate-900" : "text-slate-400")">Đã Giao</p>
                        </div>
                    </div>
                </div>
            }

            <!-- VietQR Payment Box (If unpaid VietQR) -->
            @if (ViewBag.VietQrUrl != null && Model.PaymentStatus != "Paid" && Model.OrderStatus != "Cancelled")
            {
                <div id="trackingQrCard" class="p-6 bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-3xl flex flex-col sm:flex-row items-center gap-6">
                    <img src="@ViewBag.VietQrUrl" alt="VietQR Payment" class="w-44 h-44 object-contain bg-white p-2 rounded-2xl shadow-sm border border-blue-100 shrink-0" />
                    <div class="space-y-2.5 text-xs flex-1 text-center sm:text-left">
                        <span class="px-2.5 py-0.5 bg-blue-600 text-white font-extrabold rounded-lg text-[10px] uppercase">Quét QR Thanh Toán Ngay</span>
                        <h3 class="text-base font-bold text-slate-900">Đơn hàng chưa hoàn tất thanh toán</h3>
                        <p class="text-slate-600 leading-relaxed">
                            Mở ứng dụng Ngân hàng hoặc Ví điện tử (MoMo, ZaloPay, Viettel Money...) và quét mã QR để thanh toán tự động đúng số tiền <strong class="text-blue-600 font-extrabold">@Model.TotalAmount.ToString("N0") đ</strong>.
                        </p>
                        <div class="pt-1 text-[11px] text-slate-500 space-y-0.5 font-mono">
                            <p>Ngân hàng: <strong>@ViewBag.BankName</strong></p>
                            <p>Số tài khoản: <strong>@ViewBag.AccountNo</strong> &bull; Chủ TK: <strong>@ViewBag.AccountName</strong></p>
                            <p>Nội dung CK: <strong class="text-blue-600 font-bold">@Model.OrderCode</strong></p>
                        </div>
                        <div class="pt-2">
                            <button type="button" onclick="simulateTrackingPaymentConfirm('@Model.OrderCode')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-sm transition">
                                ⚡ Giả Lập Xác Nhận Đã Thanh Toán
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Items Details -->
            <div class="space-y-3">
                <h4 class="font-bold text-slate-900 text-sm">Sản phẩm trong kiện hàng (@Model.OrderDetails.Count)</h4>
                <div class="divide-y divide-slate-100 border border-slate-100 rounded-2xl p-4">
                    @foreach (var item in Model.OrderDetails)
                    {
                        var img = item.Variant?.ThumbnailImage ?? item.Variant?.Product?.FeaturedImage ?? "/assets/images/placeholder.png";
                        <div class="py-3 first:pt-0 last:pb-0 flex items-center justify-between gap-4 text-xs">
                            <div class="flex items-center gap-3 min-w-0">
                                <img src="@img" class="w-12 h-12 object-contain rounded-xl border border-slate-100 bg-slate-50 p-1 shrink-0" onerror="this.src='/assets/images/placeholder.png'" />
                                <div class="min-w-0">
                                    <p class="font-bold text-slate-800 truncate">@item.ProductName</p>
                                    <p class="text-slate-400 text-[11px]">@item.VariantName &bull; SL: @item.Quantity</p>
                                </div>
                            </div>
                            <span class="font-extrabold text-blue-600 shrink-0">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Shipping & Pricing -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-slate-100 text-xs">
                <div class="space-y-1.5">
                    <h5 class="font-bold text-slate-900 uppercase tracking-wider text-[11px]">Thông Tin Giao Nhận</h5>
                    <p class="text-slate-600"><span class="text-slate-400">Người nhận:</span> <strong class="text-slate-800">@Model.CustomerName</strong></p>
                    <p class="text-slate-600"><span class="text-slate-400">Số điện thoại:</span> <strong class="text-slate-800">@Model.CustomerPhone</strong></p>
                    <p class="text-slate-600"><span class="text-slate-400">Địa chỉ:</span> @Model.ShippingAddress</p>
                </div>
                <div class="space-y-1.5 sm:text-right">
                    <h5 class="font-bold text-slate-900 uppercase tracking-wider text-[11px]">Tổng Tiền Đơn Hàng</h5>
                    <p class="text-slate-600"><span class="text-slate-400">Tạm tính:</span> @Model.SubTotal.ToString("N0") đ</p>
                    @if (Model.DiscountAmount > 0)
                    {
                        <p class="text-emerald-600"><span class="text-slate-400">Giảm giá:</span> -@Model.DiscountAmount.ToString("N0") đ</p>
                    }
                    <p class="text-slate-600"><span class="text-slate-400">Vận chuyển:</span> Miễn phí</p>
                    <p class="text-base font-black text-blue-600 pt-1">
                        Tổng: @Model.TotalAmount.ToString("N0") đ
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    async function simulateTrackingPaymentConfirm(orderCode) {
        try {
            const res = await fetch(`/checkout/demo-confirm-payment/${orderCode}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) showToast('Đã xác nhận thanh toán!', 'success');
                window.location.reload();
            } else {
                alert(data.message);
            }
        } catch(e) {
            alert('Lỗi kết nối');
        }
    }
</script>
}

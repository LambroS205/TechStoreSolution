@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng - TechStore";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var defaultAddr = (TechStore.Core.Entities.CustomerAddress?)ViewBag.DefaultAddress;
    var savedAddresses = (List<TechStore.Core.Entities.CustomerAddress>?)ViewBag.SavedAddresses ?? new List<TechStore.Core.Entities.CustomerAddress>();
    var custUser = (TechStore.Core.Entities.User?)ViewBag.CustomerUser;
    string recipientName = defaultAddr?.RecipientName ?? custUser?.FullName ?? "";
    string recipientPhone = defaultAddr?.PhoneNumber ?? custUser?.PhoneNumber ?? "";
    string recipientEmail = custUser?.Email ?? "";
    string province = defaultAddr?.Province ?? "TP. Hồ Chí Minh";
    string district = defaultAddr?.District ?? "Quận 1";
    string ward = defaultAddr?.Ward ?? "Phường Bến Nghé";
    string addressDetail = defaultAddr?.StreetAddress ?? "123 Đường Lê Lợi";
}

<div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Thanh Toán Đơn Hàng</h1>
            <p class="text-xs text-slate-500 mt-0.5">Vui lòng điền thông tin người nhận và chọn phương thức thanh toán an toàn</p>
        </div>
        <a href="/products" class="text-xs font-bold text-blue-600 hover:underline flex items-center gap-1">
            &larr; Tiếp tục mua hàng
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-2xl mb-6 shadow-xs flex items-center gap-2">
            <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <form id="checkoutForm" method="post" action="/checkout/place-order" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CartItemsJson" id="checkoutCartItemsJson" value="[]" />
        <input type="hidden" name="CouponCode" id="AppliedCouponCode" />

        <!-- Cột 1 & 2: Thông tin giao hàng & Phương thức thanh toán -->
        <div class="lg:col-span-2 space-y-6">
            <!-- 1. Hình thức nhận hàng (Tabs: Giao tận nơi vs Nhận tại showroom) -->
            <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold">1</span>
                        <span>Hình Thức Nhận Hàng</span>
                    </h3>
                </div>

                <!-- Tabs -->
                <div class="grid grid-cols-2 gap-3 p-1 bg-slate-100 rounded-2xl">
                    <button type="button" id="tabDeliveryDoor" onclick="switchDeliveryMode('door')" class="py-2.5 rounded-xl font-black text-xs transition-all shadow-sm bg-white text-blue-600 flex items-center justify-center gap-2">
                        <span>🚚 Giao Tận Nơi</span>
                    </button>
                    <button type="button" id="tabDeliveryStore" onclick="switchDeliveryMode('store')" class="py-2.5 rounded-xl font-bold text-xs transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-2">
                        <span>🏪 Nhận Tại Showroom</span>
                    </button>
                </div>

                <!-- Khối Showroom TechStore (chỉ hiện khi chọn Nhận tại showroom) -->
                <div id="storePickupBox" class="hidden space-y-3 p-4 bg-blue-50/60 rounded-2xl border border-blue-100 text-xs">
                    <p class="font-bold text-blue-900">Chọn Showroom nhận máy trực tiếp (Được hỗ trợ kỹ thuật cài đặt miễn phí):</p>
                    <label class="flex items-start gap-2.5 p-3 bg-white rounded-xl border border-blue-200 cursor-pointer">
                        <input type="radio" name="pickupStore" value="hcm" checked onchange="selectShowroom('HCM')" class="mt-0.5 text-blue-600" />
                        <div>
                            <strong class="text-slate-900 block font-bold">Showroom TechStore Quận 1 - TP.HCM</strong>
                            <span class="text-slate-500">123 Lê Lợi, Phường Bến Nghé, Quận 1 (Mở cửa 8:00 - 21:30 hàng ngày)</span>
                        </div>
                    </label>
                    <label class="flex items-start gap-2.5 p-3 bg-white rounded-xl border border-blue-200 cursor-pointer">
                        <input type="radio" name="pickupStore" value="hn" onchange="selectShowroom('HN')" class="mt-0.5 text-blue-600" />
                        <div>
                            <strong class="text-slate-900 block font-bold">Showroom TechStore Đống Đa - Hà Nội</strong>
                            <span class="text-slate-500">45 Thái Hà, Phường Trung Liệt, Quận Đống Đa (Mở cửa 8:00 - 21:30 hàng ngày)</span>
                        </div>
                    </label>
                </div>

                <!-- Sổ địa chỉ đã lưu (Nếu có) -->
                @if (savedAddresses.Any())
                {
                    <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200 text-xs space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-slate-700">Chọn từ Sổ Địa Chỉ Của Bạn:</span>
                            <span class="text-[10px] text-blue-600 font-semibold">Tự động điền 1-chạm</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            @foreach (var sa in savedAddresses)
                            {
                                <button type="button" 
                                        onclick="fillAddress('@sa.RecipientName', '@sa.PhoneNumber', '@sa.Province', '@sa.District', '@sa.Ward', '@sa.StreetAddress')"
                                        class="p-2.5 text-left bg-white hover:bg-blue-50 border border-slate-200 hover:border-blue-300 rounded-xl transition shadow-2xs">
                                    <div class="flex items-center justify-between">
                                        <strong class="text-slate-900 font-bold">@sa.RecipientName</strong>
                                        @if (sa.IsDefault)
                                        {
                                            <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.2 rounded">Mặc định</span>
                                        }
                                    </div>
                                    <p class="text-slate-500 text-[11px] truncate">@sa.PhoneNumber &bull; @sa.StreetAddress, @sa.District, @sa.Province</p>
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-1">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Họ và Tên Người Nhận *</label>
                        <input type="text" id="custNameInput" name="CustomerName" value="@recipientName" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: Nguyễn Văn A" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Số Điện Thoại Liên Hệ *</label>
                        <input type="tel" id="custPhoneInput" name="CustomerPhone" value="@recipientPhone" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: 0909123456" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-semibold text-slate-700 mb-1">Email Nhận Hóa Đơn Điện Tử</label>
                        <input type="email" id="custEmailInput" name="CustomerEmail" value="@recipientEmail" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: customer@gmail.com" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Tỉnh / Thành Phố *</label>
                        <input type="text" id="provinceInput" name="Province" value="@province" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: TP. Hồ Chí Minh" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Quận / Huyện *</label>
                        <input type="text" id="districtInput" name="District" value="@district" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: Quận 1" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Phường / Xã *</label>
                        <input type="text" id="wardInput" name="Ward" value="@ward" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: Phường Bến Nghé" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Địa Chỉ Chi Tiết (Số nhà, đường) *</label>
                        <input type="text" id="addressDetailInput" name="AddressDetail" value="@addressDetail" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: 123 Đường Lê Lợi" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-semibold text-slate-700 mb-1">Ghi Chú Đơn Hàng (Tùy chọn)</label>
                        <textarea name="OrderNotes" rows="2" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ghi chú thời gian nhận hàng thuận tiện..."></textarea>
                    </div>
                </div>
            </div>

            <!-- 2. Phương thức thanh toán (COD & VietQR) -->
            <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
                <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider pb-2 border-b border-slate-100 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold">2</span>
                    <span>Phương Thức Thanh Toán</span>
                </h3>

                <div class="space-y-3">
                    <!-- Phương thức 1: VietQR -->
                    <label class="flex items-start gap-3 p-4 border-2 rounded-2xl cursor-pointer border-blue-500 bg-blue-50/20 transition-all">
                        <input type="radio" name="PaymentMethod" value="VietQR" checked class="mt-1 text-blue-600 w-4 h-4" />
                        <div class="flex-1">
                            <div class="font-bold text-slate-900 text-sm flex items-center justify-between">
                                <span>Chuyển Khoản Tức Thì Chuẩn VietQR NAPAS 247</span>
                                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-black rounded-lg">Khuyên Dùng</span>
                            </div>
                            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                                Quét mã QR tự động điền đúng số tiền và nội dung đơn qua tất cả App Ngân Hàng (Vietcombank, MBBank, Techcombank, VPBank...) và Ví điện tử.
                            </p>
                        </div>
                    </label>

                    <!-- Phương thức 2: COD -->
                    <label class="flex items-start gap-3 p-4 border rounded-2xl cursor-pointer hover:border-slate-400 bg-white transition-all">
                        <input type="radio" name="PaymentMethod" value="COD" class="mt-1 text-blue-600 w-4 h-4" />
                        <div class="flex-1">
                            <div class="font-bold text-slate-900 text-sm">Thanh Toán Tiền Mặt Khi Nhận Hàng (COD)</div>
                            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                                Quý khách được mở hộp kiểm tra thiết bị nguyên seal trước khi thanh toán tiền mặt cho nhân viên giao vận.
                            </p>
                        </div>
                    </label>
                </div>
            </div>
        </div>

        <!-- Cột 3: Tóm tắt đơn hàng & Mã giảm giá -->
        <div class="space-y-6">
            <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
                <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider pb-2 border-b border-slate-100">
                    Đơn Hàng Của Bạn
                </h3>

                <!-- Danh sách mặt hàng render qua JS -->
                <div id="checkoutItemsList" class="space-y-3 divide-y divide-slate-100 max-h-60 overflow-y-auto pr-1">
                    <!-- JS render -->
                </div>

                <!-- Nhập Coupon & Available Coupon Chips -->
                <div class="pt-2 border-t border-slate-100 space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Mã Giảm Giá / Ưu Đãi</label>
                    <div class="flex gap-2">
                        <input type="text" id="checkoutCouponInput" class="flex-1 text-xs border border-slate-300 rounded-xl p-2.5 uppercase font-bold outline-none focus:ring-2 focus:ring-blue-500" placeholder="Mã ưu đãi..." />
                        <button type="button" onclick="applyCheckoutCoupon()" class="px-4 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-xl transition">Áp dụng</button>
                    </div>
                    <div id="checkoutCouponMsg" class="text-[11px] font-medium hidden"></div>

                    <!-- Available coupons 1-touch chips -->
                    <div id="checkoutAvailableCoupons" class="flex flex-wrap gap-1.5 pt-1">
                        <!-- Loaded via JS -->
                    </div>
                </div>

                <!-- Bảng tính tiền -->
                <div class="pt-3 border-t border-slate-100 space-y-2 text-xs text-slate-600">
                    <div class="flex justify-between">
                        <span>Tạm tính:</span>
                        <strong id="checkoutSubTotal" class="text-slate-900">0 đ</strong>
                    </div>
                    <div class="flex justify-between">
                        <span>Phí giao hàng:</span>
                        <strong class="text-emerald-600 font-bold">Miễn phí (Toàn quốc)</strong>
                    </div>
                    <div id="checkoutDiscountRow" class="flex justify-between text-emerald-600 hidden">
                        <span>Giảm giá:</span>
                        <strong id="checkoutDiscountAmount">-0 đ</strong>
                    </div>
                    <div class="flex justify-between text-base pt-2 border-t border-slate-200">
                        <strong class="text-slate-900">Tổng thanh toán:</strong>
                        <strong id="checkoutFinalTotal" class="text-blue-600 font-black text-xl">0 đ</strong>
                    </div>
                </div>

                <!-- Nút Xác nhận Đặt Hàng -->
                <button type="submit" id="btnPlaceOrder" class="w-full py-3.5 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-sm rounded-xl shadow-md hover:shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
                    <span>XÁC NHẬN ĐẶT HÀNG</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    let currentSubTotal = 0;
    let appliedDiscount = 0;

    function switchDeliveryMode(mode) {
        const btnDoor = document.getElementById('tabDeliveryDoor');
        const btnStore = document.getElementById('tabDeliveryStore');
        const storeBox = document.getElementById('storePickupBox');
        if (mode === 'door') {
            btnDoor.className = 'py-2.5 rounded-xl font-black text-xs transition-all shadow-sm bg-white text-blue-600 flex items-center justify-center gap-2';
            btnStore.className = 'py-2.5 rounded-xl font-bold text-xs transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-2';
            storeBox.classList.add('hidden');
        } else {
            btnStore.className = 'py-2.5 rounded-xl font-black text-xs transition-all shadow-sm bg-white text-blue-600 flex items-center justify-center gap-2';
            btnDoor.className = 'py-2.5 rounded-xl font-bold text-xs transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-2';
            storeBox.classList.remove('hidden');
            selectShowroom('HCM');
        }
    }

    function selectShowroom(city) {
        if (city === 'HCM') {
            document.getElementById('provinceInput').value = 'TP. Hồ Chí Minh';
            document.getElementById('districtInput').value = 'Quận 1';
            document.getElementById('wardInput').value = 'Phường Bến Nghé';
            document.getElementById('addressDetailInput').value = 'Showroom TechStore 123 Lê Lợi';
        } else {
            document.getElementById('provinceInput').value = 'Hà Nội';
            document.getElementById('districtInput').value = 'Quận Đống Đa';
            document.getElementById('wardInput').value = 'Phường Trung Liệt';
            document.getElementById('addressDetailInput').value = 'Showroom TechStore 45 Thái Hà';
        }
    }

    function fillAddress(name, phone, province, district, ward, street) {
        document.getElementById('custNameInput').value = name;
        document.getElementById('custPhoneInput').value = phone;
        document.getElementById('provinceInput').value = province;
        document.getElementById('districtInput').value = district;
        document.getElementById('wardInput').value = ward;
        document.getElementById('addressDetailInput').value = street;
        if (window.showToast) showToast('Đã chọn địa chỉ nhận hàng!', 'info');
    }

    async function loadAvailableCouponsForCheckout() {
        const container = document.getElementById('checkoutAvailableCoupons');
        if (!container) return;
        try {
            const res = await fetch('/api/cart/available-coupons');
            if (res.ok) {
                const coupons = await res.json();
                let html = '';
                coupons.forEach(c => {
                    html += `
                        <button type="button" onclick="selectCheckoutCoupon('${c.code}')" class="px-2 py-0.5 rounded-lg border border-slate-200 hover:border-blue-500 bg-slate-50 text-[10px] font-bold text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            🏷️ ${c.code}
                        </button>
                    `;
                });
                container.innerHTML = html;
            }
        } catch(e) {}
    }

    function selectCheckoutCoupon(code) {
        const input = document.getElementById('checkoutCouponInput');
        if (input) {
            input.value = code;
            applyCheckoutCoupon();
        }
    }

    async function initCheckoutPage() {
        const cart = getStoredCart();
        document.getElementById('checkoutCartItemsJson').value = JSON.stringify(cart);

        if (cart.length === 0) {
            alert('Giỏ hàng trống! Vui lòng chọn sản phẩm.');
            window.location.href = '/products';
            return;
        }

        try {
            const res = await fetch('/api/cart/details', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(cart)
            });
            const data = await res.json();
            currentSubTotal = data.subTotal;

            const list = document.getElementById('checkoutItemsList');
            let html = '';
            data.items.forEach(i => {
                html += `
                    <div class="pt-2 first:pt-0 flex items-center justify-between gap-2 text-xs">
                        <div class="truncate">
                            <p class="font-bold text-slate-800 truncate">${i.productName}</p>
                            <span class="text-slate-500">${i.variantName} x ${i.quantity}</span>
                        </div>
                        <strong class="text-slate-900 shrink-0">${i.lineTotal.toLocaleString('vi-VN')} đ</strong>
                    </div>
                `;
            });
            list.innerHTML = html;

            document.getElementById('checkoutSubTotal').innerText = currentSubTotal.toLocaleString('vi-VN') + ' đ';
            updateTotals();

            // Tự động kiểm tra nếu có mã giảm giá đã lưu từ Giỏ hàng Drawer
            const savedCoupon = sessionStorage.getItem('techstore_coupon') || localStorage.getItem('techstore_coupon');
            if (savedCoupon) {
                const couponInput = document.getElementById('checkoutCouponInput');
                if (couponInput) {
                    couponInput.value = savedCoupon;
                    await applyCheckoutCoupon();
                }
            }

            loadAvailableCouponsForCheckout();
        } catch (err) {
            console.error(err);
        }
    }

    async function applyCheckoutCoupon() {
        const code = document.getElementById('checkoutCouponInput').value.trim().toUpperCase();
        const msgEl = document.getElementById('checkoutCouponMsg');
        const appliedInput = document.getElementById('AppliedCouponCode');
        if (!code) {
            if (appliedInput) appliedInput.value = '';
            return;
        }

        try {
            const res = await fetch('/api/cart/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ couponCode: code, subTotal: currentSubTotal })
            });
            const data = await res.json();
            msgEl.classList.remove('hidden');

            if (data.success) {
                appliedDiscount = data.discountAmount;
                if (appliedInput) appliedInput.value = code;
                sessionStorage.setItem('techstore_coupon', code);
                msgEl.className = 'text-[11px] font-bold text-emerald-600';
                msgEl.innerText = `✓ ${data.message}`;
                document.getElementById('checkoutDiscountRow').classList.remove('hidden');
                document.getElementById('checkoutDiscountAmount').innerText = '-' + appliedDiscount.toLocaleString('vi-VN') + ' đ';
                updateTotals();
            } else {
                appliedDiscount = 0;
                if (appliedInput) appliedInput.value = '';
                sessionStorage.removeItem('techstore_coupon');
                msgEl.className = 'text-[11px] font-bold text-rose-600';
                msgEl.innerText = `✕ ${data.message}`;
                document.getElementById('checkoutDiscountRow').classList.add('hidden');
                updateTotals();
            }
        } catch {
            if (appliedInput) appliedInput.value = '';
            msgEl.className = 'text-[11px] font-bold text-rose-600';
            msgEl.innerText = 'Lỗi kết nối kiểm tra mã giảm giá!';
            msgEl.classList.remove('hidden');
        }
    }

    function updateTotals() {
        const finalTotal = Math.max(currentSubTotal - appliedDiscount, 0);
        document.getElementById('checkoutFinalTotal').innerText = finalTotal.toLocaleString('vi-VN') + ' đ';
    }

    document.addEventListener('DOMContentLoaded', () => {
        initCheckoutPage();

        const form = document.getElementById('checkoutForm');
        const submitBtn = document.getElementById('btnPlaceOrder');

        if (form && submitBtn) {
            form.addEventListener('submit', (e) => {
                const cart = getStoredCart();
                if (!cart || cart.length === 0) {
                    e.preventDefault();
                    alert('Giỏ hàng của bạn đang trống! Vui lòng chọn sản phẩm.');
                    window.location.href = '/products';
                    return false;
                }

                if (form.dataset.submitting === 'true') {
                    e.preventDefault();
                    return false;
                }

                form.dataset.submitting = 'true';
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
                submitBtn.innerHTML = `
                    <svg class="animate-spin w-4 h-4 text-slate-900" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>

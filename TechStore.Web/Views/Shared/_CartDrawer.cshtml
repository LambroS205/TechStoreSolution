<!-- Backdrop Mờ -->
<div id="cartBackdrop" onclick="toggleCartDrawer()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden transition-opacity duration-300"></div>

<!-- Slide-over Drawer Panel -->
<div id="cartDrawer" class="fixed inset-y-0 right-0 max-w-md w-full bg-white z-50 shadow-2xl flex flex-col justify-between translate-x-full transition-transform duration-300 ease-in-out">
    <!-- Drawer Header -->
    <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-2">
            <span class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            </span>
            <div>
                <h3 class="font-bold text-slate-900 text-base">Giỏ Hàng Của Bạn</h3>
                <p id="drawerItemCount" class="text-xs text-slate-500 font-medium">0 sản phẩm</p>
            </div>
        </div>
        <button onclick="toggleCartDrawer()" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-200/50 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>

    <!-- Drawer Body: Danh sách mặt hàng từ LocalStorage render qua JS -->
    <div id="drawerCartItems" class="flex-1 overflow-y-auto p-4 space-y-4 divide-y divide-slate-100">
        <!-- Render động qua JavaScript -->
    </div>

    <!-- Drawer Footer: Tạm tính & Nút Đặt Hàng -->
    <div class="p-4 border-t border-slate-200 bg-slate-50 space-y-3">
        <!-- Áp dụng mã giảm giá nhanh -->
        <div class="flex gap-2">
            <input type="text" id="drawerCouponInput" placeholder="Nhập mã: TECHSTORE100" class="flex-1 text-xs border border-slate-300 rounded-lg px-3 py-2 uppercase font-bold outline-none focus:ring-2 focus:ring-blue-500" />
            <button onclick="applyDrawerCoupon()" class="px-3 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg transition-colors">Áp dụng</button>
        </div>
        <div id="couponMsg" class="text-[11px] font-medium hidden"></div>

        <!-- Bảng tổng tiền -->
        <div class="space-y-1.5 text-xs text-slate-600 pt-1">
            <div class="flex justify-between">
                <span>Tạm tính:</span>
                <span id="drawerSubTotal" class="font-bold text-slate-900">0 đ</span>
            </div>
            <div id="drawerDiscountRow" class="flex justify-between text-emerald-600 hidden">
                <span>Giảm giá:</span>
                <span id="drawerDiscountAmount" class="font-bold">-0 đ</span>
            </div>
            <div class="flex justify-between text-sm pt-2 border-t border-slate-200">
                <strong class="text-slate-900">Tổng thanh toán:</strong>
                <strong id="drawerFinalTotal" class="text-base text-blue-600 font-extrabold">0 đ</strong>
            </div>
        </div>

        <!-- Nút Điều hướng sang Trang Checkout -->
        <a href="/checkout" class="w-full py-3 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-sm rounded-xl flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all">
            <span>Tiến Hành Đặt Hàng</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
    </div>
</div>
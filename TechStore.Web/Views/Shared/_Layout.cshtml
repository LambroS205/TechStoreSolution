    </button>

    <!-- Server Toast Trigger if TempData present -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="techstore-server-toast" data-type="success" data-message="@TempData["SuccessMessage"]" class="hidden"></div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div id="techstore-server-toast" data-type="error" data-message="@TempData["ErrorMessage"]" class="hidden"></div>
    }

    <!-- Scripts -->
    <script src="~/js/toast.js"></script>
    <script src="~/js/cart_drawer.js"></script>
    <script src="~/js/search_suggest.js"></script>
    <script src="~/js/modules/compare.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        // Load initial Wishlist badge count & highlight cards
        (async function() {
            try {
                const res = await fetch('/api/wishlist/count');
                if (res.ok) {
                    const data = await res.json();
                    const badge = document.getElementById('headerWishlistCount');
                    if (badge && data.count > 0) {
                        badge.innerText = data.count;
                        badge.classList.remove('hidden');
                    }
                }

                // Highlight wishlisted products
                const idsRes = await fetch('/api/wishlist/ids');
                if (idsRes.ok) {
                    const ids = await idsRes.json();
                    if (Array.isArray(ids)) {
                        ids.forEach(id => {
                            document.querySelectorAll(`[data-wishlist-product-id="${id}"]`).forEach(btn => {
                                btn.classList.add('text-rose-600', 'bg-rose-50');
                                btn.classList.remove('text-slate-400');
                                const svg = btn.querySelector('svg');
                                if (svg) svg.setAttribute('fill', 'currentColor');
                            });
                        });
                    }
                }
            } catch(e) {}
        })();

        // Global Wishlist card toggle
        async function toggleCardWishlist(productId, btn) {
            try {
                const res = await fetch(`/api/wishlist/toggle?productId=${productId}`, { method: 'POST' });
                if (res.status === 401) {
                    if (window.showToast) showToast('Vui lòng đăng nhập để lưu sản phẩm yêu thích!', 'warning');
                    else alert('Vui lòng đăng nhập để lưu sản phẩm yêu thích!');
                    return;
                }
                const data = await res.json();
                if (data.success) {
                    const buttons = document.querySelectorAll(`[data-wishlist-product-id="${productId}"]`);
                    buttons.forEach(b => {
                        const svg = b.querySelector('svg');
                        if (data.isWishlisted) {
                            b.classList.add('text-rose-600', 'bg-rose-50');
                            b.classList.remove('text-slate-400');
                            if (svg) svg.setAttribute('fill', 'currentColor');
                        } else {
                            b.classList.remove('text-rose-600', 'bg-rose-50');
                            b.classList.add('text-slate-400');
                            if (svg) svg.setAttribute('fill', 'none');
                        }
                    });

                    const badge = document.getElementById('headerWishlistCount');
                    if (badge) {
                        badge.innerText = data.count;
                        badge.classList.toggle('hidden', data.count === 0);
                    }
                    if (window.showToast) showToast(data.message, data.isWishlisted ? 'success' : 'info');
                }
            } catch(e) {
                console.error('Wishlist error:', e);
            }
        }

        // Smart Finder Form Handler
        function handleSmartFinderSubmit(e) {
            e.preventDefault();
            const form = e.target;
            const need = form.finder_need.value;
            const budget = form.finder_budget.value;
            const brand = document.getElementById('finder_brand').value;

            let [minPrice, maxPrice] = budget.split('-');
            const params = new URLSearchParams();
            if (minPrice && minPrice !== '0') params.set('minPrice', minPrice);
            if (maxPrice && maxPrice !== '999999999') params.set('maxPrice', maxPrice);
            if (brand) params.set('brand', brand);
            if (need === 'laptop') params.set('category', 'laptop');
            else if (need === 'smartphone') params.set('category', 'dien-thoai');
            else if (need === 'tablet') params.set('category', 'may-tinh-bang');
            else if (need === 'gaming') params.set('q', 'gaming');

            window.location.href = `/products?${params.toString()}`;
        }

        // Light dismiss for native dialog elements
        document.querySelectorAll('dialog').forEach(dialog => {
            dialog.addEventListener('click', (e) => {
                if (e.target === dialog) dialog.close();
            });
        });
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Guest to Authenticated Cart Synchronization -->
        <script>
            (async function syncGuestCartOnLogin() {
                try {
                    const raw = localStorage.getItem('techstore_cart');
                    if (raw) {
                        const items = JSON.parse(raw);
                        if (Array.isArray(items) && items.length > 0) {
                            const res = await fetch('/api/cart/sync-local-storage', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ items: items.map(i => ({ productVariantId: i.variantId, quantity: i.quantity })) })
                            });
                            if (res.ok) {
                                if (window.showToast) {
                                    showToast('Giỏ hàng đã được đồng bộ với tài khoản của bạn!', 'info');
                                }
                            }
                        }
                    }
                } catch(e) {
                    console.error('Cart sync error:', e);
                }
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
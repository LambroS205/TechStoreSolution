@inject TechStore.Core.Interfaces.ISiteSettingsService SiteSettingsService
@{
    var siteSettings = await SiteSettingsService.GetAllSettingsAsync();
    var siteName = siteSettings.GetValueOrDefault("General.SiteName", "TechStore - Siêu Thị Công Nghệ Chính Hãng");
    var siteHotline = siteSettings.GetValueOrDefault("General.Hotline", "1800 6868");
    var logoUrl = siteSettings.GetValueOrDefault("Brand.LogoUrl", "");
    var faviconUrl = siteSettings.GetValueOrDefault("Brand.FaviconUrl", "/favicon.ico");
    var primaryColor = siteSettings.GetValueOrDefault("Theme.PrimaryColor", "#0046be");
    var secondaryColor = siteSettings.GetValueOrDefault("Theme.SecondaryColor", "#002e7a");
    var accentColor = siteSettings.GetValueOrDefault("Theme.AccentColor", "#fff200");
    var footerAbout = siteSettings.GetValueOrDefault("Footer.AboutText", "Hệ thống bán lẻ thiết bị công nghệ chính hãng hàng đầu theo tiêu chuẩn chuỗi cửa hàng Best Buy. Cam kết 100% thiết bị mới, bảo hành chính hãng.");
    var footerCopyright = siteSettings.GetValueOrDefault("Footer.Copyright", $"© {DateTime.UtcNow.Year} TechStore Electronics. Mọi quyền được bảo lưu.");
    var facebookUrl = siteSettings.GetValueOrDefault("Footer.FacebookUrl", "https://facebook.com");
    var youtubeUrl = siteSettings.GetValueOrDefault("Footer.YoutubeUrl", "https://youtube.com");
    var tiktokUrl = siteSettings.GetValueOrDefault("Footer.TiktokUrl", "https://tiktok.com");
    var customCss = siteSettings.GetValueOrDefault("CustomCss.Code", "");
    var customHeaderHtml = siteSettings.GetValueOrDefault("CustomCss.CustomHeaderHtml", "");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link rel="icon" type="image/x-icon" href="@(string.IsNullOrEmpty(faviconUrl) ? "/favicon.ico" : faviconUrl)" />

    <!-- SEO & Metadata -->
    <meta name="description" content="@(ViewData["MetaDescription"] ?? footerAbout)" />
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "điện thoại, laptop, linh kiện, phụ kiện công nghệ chính hãng, apple, samsung, techstore")" />
    <meta name="author" content="@siteName" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:title" content="@ViewData["Title"] - @siteName" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? footerAbout)" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/og-banner.jpg")" />
    <meta property="og:site_name" content="@siteName" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - @siteName" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? footerAbout)" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/og-banner.jpg")" />

    @await RenderSectionAsync("StructuredData", required: false)

    <!-- Tailwind CSS CDN & Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&subset=vietnamese,latin,latin-ext&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bestbuy: {
                            blue: '@primaryColor',
                            darkblue: '@secondaryColor',
                            yellow: '@accentColor',
                            gray: '#f0f2f5'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'Helvetica', 'Arial', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --primary-color: @primaryColor;
            --secondary-color: @secondaryColor;
            --accent-color: @accentColor;
        }
        body { 
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        @Html.Raw(customCss)
    </style>
    @if (!string.IsNullOrWhiteSpace(customHeaderHtml))
    {
        @Html.Raw(customHeaderHtml)
    }
</head>
<body class="bg-[#f4f6f9] text-slate-800 antialiased min-h-screen flex flex-col justify-between">
    <!-- Top Announcement Bar -->
    <div class="bg-bestbuy-darkblue text-white text-xs py-1.5 px-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Hàng chính hãng 100% bảo hành toàn quốc
                </span>
                <span class="hidden md:inline text-slate-300">|</span>
                <span class="hidden md:inline text-slate-300">Giao nhanh miễn phí đơn từ 1.000.000đ</span>
            </div>
            <div class="flex items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="relative group">
                        <button class="flex items-center gap-1.5 hover:text-bestbuy-yellow transition-colors font-medium py-1">
                            <span class="w-5 h-5 rounded-full bg-bestbuy-blue border border-blue-400 text-bestbuy-yellow flex items-center justify-center text-[10px] font-black">
                                @((User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "U").Substring(0, 1).ToUpper())
                            </span>
                            <span>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                            <svg class="w-3 h-3 text-slate-300 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </button>
                        <div class="absolute right-0 top-full mt-1 w-48 bg-white text-slate-800 rounded-2xl shadow-xl border border-slate-200 py-1.5 hidden group-hover:block z-50 divide-y divide-slate-100">
                            <div class="px-3.5 py-2">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Tài khoản</p>
                                <p class="text-xs font-bold text-slate-900 truncate">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</p>
                            </div>
                            <div class="py-1">
                                <a href="/account/profile" class="flex items-center gap-2.5 px-3.5 py-2 text-xs text-slate-700 hover:text-blue-600 hover:bg-slate-50 font-medium">
                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                    <span>Hồ sơ cá nhân</span>
                                </a>
                                <a href="/account/orders" class="flex items-center gap-2.5 px-3.5 py-2 text-xs text-slate-700 hover:text-blue-600 hover:bg-slate-50 font-medium">
                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                                    <span>Đơn hàng của tôi</span>
                                </a>
                                <a href="/account/wishlist" class="flex items-center gap-2.5 px-3.5 py-2 text-xs text-slate-700 hover:text-rose-600 hover:bg-slate-50 font-medium">
                                    <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                                    <span>Sản phẩm yêu thích</span>
                                </a>
                                <a href="/account/addresses" class="flex items-center gap-2.5 px-3.5 py-2 text-xs text-slate-700 hover:text-blue-600 hover:bg-slate-50 font-medium">
                                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                    <span>Sổ địa chỉ nhận hàng</span>
                                </a>
                            </div>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("StaffProduct") || User.IsInRole("StaffOrder") || User.IsInRole("StaffMarketing"))
                            {
                                <div class="py-1">
                                    <a href="/Admin/Dashboard" class="flex items-center gap-2.5 px-3.5 py-2 text-xs text-blue-600 hover:bg-blue-50 font-bold">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                        <span>Kênh Quản Trị</span>
                                    </a>
                                </div>
                            }
                            <div class="py-1">
                                <a href="/auth/logout" class="flex items-center gap-2.5 px-3.5 py-2 text-xs text-rose-600 hover:bg-rose-50 font-bold">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/auth/login" class="hover:text-bestbuy-yellow transition-colors font-semibold">Đăng Nhập</a>
                    <span class="text-slate-400">/</span>
                    <a href="/auth/register" class="hover:text-bestbuy-yellow transition-colors font-semibold">Đăng Ký</a>
                }
                <span class="hidden sm:inline text-slate-300">|</span>
                <a href="/about" class="hover:text-slate-200 transition-colors">Về TechStore</a>
                <a href="/contact" class="hover:text-slate-200 transition-colors">Liên Hệ</a>
            </div>
        </div>
    </div>

    <!-- Main Best Buy Style Header -->
    <header class="bg-bestbuy-blue text-white sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2 shrink-0 group">
                @if (!string.IsNullOrWhiteSpace(logoUrl))
                {
                    <img src="@logoUrl" alt="@siteName" class="h-10 w-auto object-contain group-hover:scale-105 transition-transform" />
                }
                else
                {
                    <div class="w-10 h-10 rounded-xl bg-bestbuy-yellow text-slate-900 flex items-center justify-center font-black text-xl shadow-sm group-hover:scale-105 transition-transform">
                        T
                    </div>
                    <div>
                        <span class="text-2xl font-black tracking-tight block leading-none text-white">TechStore</span>
                        <span class="text-[10px] font-bold text-bestbuy-yellow uppercase tracking-widest block mt-0.5">Electronics</span>
                    </div>
                }
            </a>

            <!-- Search Bar with Live Autocomplete -->
            <div class="flex-1 max-w-2xl relative hidden sm:block">
                <form action="/products" method="get" class="relative">
                    <input type="text" id="headerSearchInput" name="q" value="@ViewBag.SearchQuery" 
                           placeholder="Tìm iPhone 16 Pro Max, MacBook M4, Galaxy S25..." 
                           autocomplete="off"
                           class="w-full bg-white text-slate-900 text-sm rounded-full pl-5 pr-12 py-2.5 outline-none focus:ring-2 focus:ring-bestbuy-yellow placeholder-slate-400 font-medium shadow-inner" />
                    <button type="submit" class="absolute right-1.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-bestbuy-blue text-white flex items-center justify-center hover:bg-bestbuy-darkblue transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </button>
                </form>

                <!-- Search Suggestions Dropdown -->
                <div id="headerSearchSuggestions" class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden hidden z-50 divide-y divide-slate-100 max-h-96 overflow-y-auto">
                    <!-- Rendered via JS -->
                </div>
            </div>

            <!-- Actions: Hotline & Cart Drawer Toggle Button -->
            <div class="flex items-center gap-3 shrink-0">
                <div class="hidden lg:flex items-center gap-2 pr-2 border-r border-blue-400/40 text-xs">
                    <span class="p-2 bg-blue-700/60 rounded-full">
                        <svg class="w-4 h-4 text-bestbuy-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    </span>
                    <div>
                        <p class="text-[11px] text-blue-200">Hotline tư vấn</p>
                        <strong class="font-bold text-sm">1800 6868</strong>
                    </div>
                </div>

                <!-- Nút Danh Sách Yêu Thích -->
                <a href="/account/wishlist" class="relative p-2 text-white hover:text-bestbuy-yellow hover:bg-blue-700/60 rounded-xl transition-colors flex items-center justify-center" title="Sản phẩm yêu thích">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                    <span id="headerWishlistCount" class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-rose-500 text-white text-[10px] flex items-center justify-center font-bold hidden">0</span>
                </a>

                <!-- Nút Giỏ hàng mở Slide-over Drawer -->
                <button onclick="toggleCartDrawer()" class="relative flex items-center gap-2.5 px-4 py-2 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-900 rounded-xl font-bold text-sm shadow-md transition-all active:scale-95">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                    <span class="hidden sm:inline">Giỏ Hàng</span>
                    <span id="cartBadgeCount" class="w-5 h-5 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">0</span>
                </button>
            </div>
        </div>

        <!-- Navigation Categories Bar -->
        <nav class="bg-bestbuy-darkblue/90 border-t border-blue-500/30 text-xs font-semibold">
            <div class="max-w-7xl mx-auto px-4 flex items-center gap-6 overflow-x-auto py-2.5 no-scrollbar">
                <a href="/products" class="text-bestbuy-yellow flex items-center gap-1.5 whitespace-nowrap hover:underline">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <span>Tất Cả Sản Phẩm</span>
                </a>
                <a href="/category/dien-thoai" class="text-white hover:text-bestbuy-yellow transition-colors whitespace-nowrap">Điện Thoại Smartphone</a>
                <a href="/category/laptop" class="text-white hover:text-bestbuy-yellow transition-colors whitespace-nowrap">Laptop & MacBook</a>
                <a href="/category/tablet" class="text-white hover:text-bestbuy-yellow transition-colors whitespace-nowrap">Máy Tính Bảng / iPad</a>
                <a href="/category/am-thanh" class="text-white hover:text-bestbuy-yellow transition-colors whitespace-nowrap">Tai Nghe & Âm Thanh</a>
                <a href="/category/tivi-man-hinh" class="text-white hover:text-bestbuy-yellow transition-colors whitespace-nowrap">Tivi & Màn Hình</a>
                <a href="/blogs" class="text-white hover:text-bestbuy-yellow transition-colors whitespace-nowrap flex items-center gap-1.5 ml-auto">
                    <svg class="w-3.5 h-3.5 text-bestbuy-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
                    <span>Tin Công Nghệ</span>
                </a>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- Slide-over Cart Drawer Component -->
    @await Html.PartialAsync("_CartDrawer")

    <!-- Best Buy Footer -->
    <footer class="bg-white border-t border-slate-200 mt-16 text-slate-600 text-sm">
        <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="space-y-3">
                <div class="flex items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                    {
                        <img src="@logoUrl" alt="@siteName" class="h-8 w-auto object-contain" />
                    }
                    else
                    {
                        <div class="w-8 h-8 rounded-lg bg-bestbuy-blue text-bestbuy-yellow flex items-center justify-center font-black">T</div>
                    }
                    <span class="font-extrabold text-slate-900 text-lg">@siteName</span>
                </div>
                <p class="text-xs text-slate-500 leading-relaxed">
                    @footerAbout
                </p>
                <div class="text-xs font-semibold text-slate-700">
                    Hotline: <span class="text-blue-600 font-bold">@siteHotline</span> (Miễn phí)
                </div>
                <div class="flex items-center gap-3 pt-1">
                    @if (!string.IsNullOrWhiteSpace(facebookUrl))
                    {
                        <a href="@facebookUrl" target="_blank" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-500 hover:text-blue-600 flex items-center justify-center transition text-xs font-bold" title="Facebook">f</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(youtubeUrl))
                    {
                        <a href="@youtubeUrl" target="_blank" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-red-50 text-slate-500 hover:text-red-600 flex items-center justify-center transition text-xs font-bold" title="YouTube">▶</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(tiktokUrl))
                    {
                        <a href="@tiktokUrl" target="_blank" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-900 flex items-center justify-center transition text-xs font-bold" title="TikTok">♪</a>
                    }
                </div>
            </div>

            <div>
                <h4 class="font-bold text-slate-900 mb-3 text-xs uppercase tracking-wider">Hỗ Trợ Khách Hàng</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="/checkout" class="hover:text-blue-600">Hướng dẫn thanh toán VietQR</a></li>
                    <li><a href="/compare" class="hover:text-blue-600">So sánh sản phẩm</a></li>
                    <li><a href="#" class="hover:text-blue-600">Chính sách giao hàng toàn quốc</a></li>
                    <li><a href="#" class="hover:text-blue-600">Quy chế đổi trả 30 ngày</a></li>
                    <li><a href="#" class="hover:text-blue-600">Tra cứu bảo hành điện tử</a></li>
                </ul>
            </div>

            <div>
                <h4 class="font-bold text-slate-900 mb-3 text-xs uppercase tracking-wider">Danh Mục Nổi Bật</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="/category/dien-thoai" class="hover:text-blue-600">Apple iPhone 16 Series</a></li>
                    <li><a href="/category/dien-thoai" class="hover:text-blue-600">Samsung Galaxy AI Flagship</a></li>
                    <li><a href="/category/laptop" class="hover:text-blue-600">Apple MacBook M4 Pro</a></li>
                    <li><a href="/category/am-thanh" class="hover:text-blue-600">Tai nghe chống ồn Sony Hi-Res</a></li>
                </ul>
            </div>

            <div class="space-y-3">
                <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Thanh Toán Linh Hoạt</h4>
                <p class="text-xs text-slate-500">Chấp nhận thanh toán khi nhận hàng (COD) và Chuyển khoản tức thì chuẩn VietQR NAPAS 247.</p>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 text-[11px] font-bold bg-slate-100 text-slate-800 rounded border border-slate-200">COD</span>
                    <span class="px-2.5 py-1 text-[11px] font-bold bg-blue-50 text-blue-700 rounded border border-blue-200">VietQR NAPAS</span>
                    <span class="px-2.5 py-1 text-[11px] font-bold bg-emerald-50 text-emerald-700 rounded border border-emerald-200">MBBank</span>
                </div>
            </div>
        </div>
        <div class="bg-slate-50 border-t border-slate-100 py-4 text-center text-xs text-slate-400">
            @footerCopyright
        </div>
    </footer>

    <!-- Floating Product Comparison Bar -->
    <div id="floatingCompareBar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-slate-900/90 backdrop-blur-md text-white rounded-2xl shadow-2xl border border-white/10 px-5 py-3 flex items-center gap-4 transition-all duration-300 transform translate-y-full opacity-0 pointer-events-none">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xs shadow-sm shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
            </div>
            <div>
                <div class="text-xs font-bold flex items-center gap-1.5 whitespace-nowrap">
                    <span>So Sánh Sản Phẩm</span>
                    <span id="compareCountBadge" class="px-1.5 py-0.2 bg-blue-500 text-white rounded-full text-[10px] font-black">0</span>
                </div>
                <p class="text-[10px] text-slate-400">Tối đa 4 sản phẩm</p>
            </div>
        </div>

        <!-- Thumbnails container -->
        <div id="compareThumbnailsContainer" class="flex items-center gap-2"></div>

        <!-- Actions -->
        <div class="flex items-center gap-2 pl-2 border-l border-white/10 shrink-0">
            <button type="button" id="compareActionBtn" onclick="TechStoreCompare.goToComparePage()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-md transition active:scale-95 flex items-center gap-1.5 whitespace-nowrap">
                <span>So Sánh Ngay</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </button>
            <button type="button" onclick="TechStoreCompare.clearAll()" title="Xóa tất cả" class="p-2 hover:bg-white/10 text-slate-400 hover:text-rose-400 rounded-xl transition text-xs font-bold">
                ✕
            </button>
        </div>
    </div>

    <!-- Server Toast Trigger if TempData present -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="techstore-server-toast" data-type="success" data-message="@TempData["SuccessMessage"]" class="hidden"></div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div id="techstore-server-toast" data-type="error" data-message="@TempData["ErrorMessage"]" class="hidden"></div>
    }

    <!-- Scripts -->
    <script src="~/js/toast.js"></script>
    <script src="~/js/cart_drawer.js"></script>
    <script src="~/js/search_suggest.js"></script>
    <script src="~/js/modules/compare.js"></script>
    <script>
        // Load initial Wishlist badge count
        (async function() {
            try {
                const res = await fetch('/api/wishlist/count');
                if (res.ok) {
                    const data = await res.json();
                    const badge = document.getElementById('headerWishlistCount');
                    if (badge && data.count > 0) {
                        badge.innerText = data.count;
                        badge.classList.remove('hidden');
                    }
                }
            } catch(e) {}
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model TechStore.Web.Models.ErrorViewModel
@using TechStore.Web.Security
@{
    int status = Model?.StatusCode ?? 500;
    ViewData["Title"] = status == 405 ? "Phương Thức Không Hợp Lệ (405)" : "Đã Xảy Ra Lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isStaff = User.IsStaffOrAdmin();
}

<div class="max-w-xl mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8 sm:p-12 space-y-6">
        <!-- Visual Icon -->
        <div class="w-16 h-16 mx-auto rounded-3xl @(status == 405 ? "bg-amber-50 border border-amber-200 text-amber-600" : "bg-rose-50 border border-rose-200 text-rose-600") flex items-center justify-center font-black text-3xl shadow-xs">
            @(status == 405 ? "🔄" : "⚠️")
        </div>

        <div class="space-y-2">
            <span class="px-3 py-1 @(status == 405 ? "bg-amber-100 text-amber-800" : "bg-rose-100 text-rose-800") text-xs font-bold rounded-full uppercase tracking-wider">
                Mã lỗi: @status
            </span>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">
                @(status == 405 ? "Phương Thức Truy Cập Không Hợp Lệ" : "Đã xảy ra sự cố không mong muốn")
            </h1>
            <p class="text-sm text-slate-500">
                @(Model?.Message ?? (status == 405 
                    ? "Yêu cầu vừa thực hiện không đúng phương thức cho phép (ví dụ: làm mới trang trình duyệt sau khi gửi biểu mẫu). Dữ liệu của bạn hoàn toàn an toàn."
                    : "Hệ thống gặp sự cố trong quá trình xử lý yêu cầu của bạn. Đội ngũ kỹ thuật đã được thông báo và đang khắc phục."))
            </p>
        </div>

        @if (Model?.ShowRequestId == true)
        {
            <div class="p-3 bg-slate-50 rounded-xl text-left border border-slate-200">
                <p class="text-xs text-slate-400 font-mono">
                    <span class="font-bold text-slate-600">Mã yêu cầu (Request ID):</span> @Model.RequestId
                </p>
            </div>
        }

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
            <button onclick="window.history.back()" class="w-full sm:w-auto px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition-all shadow-md">
                ⬅️ Quay Lại Trang Trước
            </button>
            <a href="/" class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-all">
                🏠 Về Trang Chủ
            </a>
            @if (isStaff)
            {
                <a href="/Admin" class="w-full sm:w-auto px-6 py-3 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-xl transition-all shadow-md">
                    🏢 Về Bàn Làm Việc ERP
                </a>
            }
        </div>

        <div class="text-xs text-slate-400 pt-2 border-t border-slate-100">
            Nếu lỗi tiếp tục lặp lại, vui lòng liên hệ <a href="mailto:support@techstore.vn" class="font-bold text-bestbuy-blue hover:underline">support@techstore.vn</a> hoặc hotline <a href="tel:18006868" class="font-bold text-bestbuy-blue hover:underline">1800 6868</a>.
        </div>
    </div>
</div>

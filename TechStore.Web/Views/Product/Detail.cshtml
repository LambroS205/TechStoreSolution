@model ProductDetailViewModel
@using System.Text.Json
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["MetaDescription"] = !string.IsNullOrWhiteSpace(product.ShortDescription) ? product.ShortDescription : $"{product.Name} chính hãng giá tốt, bảo hành chính hãng tại TechStore.";
    ViewData["OgImage"] = product.FeaturedImage;
    ViewData["OgType"] = "product";
    ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}/product/{product.Slug}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var variants = product.Variants.Where(v => v.IsActive).ToList();
    var defaultVariant = variants.FirstOrDefault();
    var reviews = Model.Reviews;
    double avgRating = Model.AverageRating;
    int totalReviews = Model.TotalReviews;
    int count5 = Model.Count5;
    int count4 = Model.Count4;
    int count3 = Model.Count3;
    int count2 = Model.Count2;
    int count1 = Model.Count1;
    bool hasPurchased = Model.HasPurchased;
    bool hasReviewed = Model.HasReviewed;

    // Parse hardware specifications JSON
    var specsList = new List<KeyValuePair<string, string>>();
    if (!string.IsNullOrEmpty(product.SpecificationsJson))
    {
        try
        {
            var doc = JsonDocument.Parse(product.SpecificationsJson);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                specsList.Add(new KeyValuePair<string, string>(prop.Name, prop.Value.GetString() ?? ""));
            }
        }
        catch {}
    }
}

@section StructuredData {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "Product",
      "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.Name)),
      "image": "@product.FeaturedImage",
      "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrWhiteSpace(product.ShortDescription) ? product.Name : product.ShortDescription)),
      "sku": "PROD-@product.ProductId",
      "brand": {
        "@@type": "Brand",
        "name": "@(product.Brand?.Name ?? "TechStore")"
      },
      "offers": {
        "@@type": "Offer",
        "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/product/{product.Slug}")",
        "priceCurrency": "VND",
        "price": "@(defaultVariant?.SalePrice ?? 0)",
        "availability": "@(defaultVariant?.StockQuantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")",
        "itemCondition": "https://schema.org/NewCondition"
      }
      @if (totalReviews > 0)
      {
        <text>,
        "aggregateRating": {
          "@@type": "AggregateRating",
          "ratingValue": "@avgRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)",
          "reviewCount": "@totalReviews"
        }
        </text>
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "Trang chủ",
          "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}")"
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "name": "@product.Category.Name",
          "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/category/{product.Category.Slug}")"
        },
        {
          "@@type": "ListItem",
          "position": 3,
          "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.Name)),
          "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/product/{product.Slug}")"
        }
      ]
    }
    </script>
}

<div class="max-w-7xl mx-auto px-4 py-6 space-y-8">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <a href="/" class="hover:text-blue-600">Trang chủ</a>
        <span>/</span>
        <a href="/category/@product.Category.Slug" class="hover:text-blue-600">@product.Category.Name</a>
        <span>/</span>
        <span class="text-slate-800 font-bold truncate">@product.Name</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold rounded-2xl flex items-center gap-2 shadow-xs">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold rounded-2xl flex items-center gap-2 shadow-xs">
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Product Main Info Section -->
    <div id="mainProductCard" class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left: Image Gallery & Thumbnail Slider -->
        <div class="space-y-4">
            <div class="flex flex-col items-center justify-center p-6 bg-slate-50 rounded-2xl border border-slate-100 relative overflow-hidden group">
                <img id="mainProductImage" src="@product.FeaturedImage" alt="@product.Name" class="max-h-96 w-auto object-contain transition-transform duration-300 group-hover:scale-105" onerror="this.src='/assets/images/placeholder.png'" />
                <span class="absolute top-4 left-4 px-3 py-1 text-xs font-black bg-[#0046be] text-white rounded-lg shadow-sm">
                    Chính Hãng 100%
                </span>
            </div>

            <!-- Thumbnail Strip -->
            @if (product.Images != null && product.Images.Any())
            {
                <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin">
                    <button type="button" onclick="switchGalleryImage('@product.FeaturedImage', this)" 
                            class="gallery-thumb w-16 h-16 rounded-xl border-2 border-[#0046be] p-1 bg-white hover:opacity-90 shrink-0 transition shadow-xs focus:outline-none">
                        <img src="@product.FeaturedImage" alt="Main Thumbnail" class="w-full h-full object-contain rounded-lg" onerror="this.src='/assets/images/placeholder.png'" />
                    </button>

                    @foreach (var img in product.Images.OrderBy(i => i.DisplayOrder))
                    {
                        <button type="button" onclick="switchGalleryImage('@img.ImageUrl', this)" 
                                class="gallery-thumb w-16 h-16 rounded-xl border-2 border-slate-200 p-1 bg-white hover:border-[#0046be] shrink-0 transition shadow-xs focus:outline-none">
                            <img src="@img.ImageUrl" alt="Gallery Thumbnail" class="w-full h-full object-contain rounded-lg" onerror="this.src='/assets/images/placeholder.png'" />
                        </button>
                    }
                </div>
            }

            <!-- 4 Service Guarantees (Trust Badges) -->
            <div class="grid grid-cols-2 gap-2 text-[11px] pt-2">
                <div class="flex items-center gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-blue-600 font-bold">🛡️</span>
                    <span class="text-slate-700 font-medium">Bảo hành 12 tháng chính hãng</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-amber-500 font-bold">🔄</span>
                    <span class="text-slate-700 font-medium">1 đổi 1 trong 30 ngày nếu lỗi</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-emerald-600 font-bold">🚚</span>
                    <span class="text-slate-700 font-medium">Miễn phí giao hàng toàn quốc</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-purple-600 font-bold">📦</span>
                    <span class="text-slate-700 font-medium">Đồng kiểm khi nhận hàng</span>
                </div>
            </div>
        </div>

        <!-- Right: Configurations & Variant Selection -->
        <div class="space-y-5 flex flex-col justify-between">
            <div class="space-y-3">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="px-2.5 py-0.5 text-xs font-bold bg-slate-100 text-slate-700 rounded-md border border-slate-200">
                        @product.Brand.Name
                    </span>
                    <span class="text-xs text-slate-400">Mã SP: #@product.ProductId</span>
                    <span id="variantSkuDisplay" class="text-xs font-mono font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">SKU: @defaultVariant?.SKU</span>
                </div>

                <h1 class="text-2xl lg:text-3xl font-black text-slate-900 leading-tight">@product.Name</h1>

                <!-- Đánh giá sao & Đã bán -->
                <div class="flex items-center gap-3 pt-0.5 text-xs">
                    <div class="flex items-center text-amber-400">
                        @for (int s = 1; s <= 5; s++)
                        {
                            if (s <= Math.Round(avgRating))
                            {
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4 text-slate-200 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                            }
                        }
                    </div>
                    <span class="font-bold text-slate-900">@avgRating</span>
                    <span class="text-slate-300">|</span>
                    <a href="#reviewsSection" class="text-blue-600 hover:underline font-semibold">@totalReviews đánh giá</a>
                    <span class="text-slate-300">|</span>
                    <span class="text-emerald-600 font-semibold flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        Đã bán 250+
                    </span>
                </div>

                <p class="text-xs text-slate-500 leading-relaxed">@product.ShortDescription</p>

                <!-- Giá bán thay đổi thời gian thực -->
                <div class="p-4 bg-blue-50/60 rounded-2xl border border-blue-100 flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-baseline gap-3">
                        <span id="variantPrice" class="text-2xl sm:text-3xl font-black text-blue-600">
                            @((defaultVariant?.SalePrice ?? 0).ToString("N0")) đ
                        </span>
                        <span id="variantOriginalPrice" class="text-sm text-slate-400 line-through">
                            @((defaultVariant?.OriginalPrice ?? 0).ToString("N0")) đ
                        </span>
                    </div>

                    <!-- 0% Installment Calculator Trigger -->
                    <button type="button" onclick="openInstallmentModal()" class="text-xs font-bold text-blue-600 hover:text-blue-800 underline flex items-center gap-1">
                        <span>Trả góp 0% chỉ từ</span>
                        <strong id="installmentMonthlyPreview" class="text-slate-900">@((((defaultVariant?.SalePrice ?? 0) / 12)).ToString("N0"))đ/th</strong>
                    </button>
                </div>

                <!-- Danh sách biến thể (Màu sắc, Dung lượng, RAM) -->
                @if (variants.Any())
                {
                    <div class="space-y-2 pt-2">
                        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
                            Chọn Phiên Bản & Cấu Hình:
                        </label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            @foreach (var v in variants)
                            {
                                <button type="button" 
                                        onclick="selectVariant(@v.VariantId, '@v.VariantName', @v.SalePrice, @v.OriginalPrice, @v.StockQuantity, '@(string.IsNullOrEmpty(v.ThumbnailImage) ? product.FeaturedImage : v.ThumbnailImage)', '@v.SKU')"
                                        id="variantBtn_@v.VariantId"
                                        class="variant-btn p-3 text-left border rounded-xl transition-all @(v.VariantId == defaultVariant?.VariantId ? "border-blue-600 bg-blue-50/50 ring-2 ring-blue-500/20" : "border-slate-200 hover:border-slate-300 bg-white")">
                                    <div class="font-bold text-xs text-slate-900">@v.VariantName</div>
                                    <div class="text-xs font-extrabold text-blue-600 mt-0.5">@v.SalePrice.ToString("N0") đ</div>
                                    <div class="text-[10px] text-slate-400">Kho: @v.StockQuantity</div>
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Chọn số lượng & Trạng thái tồn kho -->
                <div class="flex items-center justify-between pt-2">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-slate-700">Số lượng:</span>
                        <div class="flex items-center border border-slate-300 rounded-xl overflow-hidden bg-slate-50">
                            <button type="button" onclick="adjustPdpQuantity(-1)" class="px-3 py-1 text-sm font-bold text-slate-600 hover:bg-slate-200 transition">-</button>
                            <input type="number" id="pdpQuantityInput" value="1" min="1" max="@(defaultVariant?.StockQuantity ?? 50)" class="w-12 text-center text-xs font-bold bg-white outline-none border-x border-slate-200 py-1" readonly />
                            <button type="button" onclick="adjustPdpQuantity(1)" class="px-3 py-1 text-sm font-bold text-slate-600 hover:bg-slate-200 transition">+</button>
                        </div>
                    </div>
                    <div class="text-xs font-semibold flex items-center gap-1.5">
                        <span id="stockStatus" class="@(defaultVariant != null && defaultVariant.StockQuantity > 0 ? "text-emerald-600" : "text-rose-600") font-bold">
                            @(defaultVariant != null && defaultVariant.StockQuantity > 0 ? $"Còn hàng ({defaultVariant.StockQuantity} sản phẩm)" : "Hết hàng")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Nút Mua Ngay, Thêm Giỏ Hàng & Yêu Thích -->
            <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
                <input type="hidden" id="selectedVariantId" value="@(defaultVariant?.VariantId ?? 0)" />
                <input type="hidden" id="selectedVariantStock" value="@(defaultVariant?.StockQuantity ?? 0)" />
                <input type="hidden" id="selectedVariantPrice" value="@(defaultVariant?.SalePrice ?? 0)" />

                <button type="button" id="pdpBuyNowBtn" onclick="handleAddCurrentToCart(true)" class="flex-1 py-3.5 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-sm rounded-xl shadow-md active:scale-95 transition-all text-center @(defaultVariant?.StockQuantity == 0 ? "opacity-50 pointer-events-none" : "")">
                    MUA NGAY (GIAO TẬN NƠI)
                </button>
                <button type="button" id="pdpAddToCartBtn" onclick="handleAddCurrentToCart(false)" class="px-5 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-md active:scale-95 transition-all flex items-center justify-center gap-2 @(defaultVariant?.StockQuantity == 0 ? "opacity-50 pointer-events-none" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                    <span class="hidden sm:inline">Thêm Vào Giỏ</span>
                </button>
                <!-- Nút Yêu thích (Wishlist) -->
                <button type="button" onclick="toggleWishlist(@product.ProductId, this)" 
                        id="wishlistBtn_@product.ProductId"
                        class="p-3.5 bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-500 rounded-xl transition-all flex items-center justify-center shadow-xs" 
                        title="Thêm vào danh sách yêu thích">
                    <svg class="w-5 h-5 transition-transform active:scale-125" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                </button>
                <!-- Nút So Sánh (Compare) -->
                <button type="button" 
                        onclick="TechStoreCompare.toggleFromButton(this)" 
                        id="compareBtn_@product.ProductId"
                        data-product-id="@product.ProductId"
                        data-product-name="@product.Name"
                        data-product-slug="@product.Slug"
                        data-product-price="@(defaultVariant?.SalePrice ?? 0)"
                        data-product-orig-price="@(defaultVariant?.OriginalPrice ?? 0)"
                        data-product-image="@product.FeaturedImage"
                        data-product-brand="@product.Brand.Name"
                        data-product-category="@product.Category.Name"
                        class="compare-toggle-btn p-3.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-500 rounded-xl transition-all flex items-center justify-center shadow-xs" 
                        title="So sánh với sản phẩm khác">
                    <svg class="w-5 h-5 transition-transform active:scale-125" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- 2-Column: Left = Bài viết mô tả & FAQ, Right = Bảng thông số kỹ thuật (Best Buy / CellphoneS style) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <!-- Left (2 cols): Mô tả chi tiết & Câu hỏi thường gặp -->
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-8 space-y-4">
                <h3 class="text-lg font-black text-slate-900 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <span class="w-2.5 h-5 bg-blue-600 rounded-sm"></span>
                    <span>Đặc Điểm Nổi Bật & Trải Nghiệm Thực Tế</span>
                </h3>
                <div class="prose max-w-none text-slate-700 text-sm leading-relaxed">
                    @Html.Raw(product.FullDescription ?? product.ShortDescription)
                </div>
            </div>

            <!-- FAQ Accordion (Modern Web Pattern: <details name="pdp-faq">) -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-8 space-y-4">
                <h3 class="text-base font-black text-slate-900 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <span class="text-blue-600">❓</span>
                    <span>Câu Hỏi Thường Gặp Về @product.Name</span>
                </h3>
                <div class="space-y-3">
                    <details name="pdp-faq" class="p-4 bg-slate-50 rounded-2xl border border-slate-200 group cursor-pointer" open>
                        <summary class="font-bold text-xs sm:text-sm text-slate-900 list-none flex items-center justify-between">
                            <span>Sản phẩm có đầy đủ phụ kiện và nguyên seal chính hãng không?</span>
                            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-xs text-slate-600 mt-2.5 leading-relaxed">
                            Có, TechStore cam kết 100% sản phẩm phân phối là máy mới nguyên hộp (Brand New in Box), nguyên seal từ nhà sản xuất, khách hàng được quyền mở hộp đồng kiểm trước khi nhận.
                        </p>
                    </details>
                    <details name="pdp-faq" class="p-4 bg-slate-50 rounded-2xl border border-slate-200 group cursor-pointer">
                        <summary class="font-bold text-xs sm:text-sm text-slate-900 list-none flex items-center justify-between">
                            <span>Chính sách bảo hành và đổi trả như thế nào?</span>
                            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-xs text-slate-600 mt-2.5 leading-relaxed">
                            Sản phẩm được bảo hành chính hãng 12 tháng tại các Trung tâm Bảo hành Ủy quyền trên toàn quốc. Đổi mới 1:1 trong 30 ngày nếu phát sinh lỗi từ nhà sản xuất.
                        </p>
                    </details>
                    <details name="pdp-faq" class="p-4 bg-slate-50 rounded-2xl border border-slate-200 group cursor-pointer">
                        <summary class="font-bold text-xs sm:text-sm text-slate-900 list-none flex items-center justify-between">
                            <span>Thời gian giao hàng mất bao lâu?</span>
                            <span class="text-blue-600 group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-xs text-slate-600 mt-2.5 leading-relaxed">
                            Tại Hà Nội và TP.HCM, TechStore hỗ trợ giao hàng hỏa tốc trong 2 giờ. Các tỉnh thành khác sẽ nhận hàng từ 1-3 ngày làm việc thông qua Viettel Post hoặc GHTK.
                        </p>
                    </details>
                </div>
            </div>
        </div>

        <!-- Right (1 col): Bảng Thông Số Kỹ Thuật Tóm Tắt & Nút Xem Full Specs Modal -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-4 sticky top-20">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider flex items-center gap-1.5">
                    <span class="text-blue-600">⚙️</span>
                    <span>Thông Số Kỹ Thuật</span>
                </h3>
            </div>

            @if (specsList.Any())
            {
                <div class="divide-y divide-slate-100 text-xs">
                    @foreach (var s in specsList.Take(7))
                    {
                        <div class="py-2.5 flex justify-between gap-3">
                            <span class="text-slate-400 font-medium shrink-0">@s.Key</span>
                            <strong class="text-slate-800 text-right">@s.Value</strong>
                        </div>
                    }
                </div>

                <button type="button" onclick="document.getElementById('fullSpecsModal').showModal()" class="w-full py-2.5 bg-blue-50 hover:bg-blue-100 text-blue-600 font-bold text-xs rounded-xl transition text-center shadow-xs">
                    Xem Cấu Hình Chi Tiết ➔
                </button>
            }
            else
            {
                <p class="text-xs text-slate-400">Đang cập nhật thông số chi tiết.</p>
            }
        </div>
    </div>

    <!-- Phân Hệ Đánh Giá & Nhận Xét Sản Phẩm (Reviews & Ratings) -->
    <div id="reviewsSection" class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-8 space-y-8">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-xl font-black text-slate-900">Đánh Giá & Nhận Xét Khách Hàng</h3>
                <p class="text-xs text-slate-400 mt-0.5">Ý kiến đóng góp thực tế từ những người đã sở hữu sản phẩm</p>
            </div>
            <div class="hidden sm:flex items-center gap-1.5 text-xs text-emerald-600 font-bold bg-emerald-50 px-3 py-1.5 rounded-xl">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                <span>100% Đánh Giá Xác Thực</span>
            </div>
        </div>

        <!-- Rating Score Overview & Review Form -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <!-- Left: Rating Card & Percentage Breakdown -->
            <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 space-y-4">
                <div class="text-center space-y-1">
                    <div class="text-4xl font-black text-slate-900">@avgRating<span class="text-lg text-slate-400 font-medium">/5</span></div>
                    <div class="flex items-center justify-center text-amber-400">
                        @for (int s = 1; s <= 5; s++)
                        {
                            if (s <= Math.Round(avgRating))
                            {
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5 text-slate-200 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                            }
                        }
                    </div>
                    <p class="text-xs text-slate-500 font-medium">Dựa trên @totalReviews lượt đánh giá</p>
                </div>

                <!-- Star Bars -->
                <div class="space-y-2 text-xs text-slate-600">
                    @{
                        var starLevels = new[] {
                            (Star: 5, Count: count5),
                            (Star: 4, Count: count4),
                            (Star: 3, Count: count3),
                            (Star: 2, Count: count2),
                            (Star: 1, Count: count1)
                        };
                    }
                    @foreach (var sl in starLevels)
                    {
                        var pct = totalReviews > 0 ? (sl.Count * 100) / totalReviews : 0;
                        <div class="flex items-center gap-2">
                            <span class="w-7 font-bold text-slate-700">@sl.Star ★</span>
                            <div class="flex-1 h-2 bg-slate-200 rounded-full overflow-hidden">
                                <div class="h-full bg-amber-400 rounded-full" style="width: @pct%"></div>
                            </div>
                            <span class="w-8 text-right text-slate-400 font-mono text-[11px]">@sl.Count</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Interactive Review Form (2 columns) -->
            <div class="lg:col-span-2 bg-slate-50 rounded-2xl p-6 border border-slate-100">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <h4 class="font-bold text-slate-900 text-sm mb-3 flex items-center gap-2">
                        <span>Viết Đánh Giá Của Bạn</span>
                        @if (hasPurchased)
                        {
                            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">✓ Đã Mua Thiết Bị Này</span>
                        }
                    </h4>

                    <form action="/product/@product.Slug/review" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <!-- Star Rating Picker -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Mức độ hài lòng của bạn:</label>
                            <div class="flex items-center gap-2" id="starPickerContainer">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <button type="button" onclick="setReviewRating(@i)" class="star-pick text-amber-400 hover:scale-110 transition-transform" data-rating="@i">
                                        <svg class="w-7 h-7 fill-current star-icon" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                    </button>
                                }
                                <span id="ratingDescription" class="text-xs font-bold text-amber-600 ml-2">5/5 - Rất tuyệt vời!</span>
                            </div>
                            <input type="hidden" name="rating" id="reviewRatingInput" value="5" />
                        </div>

                        <!-- Comment textarea -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Nhận xét chi tiết:</label>
                            <textarea name="comment" rows="3" required placeholder="Chia sẻ trải nghiệm về hiệu năng, thiết kế, thời lượng pin, độ hài lòng khi nhận hàng..." class="w-full bg-white text-slate-900 text-xs rounded-xl p-3 border border-slate-200 outline-none focus:ring-2 focus:ring-blue-600"></textarea>
                        </div>

                        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition-all active:scale-95">
                            Gửi Đánh Giá Ngay
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-6 space-y-3">
                        <div class="w-12 h-12 mx-auto rounded-full bg-blue-100 text-blue-600 flex items-center justify-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm">Bạn đã trải nghiệm thiết bị này?</h4>
                        <p class="text-xs text-slate-500 max-w-md mx-auto">Vui lòng đăng nhập tài khoản TechStore để chia sẻ nhận xét và đánh giá trải nghiệm thực tế với cộng đồng.</p>
                        <a href="/auth/login?returnUrl=/product/@product.Slug" class="inline-flex items-center gap-2 px-5 py-2.5 bg-bestbuy-blue text-white font-bold text-xs rounded-xl shadow-md hover:bg-bestbuy-darkblue transition-all">
                            <span>Đăng Nhập Để Viết Đánh Giá</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Reviews List -->
        <div class="space-y-4 pt-4 border-t border-slate-100">
            <h4 class="font-bold text-slate-900 text-sm">Nhận xét từ khách hàng (@reviews.Count)</h4>

            @if (reviews.Any())
            {
                <div class="space-y-4">
                    @foreach (var r in reviews)
                    {
                        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-2 text-xs">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-xs">
                                        @((r.User?.FullName ?? "K").Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <strong class="text-slate-900 font-bold">@(r.User?.FullName ?? "Khách hàng TechStore")</strong>
                                            <span class="text-[10px] text-emerald-700 font-semibold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200 flex items-center gap-0.5">
                                                <svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                                                Đã mua hàng
                                            </span>
                                        </div>
                                        <span class="text-[10px] text-slate-400">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>

                                <div class="flex items-center text-amber-400">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= r.Rating)
                                        {
                                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                        }
                                        else
                                        {
                                            <svg class="w-3.5 h-3.5 text-slate-200 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                        }
                                    }
                                </div>
                            </div>
                            <p class="text-slate-700 leading-relaxed pl-10">@r.Comment</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-slate-400 text-xs">
                    Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên để lại nhận xét!
                </div>
            }
        </div>
    </div>

    <!-- Related Products Section -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-8 space-y-6">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div class="space-y-1">
                    <h3 class="text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
                        <span>🔥 Sản Phẩm Tương Tự Cùng Phân Khúc</span>
                    </h3>
                    <p class="text-xs text-slate-500">Các thiết bị công nghệ cùng danh mục @product.Category.Name bạn có thể quan tâm</p>
                </div>
                <a href="/category/@product.Category.Slug" class="text-xs text-blue-600 hover:underline font-bold flex items-center gap-1">
                    Xem tất cả
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-4">
                @foreach (var rp in Model.RelatedProducts)
                {
                    var rpMinVariant = rp.Variants?.OrderBy(v => v.SalePrice).FirstOrDefault();
                    decimal rpSalePrice = rpMinVariant?.SalePrice ?? 0;
                    decimal rpOrigPrice = rpMinVariant?.OriginalPrice ?? 0;
                    <div class="group bg-slate-50 hover:bg-white p-4 rounded-2xl border border-slate-200/70 hover:border-blue-400 transition-all shadow-2xs hover:shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="aspect-square w-full rounded-xl overflow-hidden bg-white p-3 mb-3 flex items-center justify-center border border-slate-100">
                                <img src="@rp.FeaturedImage" alt="@rp.Name" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/placeholder.png'" />
                            </div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">@rp.Brand?.Name</span>
                            <h4 class="text-xs font-bold text-slate-800 line-clamp-2 group-hover:text-blue-600 transition-colors mt-0.5">
                                <a href="/product/@rp.Slug">@rp.Name</a>
                            </h4>
                        </div>
                        <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-black text-rose-600">@rpSalePrice.ToString("N0") đ</p>
                                @if (rpOrigPrice > rpSalePrice)
                                {
                                    <p class="text-[10px] text-slate-400 line-through">@rpOrigPrice.ToString("N0") đ</p>
                                }
                            </div>
                            <a href="/product/@rp.Slug" class="px-2.5 py-1.5 bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white rounded-lg text-xs font-bold transition-colors">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Recently Viewed Products Section -->
    <div id="recentlyViewedSection" class="hidden bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-8 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div class="space-y-1">
                <h3 class="text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
                    <span>🕒 Sản Phẩm Bạn Đã Xem Gần Đây</span>
                </h3>
                <p class="text-xs text-slate-500">Các thiết bị công nghệ bạn vừa xem trong phiên làm việc này</p>
            </div>
            <button type="button" onclick="clearRecentProducts()" class="text-xs text-slate-400 hover:text-rose-600 transition-colors font-medium">
                Xóa lịch sử xem
            </button>
        </div>
        <div id="recentlyViewedGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            <!-- Rendered dynamically via JS -->
        </div>
    </div>
</div>

<!-- Modal 1: Cấu Hình Kỹ Thuật Đầy Đủ (Full Specs Modal) -->
<dialog id="fullSpecsModal" closedby="any" class="backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm rounded-3xl p-0 border border-slate-200 shadow-2xl max-w-2xl w-full m-auto">
    <div class="p-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
                <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">⚙️</span>
                <h3 class="text-base font-extrabold text-slate-900">Bảng Thông Số Kỹ Thuật Chi Tiết</h3>
            </div>
            <button type="button" onclick="this.closest('dialog').close()" class="p-1.5 rounded-xl hover:bg-slate-100 text-slate-400 hover:text-slate-700">✕</button>
        </div>
        <div class="py-4 max-h-[60vh] overflow-y-auto no-scrollbar divide-y divide-slate-100 text-xs">
            @if (specsList.Any())
            {
                @foreach (var s in specsList)
                {
                    <div class="py-3 flex justify-between gap-4">
                        <span class="text-slate-500 font-semibold w-1/3">@s.Key</span>
                        <strong class="text-slate-900 w-2/3 text-right">@s.Value</strong>
                    </div>
                }
            }
            else
            {
                <p class="text-xs text-slate-400 py-4">Đang cập nhật thông số chi tiết.</p>
            }
        </div>
        <button type="button" onclick="this.closest('dialog').close()" class="w-full py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs hover:bg-black transition">Đóng</button>
    </div>
</dialog>

<!-- Modal 2: Dự Toán Trả Góp 0% Lãi Suất (Installment Calculator Modal) -->
<dialog id="installmentModal" closedby="any" class="backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm rounded-3xl p-0 border border-slate-200 shadow-2xl max-w-lg w-full m-auto">
    <div class="p-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
                <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">💳</span>
                <div>
                    <h3 class="text-base font-extrabold text-slate-900">Dự Toán Trả Góp 0% Lãi Suất</h3>
                    <p class="text-[11px] text-slate-400">Qua Thẻ Tín Dụng & Công Ty Tài Chính</p>
                </div>
            </div>
            <button type="button" onclick="this.closest('dialog').close()" class="p-1.5 rounded-xl hover:bg-slate-100 text-slate-400 hover:text-slate-700">✕</button>
        </div>
        <div id="installmentTableBody" class="py-4 space-y-2.5 text-xs">
            <!-- Dynamic calculation rendered via JS -->
        </div>
        <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-[11px] text-amber-800 leading-snug mb-4">
            ℹ️ Thủ tục đơn giản: Chỉ cần CCCD gắn chip hoặc thẻ tín dụng (Visa/Mastercard) của 28 ngân hàng liên kết. Duyệt online 5 phút.
        </div>
        <button type="button" onclick="this.closest('dialog').close()" class="w-full py-2.5 bg-blue-600 text-white font-bold rounded-xl text-xs hover:bg-blue-700 transition">Đã Hiểu</button>
    </div>
</dialog>

<!-- Sticky Buy Bar (Khi cuộn chuột qua khối mua hàng) -->
<div id="stickyBuyBar" class="fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 shadow-2xl transition-transform duration-300 translate-y-full flex items-center justify-between max-w-7xl mx-auto px-4">
    <div class="flex items-center gap-3">
        <img src="@product.FeaturedImage" alt="@product.Name" class="w-12 h-12 object-contain rounded-xl border border-slate-200 bg-white p-1" onerror="this.src='/assets/images/placeholder.png'" />
        <div>
            <h4 class="text-xs font-black text-slate-900 line-clamp-1">@product.Name</h4>
            <div class="flex items-center gap-2 mt-0.5">
                <span id="stickyVariantPrice" class="text-sm font-black text-blue-600">@((defaultVariant?.SalePrice ?? 0).ToString("N0")) đ</span>
                <span class="text-[10px] text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.2 rounded">Chính Hãng</span>
            </div>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <button type="button" onclick="handleAddCurrentToCart(false)" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-sm transition">
            Thêm Vào Giỏ
        </button>
        <button type="button" onclick="handleAddCurrentToCart(true)" class="px-5 py-2 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-xs rounded-xl shadow-md transition">
            Mua Ngay
        </button>
    </div>
</div>

<script>
    let currentSalePrice = @(defaultVariant?.SalePrice ?? 0);

    function selectVariant(id, name, salePrice, origPrice, stock, image, sku) {
        currentSalePrice = salePrice;
        document.getElementById('selectedVariantId').value = id;
        document.getElementById('selectedVariantStock').value = stock;
        document.getElementById('selectedVariantPrice').value = salePrice;

        document.getElementById('variantPrice').innerText = salePrice.toLocaleString('vi-VN') + ' đ';
        document.getElementById('variantOriginalPrice').innerText = origPrice.toLocaleString('vi-VN') + ' đ';
        document.getElementById('stickyVariantPrice').innerText = salePrice.toLocaleString('vi-VN') + ' đ';
        document.getElementById('installmentMonthlyPreview').innerText = Math.round(salePrice / 12).toLocaleString('vi-VN') + 'đ/th';

        const stockEl = document.getElementById('stockStatus');
        const buyBtn = document.getElementById('pdpBuyNowBtn');
        const addBtn = document.getElementById('pdpAddToCartBtn');
        const qtyInput = document.getElementById('pdpQuantityInput');

        if (stock > 0) {
            stockEl.innerText = `Còn hàng (${stock} sản phẩm)`;
            stockEl.className = 'text-emerald-600 font-bold';
            buyBtn.classList.remove('opacity-50', 'pointer-events-none');
            addBtn.classList.remove('opacity-50', 'pointer-events-none');
            qtyInput.max = stock;
            if (parseInt(qtyInput.value) > stock) qtyInput.value = stock;
        } else {
            stockEl.innerText = 'Hết hàng';
            stockEl.className = 'text-rose-600 font-bold';
            buyBtn.classList.add('opacity-50', 'pointer-events-none');
            addBtn.classList.add('opacity-50', 'pointer-events-none');
        }

        if (image) document.getElementById('mainProductImage').src = image;
        if (sku) document.getElementById('variantSkuDisplay').innerText = 'SKU: ' + sku;

        document.querySelectorAll('.variant-btn').forEach(btn => {
            btn.className = 'variant-btn p-3 text-left border rounded-xl transition-all border-slate-200 hover:border-slate-300 bg-white';
        });
        const activeBtn = document.getElementById('variantBtn_' + id);
        if (activeBtn) {
            activeBtn.className = 'variant-btn p-3 text-left border rounded-xl transition-all border-blue-600 bg-blue-50/50 ring-2 ring-blue-500/20';
        }
    }

    function adjustPdpQuantity(delta) {
        const input = document.getElementById('pdpQuantityInput');
        const stock = parseInt(document.getElementById('selectedVariantStock').value) || 50;
        let val = (parseInt(input.value) || 1) + delta;
        if (val < 1) val = 1;
        if (val > stock) {
            val = stock;
            if (window.showToast) showToast(`Chỉ có thể chọn tối đa ${stock} sản phẩm`, 'warning');
        }
        input.value = val;
    }

    function handleAddCurrentToCart(redirectToCheckout = false) {
        const variantId = parseInt(document.getElementById('selectedVariantId').value);
        const stock = parseInt(document.getElementById('selectedVariantStock').value) || 0;
        const qty = parseInt(document.getElementById('pdpQuantityInput').value) || 1;

        if (stock <= 0) {
            if (window.showToast) showToast('Sản phẩm này hiện đang tạm hết hàng!', 'error');
            return;
        }

        if (variantId > 0) {
            addToCart(variantId, qty, !redirectToCheckout);
            if (redirectToCheckout) {
                window.location.href = '/checkout';
            }
        }
    }

    // 0% Installment Modal logic
    function openInstallmentModal() {
        const dialog = document.getElementById('installmentModal');
        const container = document.getElementById('installmentTableBody');
        if (!dialog || !container) return;

        const months = [3, 6, 9, 12];
        let html = '<div class="divide-y divide-slate-100">';
        months.forEach(m => {
            const monthly = Math.round(currentSalePrice / m);
            html += `
                <div class="py-2.5 flex items-center justify-between">
                    <div>
                        <strong class="text-slate-800 text-xs">Kỳ hạn ${m} tháng</strong>
                        <span class="block text-[10px] text-slate-400">Lãi suất 0%</span>
                    </div>
                    <div class="text-right">
                        <strong class="text-blue-600 text-sm font-black">${monthly.toLocaleString('vi-VN')} đ/tháng</strong>
                        <span class="block text-[10px] text-slate-400">Trả trước: 0 đ</span>
                    </div>
                </div>
            `;
        });
        html += '</div>';
        container.innerHTML = html;
        dialog.showModal();
    }

    // Sticky Buy Bar on scroll
    window.addEventListener('scroll', () => {
        const mainCard = document.getElementById('mainProductCard');
        const stickyBar = document.getElementById('stickyBuyBar');
        if (!mainCard || !stickyBar) return;

        const rect = mainCard.getBoundingClientRect();
        if (rect.bottom < 100) {
            stickyBar.classList.remove('translate-y-full');
        } else {
            stickyBar.classList.add('translate-y-full');
        }
    });

    // Star rating selection
    const ratingTexts = {
        1: "1/5 - Rất không hài lòng",
        2: "2/5 - Không hài lòng",
        3: "3/5 - Bình thường",
        4: "4/5 - Hài lòng",
        5: "5/5 - Rất tuyệt vời!"
    };

    function setReviewRating(rating) {
        const input = document.getElementById('reviewRatingInput');
        if (input) input.value = rating;

        const desc = document.getElementById('ratingDescription');
        if (desc) desc.innerText = ratingTexts[rating] || (rating + "/5");

        const buttons = document.querySelectorAll('.star-pick');
        buttons.forEach((btn, idx) => {
            const starSvg = btn.querySelector('.star-icon');
            if (idx < rating) {
                starSvg.classList.add('text-amber-400');
                starSvg.classList.remove('text-slate-200');
            } else {
                starSvg.classList.remove('text-amber-400');
                starSvg.classList.add('text-slate-200');
            }
        });
    }

    // Wishlist toggle
    async function toggleWishlist(productId, btn) {
        try {
            const res = await fetch(`/api/wishlist/toggle?productId=${productId}`, { method: 'POST' });
            if (res.status === 401) {
                window.location.href = `/auth/login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                return;
            }
            if (!res.ok) return;
            const data = await res.json();
            const svg = btn.querySelector('svg');
            if (data.isWishlisted) {
                btn.classList.remove('bg-slate-100', 'text-slate-500');
                btn.classList.add('bg-rose-50', 'text-rose-600');
                svg.setAttribute('fill', 'currentColor');
            } else {
                btn.classList.remove('bg-rose-50', 'text-rose-600');
                btn.classList.add('bg-slate-100', 'text-slate-500');
                svg.setAttribute('fill', 'none');
            }

            const headerWishlistBadge = document.getElementById('headerWishlistCount');
            if (headerWishlistBadge) {
                headerWishlistBadge.innerText = data.count;
                headerWishlistBadge.classList.toggle('hidden', data.count === 0);
            }
        } catch (err) {
            console.error('Wishlist error:', err);
        }
    }

    // Interactive Gallery image switcher
    function switchGalleryImage(imgUrl, btnElement) {
        const mainImg = document.getElementById('mainProductImage');
        if (mainImg) {
            mainImg.src = imgUrl;
        }
        document.querySelectorAll('.gallery-thumb').forEach(btn => {
            btn.classList.remove('border-[#0046be]');
            btn.classList.add('border-slate-200');
        });
        if (btnElement) {
            btnElement.classList.remove('border-slate-200');
            btnElement.classList.add('border-[#0046be]');
        }
    }

    // Recently viewed logic
    (function initRecentlyViewed() {
        try {
            const currentItem = {
                id: @product.ProductId,
                name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.Name)),
                slug: '@product.Slug',
                image: '@product.FeaturedImage',
                price: @(defaultVariant?.SalePrice ?? 0),
                category: '@product.Category.Name'
            };

            const STORAGE_KEY = 'techstore_recently_viewed';
            let recents = [];
            try {
                recents = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            } catch(e) { recents = []; }

            const otherRecents = recents.filter(p => p.id !== currentItem.id);
            const section = document.getElementById('recentlyViewedSection');
            const grid = document.getElementById('recentlyViewedGrid');

            if (section && grid && otherRecents.length > 0) {
                grid.innerHTML = otherRecents.slice(0, 6).map(p => `
                    <a href="/product/${p.slug}" class="group bg-slate-50 hover:bg-white p-3 rounded-2xl border border-slate-200/70 hover:border-blue-400 transition-all shadow-2xs hover:shadow-sm flex flex-col justify-between">
                        <div class="aspect-square w-full rounded-xl overflow-hidden bg-white p-2 mb-2 flex items-center justify-center border border-slate-100">
                            <img src="${p.image}" alt="${p.name}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" onerror="this.src='/assets/images/placeholder.png'" />
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">${p.category}</span>
                            <h4 class="text-xs font-bold text-slate-800 line-clamp-2 group-hover:text-blue-600 transition-colors mt-0.5">${p.name}</h4>
                            <p class="text-xs font-black text-rose-600 mt-1.5">${(p.price || 0).toLocaleString('vi-VN')} đ</p>
                        </div>
                    </a>
                `).join('');
                section.classList.remove('hidden');
            }

            const updated = [currentItem, ...otherRecents].slice(0, 10);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
        } catch(err) {
            console.error('Recently viewed error:', err);
        }
    })();

    function clearRecentProducts() {
        localStorage.removeItem('techstore_recently_viewed');
        const section = document.getElementById('recentlyViewedSection');
        if (section) section.classList.add('hidden');
    }
</script>
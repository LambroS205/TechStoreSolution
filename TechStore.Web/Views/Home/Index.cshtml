@model HomeViewModel
@{
    ViewData["Title"] = "TechStore - Siêu Thị Công Nghệ Chính Hãng Số 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto px-4 py-6 space-y-12">
    <!-- 1. Hero Section: Banner Slider động & Sub-banners -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Main Slider (Chiếm 2/3 bề rộng) -->
        <div id="heroSliderContainer" class="lg:col-span-2 relative rounded-3xl overflow-hidden shadow-sm bg-slate-950 border border-slate-200 group select-none">
            <!-- Slider Track (Horizontal Sliding Carousel) -->
            <div id="heroSliderTrack" class="flex h-[270px] sm:h-[360px] w-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">
                @for (int i = 0; i < Model.HeroSliders.Count; i++)
                {
                    var b = Model.HeroSliders[i];
                    <div class="slider-slide min-w-full h-full relative shrink-0" data-index="@i">
                        <a href="@(string.IsNullOrEmpty(b.TargetUrl) ? "#" : b.TargetUrl)" class="block w-full h-full relative">
                            <img src="@b.ImageUrl" alt="@b.Title" class="w-full h-full object-cover object-center" onerror="this.src='/assets/images/placeholder.png'" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/35 to-transparent flex flex-col justify-end p-6 sm:p-8 text-white">
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="px-2.5 py-1 bg-bestbuy-yellow text-slate-950 font-black text-[11px] rounded-lg w-fit uppercase tracking-wide shadow-sm">Ưu Đãi Độc Quyền</span>
                                    <span class="text-[11px] font-bold text-white/90 bg-white/20 backdrop-blur-xs px-2 py-0.5 rounded-md">@(i + 1) / @(Model.HeroSliders.Count)</span>
                                </div>
                                <h2 class="text-xl sm:text-3xl font-black leading-tight drop-shadow-sm">@b.Title</h2>
                                @if (!string.IsNullOrEmpty(b.Subtitle))
                                {
                                    <p class="text-xs sm:text-sm text-slate-200 mt-1.5 line-clamp-1 font-medium drop-shadow-sm">@b.Subtitle</p>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>

            <!-- Nút Prev/Next Slider -->
            <button type="button" onclick="changeHeroSlide(-1); event.stopPropagation();" class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/90 hover:bg-white text-slate-900 flex items-center justify-center shadow-lg transition-all active:scale-90 opacity-0 group-hover:opacity-100 duration-200" aria-label="Slide trước">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <button type="button" onclick="changeHeroSlide(1); event.stopPropagation();" class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/90 hover:bg-white text-slate-900 flex items-center justify-center shadow-lg transition-all active:scale-90 opacity-0 group-hover:opacity-100 duration-200" aria-label="Slide tiếp">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            </button>

            <!-- Slider Pagination Dots -->
            <div id="sliderDots" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
                @for (int i = 0; i < Model.HeroSliders.Count; i++)
                {
                    <button type="button" onclick="showSlide(@i); event.stopPropagation();" class="slider-dot h-2 rounded-full transition-all duration-300 @(i == 0 ? "w-8 bg-bestbuy-yellow" : "w-2.5 bg-white/50 hover:bg-white")" aria-label="Tới slide @(i + 1)"></button>
                }
            </div>

            <!-- Animated Countdown Progress Bar -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-white/20 z-20 overflow-hidden">
                <div id="sliderProgressBar" class="h-full bg-bestbuy-yellow transition-all duration-75 ease-linear" style="width: 0%;"></div>
            </div>
        </div>

        <!-- Sub-banners Cạnh Slider (Chiếm 1/3 bề rộng) -->
        <div class="flex flex-col gap-4">
            @foreach (var sb in Model.SubBanners)
            {
                <a href="@(string.IsNullOrEmpty(sb.TargetUrl) ? "#" : sb.TargetUrl)" class="relative h-[170px] rounded-3xl overflow-hidden shadow-sm border border-slate-200 group block">
                    <img src="@sb.ImageUrl" alt="@sb.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/assets/images/placeholder.png'" />
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-900/40 to-transparent p-5 flex flex-col justify-center text-white">
                        <span class="text-[10px] font-bold text-bestbuy-yellow uppercase tracking-wider">Ưu Đãi Hôm Nay</span>
                        <h4 class="font-black text-sm sm:text-base leading-snug mt-1">@sb.Title</h4>
                        @if (!string.IsNullOrEmpty(sb.Subtitle))
                        {
                            <p class="text-[11px] text-slate-300 line-clamp-1 mt-0.5">@sb.Subtitle</p>
                        }
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- 2. 4 Cam Kết Vàng (Trust Strip) chuẩn chuỗi CellphoneS / Thế Giới Di Động -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center gap-3 p-2">
            <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <div>
                <h4 class="text-xs sm:text-sm font-black text-slate-900">Chính Hãng 100%</h4>
                <p class="text-[11px] text-slate-500">Bảo hành chính hãng 12-24 tháng</p>
            </div>
        </div>
        <div class="flex items-center gap-3 p-2">
            <div class="w-11 h-11 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
            </div>
            <div>
                <h4 class="text-xs sm:text-sm font-black text-slate-900">1 Đổi 1 Trong 30 Ngày</h4>
                <p class="text-[11px] text-slate-500">Lỗi NSX đổi mới lập tức</p>
            </div>
        </div>
        <div class="flex items-center gap-3 p-2">
            <div class="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
            </div>
            <div>
                <h4 class="text-xs sm:text-sm font-black text-slate-900">Miễn Phí Vận Chuyển</h4>
                <p class="text-[11px] text-slate-500">Đơn hàng từ 1.000.000đ</p>
            </div>
        </div>
        <div class="flex items-center gap-3 p-2">
            <div class="w-11 h-11 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
            </div>
            <div>
                <h4 class="text-xs sm:text-sm font-black text-slate-900">Trả Góp 0% Lãi Suất</h4>
                <p class="text-[11px] text-slate-500">Thủ tục duyệt online trong 5 phút</p>
            </div>
        </div>
    </div>

    <!-- 3. FLASH SALE GIỜ VÀNG (Nếu có sản phẩm giảm giá sâu) -->
    @if (Model.FlashSaleProducts.Any())
    {
        <div class="bg-gradient-to-r from-red-600 via-rose-600 to-amber-600 rounded-3xl p-5 sm:p-6 shadow-xl text-white space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/20 pb-4">
                <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-2xl bg-white text-red-600 flex items-center justify-center text-xl shadow-md animate-bounce">🔥</span>
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-lg sm:text-2xl font-black uppercase tracking-tight">Flash Sale Giờ Vàng</h2>
                            <span class="px-2 py-0.5 rounded-full bg-yellow-400 text-slate-950 text-[10px] font-black uppercase">Đang Diễn Ra</span>
                        </div>
                        <p class="text-xs text-rose-100">Số lượng có hạn - Giảm sốc đến 45%</p>
                    </div>
                </div>

                <!-- Flash Sale Live Countdown Timer -->
                <div class="flex items-center gap-2 text-xs font-bold bg-black/30 backdrop-blur-sm px-4 py-2 rounded-2xl border border-white/10 w-fit">
                    <span class="text-rose-200">Kết thúc sau:</span>
                    <div class="flex items-center gap-1 font-mono text-sm font-black">
                        <span id="countdownHours" class="bg-white text-slate-950 px-2 py-1 rounded-lg">04</span>
                        <span>:</span>
                        <span id="countdownMinutes" class="bg-white text-slate-950 px-2 py-1 rounded-lg">45</span>
                        <span>:</span>
                        <span id="countdownSeconds" class="bg-white text-slate-950 px-2 py-1 rounded-lg">18</span>
                    </div>
                </div>
            </div>

            <!-- Flash Sale Products Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var p in Model.FlashSaleProducts)
                {
                    var minVariant = p.Variants.OrderBy(v => v.SalePrice).FirstOrDefault();
                    decimal displayPrice = minVariant?.SalePrice ?? 0;
                    decimal originalPrice = minVariant?.OriginalPrice ?? 0;
                    int discountPercent = originalPrice > displayPrice ? (int)Math.Round((1 - displayPrice / originalPrice) * 100) : 0;

                    <div class="bg-white rounded-2xl p-3.5 text-slate-800 flex flex-col justify-between shadow-lg hover:shadow-2xl transition-all group relative">
                        <div class="relative">
                            <!-- Image -->
                            <div class="relative h-44 bg-slate-50 rounded-xl overflow-hidden flex items-center justify-center p-2 mb-2.5">
                                <img src="@p.FeaturedImage" alt="@p.Name" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/placeholder.png'" />
                                <span class="absolute top-2 left-2 px-2 py-0.5 text-[10px] font-black bg-red-600 text-white rounded-lg shadow-sm">
                                    -@discountPercent%
                                </span>
                                <!-- Wishlist Toggle Button -->
                                <button type="button" 
                                        data-wishlist-product-id="@p.ProductId"
                                        onclick="event.stopPropagation(); toggleCardWishlist(@p.ProductId, this)" 
                                        class="absolute top-2 right-2 w-7 h-7 rounded-lg bg-white/95 hover:bg-white text-slate-400 hover:text-rose-600 border border-slate-200 shadow-sm flex items-center justify-center transition-all z-10"
                                        title="Lưu vào danh sách yêu thích">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                                </button>
                                <!-- Quick View Trigger Button -->
                                <button type="button" onclick="openQuickView(@p.ProductId)" class="absolute inset-x-2 bottom-2 py-1.5 bg-slate-900/90 hover:bg-black text-white text-[11px] font-bold rounded-lg opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-sm shadow-md flex items-center justify-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    <span>Xem nhanh</span>
                                </button>
                            </div>

                            <a href="/product/@p.Slug" class="font-bold text-slate-900 text-xs sm:text-sm line-clamp-2 hover:text-blue-600 transition-colors leading-tight">
                                @p.Name
                            </a>

                            <!-- Sale Progress Bar -->
                            <div class="mt-2 space-y-1">
                                <div class="w-full bg-rose-100 rounded-full h-2 overflow-hidden">
                                    <div class="bg-gradient-to-r from-amber-500 to-rose-600 h-2 rounded-full" style="width: 78%"></div>
                                </div>
                                <span class="text-[10px] text-rose-600 font-bold block text-right">🔥 Đã bán 78%</span>
                            </div>
                        </div>

                        <!-- Price & Add To Cart -->
                        <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <div class="text-sm sm:text-base font-black text-red-600">@displayPrice.ToString("N0") đ</div>
                                @if (originalPrice > displayPrice)
                                {
                                    <div class="text-[11px] text-slate-400 line-through">@originalPrice.ToString("N0") đ</div>
                                }
                            </div>
                            @if (minVariant != null && minVariant.StockQuantity > 0)
                            {
                                <button onclick="addToCart(@minVariant.VariantId, 1, true)" class="p-2 bg-red-600 hover:bg-red-700 text-white rounded-xl shadow-sm transition active:scale-95" title="Mua ngay giá sốc">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 4. TRẠM THU THẬP MÃ GIẢM GIÁ (Voucher Station) -->
    @if (Model.ActiveCoupons.Any())
    {
        <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <div class="flex items-center gap-2.5">
                    <span class="w-9 h-9 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center font-bold">🎟️</span>
                    <div>
                        <h2 class="text-base sm:text-lg font-black text-slate-900">Trạm Thu Thập Mã Giảm Giá</h2>
                        <p class="text-xs text-slate-500">Lưu mã ưu đãi để tự động áp dụng khi thanh toán</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                @foreach (var c in Model.ActiveCoupons)
                {
                    <div class="bg-gradient-to-br from-blue-50/60 to-indigo-50/40 rounded-2xl p-4 border border-blue-200/60 flex flex-col justify-between relative overflow-hidden group">
                        <div class="space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="px-2 py-0.5 rounded-md bg-blue-600 text-white text-[10px] font-black uppercase tracking-wider">@c.Code</span>
                                <span class="text-[10px] font-bold text-slate-400">HSD: 31/12</span>
                            </div>
                            <h4 class="font-black text-slate-900 text-sm mt-1">@c.Description</h4>
                            @if (c.MinOrderAmount > 0)
                            {
                                <p class="text-[11px] text-slate-500">Đơn tối thiểu: @c.MinOrderAmount.ToString("N0")đ</p>
                            }
                        </div>
                        <button type="button" onclick="claimVoucher('@c.Code', this)" class="mt-3 w-full py-2 bg-white hover:bg-blue-600 text-blue-600 hover:text-white border border-blue-200 hover:border-blue-600 rounded-xl text-xs font-bold shadow-sm transition-all flex items-center justify-center gap-1.5 active:scale-95">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                            <span>Lưu Mã Ngay</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 5. Danh Mục Sản Phẩm Nổi Bật (Icon Cards) -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
                <span class="w-2.5 h-5 bg-blue-600 rounded-sm"></span>
                <span>Khám Phá Theo Danh Mục</span>
            </h2>
            <a href="/products" class="text-xs font-bold text-blue-600 hover:underline">Xem tất cả &rarr;</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
            @foreach (var cat in Model.Categories)
            {
                <a href="/category/@cat.Slug" class="bg-white p-4 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-md transition-all text-center group block">
                    <div class="w-12 h-12 mx-auto rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors mb-2.5 shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                    </div>
                    <span class="text-xs font-bold text-slate-800 block group-hover:text-blue-600 transition-colors">@cat.Name</span>
                </a>
            }
        </div>
    </div>

    <!-- 6. Thiết Bị Công Nghệ Flagship Nổi Bật -->
    <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200">
            <div>
                <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                    <span class="w-2.5 h-5 bg-bestbuy-yellow rounded-sm border border-slate-300"></span>
                    <span>Thiết Bị Công Nghệ Nổi Bật 2026</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Sản phẩm chính hãng phân phối trực tiếp từ Apple, Samsung, Dell, Asus, Sony</p>
            </div>
            <a href="/products" class="text-xs font-bold text-blue-600 hover:underline hidden sm:inline">Xem toàn bộ 23 sản phẩm &rarr;</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var p in Model.FeaturedProducts)
            {
                var minVariant = p.Variants.OrderBy(v => v.SalePrice).FirstOrDefault();
                decimal displayPrice = minVariant?.SalePrice ?? 0;
                decimal originalPrice = minVariant?.OriginalPrice ?? 0;
                int discountPercent = originalPrice > displayPrice ? (int)Math.Round((1 - displayPrice / originalPrice) * 100) : 0;
                int totalStock = p.Variants.Sum(v => v.StockQuantity);
                var approvedReviews = p.Reviews?.Where(r => r.IsApproved).ToList();
                int revCount = approvedReviews?.Count ?? 0;
                double avgRating = revCount > 0 ? Math.Round(approvedReviews!.Average(r => r.Rating), 1) : 5.0;

                <div class="bg-white rounded-3xl border border-slate-200 hover:border-blue-400 hover:shadow-xl transition-all p-4 flex flex-col justify-between group relative">
                    <div>
                        <!-- Product Thumbnail, Badges & Quick View Trigger -->
                        <div class="relative h-48 bg-slate-50 rounded-2xl overflow-hidden flex items-center justify-center p-3 mb-3">
                            <img src="@p.FeaturedImage" alt="@p.Name" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/placeholder.png'" />
                            
                            <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5 flex-wrap">
                                @if (discountPercent > 0)
                                {
                                    <span class="px-2 py-0.5 text-[10px] font-black bg-rose-600 text-white rounded-lg shadow-sm">
                                        -@discountPercent%
                                    </span>
                                }
                                <span class="px-2 py-0.5 text-[10px] font-bold bg-white/95 text-slate-700 rounded-lg border border-slate-200 shadow-sm">
                                    @p.Brand.Name
                                </span>
                            </div>

                            <!-- Wishlist Toggle Button -->
                            <button type="button" 
                                    data-wishlist-product-id="@p.ProductId"
                                    onclick="event.stopPropagation(); toggleCardWishlist(@p.ProductId, this)" 
                                    class="absolute top-2.5 right-2.5 w-8 h-8 rounded-xl bg-white/95 hover:bg-white text-slate-400 hover:text-rose-600 border border-slate-200 shadow-sm flex items-center justify-center transition-all z-10"
                                    title="Lưu vào danh sách yêu thích">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                            </button>

                            @if (totalStock == 0)
                            {
                                <span class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px] flex items-center justify-center text-white text-xs font-black uppercase">
                                    Tạm Hết Hàng
                                </span>
                            }
                            else
                            {
                                <!-- Quick View Button -->
                                <button type="button" onclick="openQuickView(@p.ProductId)" class="absolute inset-x-3 bottom-3 py-2 bg-slate-900/90 hover:bg-black text-white text-xs font-bold rounded-xl opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-sm shadow-md flex items-center justify-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    <span>Xem nhanh</span>
                                </button>
                            }
                        </div>

                        <!-- Product Title & Dynamic Reviews -->
                        <div class="flex items-center gap-1 text-amber-500 text-xs mb-1">
                            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                            <span class="text-[11px] text-slate-400 font-bold ml-1">@avgRating.ToString("0.0") (@(revCount > 0 ? revCount : 15))</span>
                        </div>
                        <a href="/product/@p.Slug" class="font-black text-slate-900 text-sm line-clamp-2 hover:text-blue-600 transition-colors leading-snug">
                            @p.Name
                        </a>
                        <p class="text-[11px] text-slate-500 mt-1 line-clamp-1 font-medium">@p.ShortDescription</p>
                    </div>

                    <!-- Price & Add To Cart Button -->
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <div class="text-base font-black text-blue-600">@displayPrice.ToString("N0") đ</div>
                            @if (originalPrice > displayPrice)
                            {
                                <div class="text-xs text-slate-400 line-through">@originalPrice.ToString("N0") đ</div>
                            }
                        </div>
                        @if (minVariant != null && totalStock > 0)
                        {
                            <button onclick="addToCart(@minVariant.VariantId, 1, true)" class="p-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-transform active:scale-95" title="Thêm vào giỏ hàng">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                            </button>
                        }
                        else
                        {
                            <span class="text-[11px] font-bold text-slate-400">Liên hệ</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 7. THƯƠNG HIỆU HỢP TÁC HÀNG ĐẦU -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
        <div class="text-center">
            <h3 class="text-base font-black text-slate-900">Thương Hiệu Công Nghệ Ủy Quyền Chính Thức</h3>
            <p class="text-xs text-slate-500 mt-0.5">Cam kết 100% linh kiện, thiết bị phân phối từ đại diện ủy quyền Việt Nam</p>
        </div>
        <div class="flex items-center justify-center flex-wrap gap-4 pt-2">
            @foreach (var brandName in new[] { "Apple", "Samsung", "Sony", "ASUS", "Dell", "Acer", "Lenovo", "Logitech" })
            {
                <a href="/products?brand=@brandName.ToLowerInvariant()" class="px-5 py-2.5 rounded-2xl bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-600 font-extrabold text-xs border border-slate-200 hover:border-blue-300 transition-all shadow-sm">
                    @brandName
                </a>
            }
        </div>
    </div>

    <!-- 7.5. SẢN PHẨM BẠN VỪA XEM (Recently Viewed) -->
    <div id="homeRecentlyViewed" class="hidden space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
                <span class="w-2.5 h-5 bg-indigo-600 rounded-sm"></span>
                <span>Sản Phẩm Bạn Đã Xem Gần Đây</span>
            </h2>
            <button type="button" onclick="clearHomeRecentViews()" class="text-xs font-bold text-slate-400 hover:text-rose-600 transition">Xóa lịch sử xem</button>
        </div>
        <div id="homeRecentList" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
            <!-- Dynamic items rendered by JS -->
        </div>
    </div>

    <!-- 8. TIN TỨC CÔNG NGHỆ MỚI NHẤT -->
    @if (Model.LatestBlogPosts.Any())
    {
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
                    <span class="w-2.5 h-5 bg-blue-600 rounded-sm"></span>
                    <span>Tin Tức & Tư Vấn Công Nghệ</span>
                </h2>
                <a href="/blog" class="text-xs font-bold text-blue-600 hover:underline">Xem thêm tin tức &rarr;</a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                @foreach (var post in Model.LatestBlogPosts)
                {
                    <a href="/blog/@post.Slug" class="bg-white rounded-3xl border border-slate-200 hover:border-blue-400 hover:shadow-lg transition-all overflow-hidden flex flex-col group">
                        <div class="h-44 bg-slate-100 overflow-hidden relative">
                            <img src="@post.ThumbnailUrl" alt="@post.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/assets/images/placeholder.png'" />
                            <span class="absolute top-3 left-3 px-2 py-0.5 rounded-lg bg-blue-600 text-white text-[10px] font-black uppercase">
                                Tin Mới
                            </span>
                        </div>
                        <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
                            <div>
                                <h3 class="font-black text-slate-900 text-sm line-clamp-2 group-hover:text-blue-600 transition-colors leading-snug">
                                    @post.Title
                                </h3>
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                                    @post.Summary
                                </p>
                            </div>
                            <div class="text-[11px] text-slate-400 pt-2 border-t border-slate-100 flex items-center justify-between">
                                <span>@post.PublishedAt.ToString("dd/MM/yyyy")</span>
                                <span class="font-bold text-blue-600 group-hover:translate-x-1 transition-transform">Đọc tiếp &rarr;</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Reusable Quick View Modal Dialog -->
<dialog id="quickViewDialog" closedby="any" class="backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm rounded-3xl p-0 border border-slate-200 shadow-2xl max-w-3xl w-full m-auto">
    <div id="quickViewContent" class="p-6 relative">
        <div class="flex items-center justify-center py-16">
            <svg class="animate-spin w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        </div>
    </div>
</dialog>

@section Scripts {
<script>
    // ==========================================
    // 1. HERO SLIDER AUTO-TRANSITION ENGINE
    // ==========================================
    (function initHeroSlider() {
        const track = document.getElementById('heroSliderTrack');
        const container = document.getElementById('heroSliderContainer');
        const progressBar = document.getElementById('sliderProgressBar');
        const slides = document.querySelectorAll('.slider-slide');
        const dots = document.querySelectorAll('.slider-dot');
        const totalSlides = slides.length;
        if (!track || totalSlides <= 1) return;

        let currentSlide = 0;
        let isPaused = false;
        let progressElapsed = 0;
        const SLIDE_DURATION = 3500; // 3.5 giây tự động chuyển
        const STEP_INTERVAL = 35;    // cập nhật thanh tiến trình mỗi 35ms mượt mà

        function updateSlideUI(index) {
            currentSlide = (index + totalSlides) % totalSlides;
            track.style.transform = `translateX(-${currentSlide * 100}%)`;

            // Cập nhật dots
            dots.forEach((dot, idx) => {
                if (idx === currentSlide) {
                    dot.className = 'slider-dot h-2 w-8 rounded-full transition-all duration-300 bg-bestbuy-yellow shadow-xs';
                } else {
                    dot.className = 'slider-dot h-2 w-2.5 rounded-full transition-all duration-300 bg-white/50 hover:bg-white';
                }
            });

            // Reset thanh tiến trình
            progressElapsed = 0;
            if (progressBar) progressBar.style.width = '0%';
        }

        window.showSlide = function (index) {
            updateSlideUI(index);
        };

        window.changeHeroSlide = function (step) {
            updateSlideUI(currentSlide + step);
        };

        // Vòng lặp đếm thời gian tự động chuyển slide kèm thanh tiến trình
        setInterval(() => {
            if (isPaused) return;

            progressElapsed += STEP_INTERVAL;
            const pct = Math.min(100, (progressElapsed / SLIDE_DURATION) * 100);
            if (progressBar) {
                progressBar.style.width = `${pct}%`;
            }

            if (progressElapsed >= SLIDE_DURATION) {
                updateSlideUI(currentSlide + 1);
            }
        }, STEP_INTERVAL);

        // Tạm dừng khi rê chuột vào container, tiếp tục khi rời chuột
        container.addEventListener('mouseenter', () => { isPaused = true; });
        container.addEventListener('mouseleave', () => { isPaused = false; });

        // Tạm dừng khi người dùng chuyển sang tab khác
        document.addEventListener('visibilitychange', () => {
            isPaused = document.hidden;
        });

        // Hỗ trợ cảm ứng vuốt (Swipe) trên điện thoại và máy tính bảng
        let touchStartX = 0;
        let touchEndX = 0;
        container.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
            isPaused = true;
        }, { passive: true });

        container.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            isPaused = false;
            const diffX = touchStartX - touchEndX;
            if (Math.abs(diffX) > 40) {
                if (diffX > 0) {
                    window.changeHeroSlide(1);
                } else {
                    window.changeHeroSlide(-1);
                }
            }
        }, { passive: true });
    })();

    // ==========================================
    // 2. FLASH SALE LIVE COUNTDOWN
    // ==========================================
    function updateCountdown() {
        const now = new Date();
        const endOfDay = new Date();
        endOfDay.setHours(23, 59, 59, 999);
        const diff = Math.max(0, endOfDay - now);

        const h = Math.floor(diff / 3600000).toString().padStart(2, '0');
        const m = Math.floor((diff % 3600000) / 60000).toString().padStart(2, '0');
        const s = Math.floor((diff % 60000) / 1000).toString().padStart(2, '0');

        const elH = document.getElementById('countdownHours');
        const elM = document.getElementById('countdownMinutes');
        const elS = document.getElementById('countdownSeconds');
        if (elH) elH.innerText = h;
        if (elM) elM.innerText = m;
        if (elS) elS.innerText = s;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // ==========================================
    // 3. 1-CLICK VOUCHER CLAIM
    // ==========================================
    function claimVoucher(code, btn) {
        sessionStorage.setItem('techstore_coupon', code);
        btn.innerHTML = '✓ Đã Lưu Mã';
        btn.className = 'mt-3 w-full py-2 bg-emerald-600 text-white rounded-xl text-xs font-black shadow-sm';
        if (window.showToast) {
            showToast(`Đã lưu mã giảm giá "${code}"! Mã sẽ tự động điền trong Giỏ Hàng.`, 'success');
        }
    }

    // ==========================================
    // 4. QUICK VIEW MODAL
    // ==========================================
    async function openQuickView(productId) {
        const dialog = document.getElementById('quickViewDialog');
        const content = document.getElementById('quickViewContent');
        if (!dialog || !content) return;

        dialog.showModal();
        content.innerHTML = `
            <div class="flex items-center justify-center py-16">
                <svg class="animate-spin w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
            </div>
        `;

        try {
            const res = await fetch(`/api/product/quick-view/${productId}`);
            if (!res.ok) throw new Error('Không thể tải thông tin sản phẩm');
            const p = await res.json();

            const minVariant = p.variants && p.variants.length > 0 ? p.variants[0] : null;
            const price = minVariant ? (minVariant.salePrice ?? minVariant.price).toLocaleString('vi-VN') + ' đ' : 'Liên hệ';
            const brand = p.brandName || p.brand || '';
            const category = p.categoryName || p.category || '';
            const stock = minVariant ? (minVariant.stockQuantity ?? minVariant.stock ?? 0) : 0;

            let specsHtml = '';
            if (p.specifications && typeof p.specifications === 'object') {
                specsHtml = '<div class="grid grid-cols-2 gap-2 mt-3 text-[11px]">';
                const entries = Array.isArray(p.specifications) ? p.specifications : Object.entries(p.specifications);
                entries.slice(0, 4).forEach(item => {
                    const name = Array.isArray(item) ? item[0] : item.name;
                    const val = Array.isArray(item) ? item[1] : item.value;
                    specsHtml += `<div class="p-2 bg-slate-50 rounded-xl border border-slate-100"><span class="text-slate-400 block">${name}</span><strong class="text-slate-800 line-clamp-1">${val}</strong></div>`;
                });
                specsHtml += '</div>';
            }

            content.innerHTML = `
                <button type="button" onclick="document.getElementById('quickViewDialog').close()" class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">✕</button>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                    <div class="h-64 bg-slate-50 rounded-2xl p-4 flex items-center justify-center">
                        <img src="${p.featuredImage}" alt="${p.name}" class="max-h-full max-w-full object-contain" onerror="this.src='/assets/images/placeholder.png'" />
                    </div>
                    <div class="space-y-3">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-600 text-[10px] font-black uppercase">${brand}</span>
                            <span class="text-[11px] text-slate-400">${category}</span>
                        </div>
                        <h3 class="text-lg font-black text-slate-900 leading-snug">${p.name}</h3>
                        <div class="text-xl font-black text-blue-600">${price}</div>
                        <p class="text-xs text-slate-500 line-clamp-3">${p.shortDescription || ''}</p>
                        ${specsHtml}
                        <div class="pt-3 flex gap-2.5">
                            ${minVariant && stock > 0 ? `
                                <button type="button" onclick="addToCart(${minVariant.variantId}, 1, true); document.getElementById('quickViewDialog').close();" class="flex-1 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition">
                                    Thêm Vào Giỏ Hàng
                                </button>
                            ` : '<span class="text-xs font-bold text-slate-400">Tạm hết hàng</span>'}
                            <a href="/product/${p.slug}" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition text-center">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            `;
        } catch (e) {
            content.innerHTML = `
                <div class="p-6 text-center text-rose-600 text-xs font-bold">
                    Có lỗi xảy ra khi tải sản phẩm. Vui lòng thử lại.
                    <button type="button" onclick="document.getElementById('quickViewDialog').close()" class="mt-4 block mx-auto px-4 py-2 bg-slate-100 rounded-xl">Đóng</button>
                </div>
            `;
        }
    }
    // Load Recently Viewed Products on Home
    (function loadHomeRecentViews() {
        try {
            const list = JSON.parse(localStorage.getItem('techstore_recently_viewed') || '[]');
            if (Array.isArray(list) && list.length > 0) {
                const container = document.getElementById('homeRecentlyViewed');
                const listEl = document.getElementById('homeRecentList');
                if (container && listEl) {
                    listEl.innerHTML = list.slice(0, 6).map(p => `
                        <a href="/product/${p.slug}" class="bg-white p-3 rounded-2xl border border-slate-200 hover:border-blue-500 hover:shadow-md transition-all flex flex-col justify-between group">
                            <div class="h-28 bg-slate-50 rounded-xl overflow-hidden flex items-center justify-center p-2 mb-2">
                                <img src="${p.image}" alt="${p.name}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" onerror="this.src='/assets/images/placeholder.png'" />
                            </div>
                            <div>
                                <span class="text-[10px] text-slate-400 font-bold uppercase">${p.category || ''}</span>
                                <h4 class="text-xs font-bold text-slate-800 line-clamp-1 group-hover:text-blue-600 transition mt-0.5">${p.name}</h4>
                                <p class="text-xs font-black text-blue-600 mt-1">${(p.price || 0).toLocaleString('vi-VN')} đ</p>
                            </div>
                        </a>
                    `).join('');
                    container.classList.remove('hidden');
                }
            }
        } catch(e) {}
    })();

    function clearHomeRecentViews() {
        localStorage.removeItem('techstore_recently_viewed');
        const container = document.getElementById('homeRecentlyViewed');
        if (container) container.classList.add('hidden');
    }
</script>
}

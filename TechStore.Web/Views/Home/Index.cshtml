@model TechStore.Web.Controllers.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Siêu Thị Công Nghệ Best Buy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto px-4 py-6 space-y-10">
    <!-- 1. Hero Section: Banner Slider động & Sub-banners -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Main Slider (Chiếm 2/3 bề rộng) -->
        <div class="lg:col-span-2 relative rounded-2xl overflow-hidden shadow-sm bg-white border border-slate-200">
            <div id="heroSliderTrack" class="relative h-[260px] sm:h-[340px] w-full overflow-hidden">
                @for (int i = 0; i < Model.HeroSliders.Count; i++)
                {
                    var b = Model.HeroSliders[i];
                    <div class="slider-slide absolute inset-0 transition-opacity duration-700 ease-in-out @(i == 0 ? "opacity-100 z-10" : "opacity-0 z-0")" data-index="@i">
                        <a href="@(string.IsNullOrEmpty(b.TargetUrl) ? "#" : b.TargetUrl)" class="block w-full h-full relative">
                            <img src="@b.ImageUrl" alt="@b.Title" class="w-full h-full object-cover object-center" onerror="this.src='/assets/images/iphone-16-pro-max.png'" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/30 to-transparent flex flex-col justify-end p-6 text-white">
                                <span class="px-2.5 py-1 bg-bestbuy-yellow text-slate-900 font-extrabold text-[11px] rounded-md w-fit mb-2 uppercase tracking-wide">Ưu Đãi Đặc Biệt</span>
                                <h2 class="text-xl sm:text-2xl font-black leading-tight">@b.Title</h2>
                                @if (!string.IsNullOrEmpty(b.Subtitle))
                                {
                                    <p class="text-xs sm:text-sm text-slate-200 mt-1 line-clamp-1 font-medium">@b.Subtitle</p>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>

            <!-- Nút Prev/Next Slider -->
            <button onclick="changeHeroSlide(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-white/80 hover:bg-white text-slate-800 flex items-center justify-center shadow-md">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <button onclick="changeHeroSlide(1)" class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-white/80 hover:bg-white text-slate-800 flex items-center justify-center shadow-md">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>

        <!-- Sub-banners Cạnh Slider (Chiếm 1/3 bề rộng) -->
        <div class="flex flex-col gap-4">
            @foreach (var sb in Model.SubBanners)
            {
                <a href="@(string.IsNullOrEmpty(sb.TargetUrl) ? "#" : sb.TargetUrl)" class="relative h-[160px] rounded-2xl overflow-hidden shadow-sm border border-slate-200 group block">
                    <img src="@sb.ImageUrl" alt="@sb.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/macbook-pro-16-m4.png'" />
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 to-transparent p-4 flex flex-col justify-center text-white">
                        <span class="text-[10px] font-bold text-bestbuy-yellow uppercase">Khuyến mãi hot</span>
                        <h4 class="font-extrabold text-sm sm:text-base leading-snug">@sb.Title</h4>
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- 2. Danh Mục Sản Phẩm Nổi Bật (Icon Cards) -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
                <span class="w-2.5 h-6 bg-blue-600 rounded-sm"></span>
                <span>Danh Mục Công Nghệ Hàng Đầu</span>
            </h2>
            <a href="/products" class="text-xs font-bold text-blue-600 hover:underline">Xem tất cả &rarr;</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
            @foreach (var cat in Model.Categories)
            {
                <a href="/category/@cat.Slug" class="bg-white p-4 rounded-xl border border-slate-200 hover:border-blue-500 hover:shadow-md transition-all text-center group block">
                    <div class="w-12 h-12 mx-auto rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors mb-2.5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                    </div>
                    <span class="text-xs font-bold text-slate-800 block group-hover:text-blue-600 transition-colors">@cat.Name</span>
                </a>
            }
        </div>
    </div>

    <!-- 3. Thiết Bị Công Nghệ Flagship Nổi Bật -->
    <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200">
            <div>
                <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-bestbuy-yellow rounded-sm border border-slate-300"></span>
                    <span>Thiết Bị Công Nghệ Nổi Bật 2026</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Sản phẩm chính hãng phân phối trực tiếp từ Apple, Samsung, Dell, Asus, Sony</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var p in Model.FeaturedProducts)
            {
                var minVariant = p.Variants.OrderBy(v => v.SalePrice).FirstOrDefault();
                decimal displayPrice = minVariant?.SalePrice ?? 0;
                decimal originalPrice = minVariant?.OriginalPrice ?? 0;
                int discountPercent = originalPrice > displayPrice ? (int)Math.Round((1 - displayPrice / originalPrice) * 100) : 0;

                <div class="bg-white rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-lg transition-all p-4 flex flex-col justify-between group">
                    <div>
                        <!-- Product Thumbnail & Discount Badge -->
                        <div class="relative h-48 bg-slate-50 rounded-xl overflow-hidden flex items-center justify-center p-3 mb-3">
                            <img src="@p.FeaturedImage" alt="@p.Name" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.src='/assets/images/placeholder.png'" />
                            @if (discountPercent > 0)
                            {
                                <span class="absolute top-2 left-2 px-2 py-0.5 text-[10px] font-black bg-rose-600 text-white rounded-md shadow-sm">
                                    -@discountPercent%
                                </span>
                            }
                            <span class="absolute top-2 right-2 px-2 py-0.5 text-[10px] font-bold bg-white/90 text-slate-700 rounded-md border border-slate-200">
                                @p.Brand.Name
                            </span>
                        </div>

                        <!-- Product Title & Short Info -->
                        <a href="/product/@p.Slug" class="font-bold text-slate-900 text-sm line-clamp-2 hover:text-blue-600 transition-colors leading-snug">
                            @p.Name
                        </a>
                        <p class="text-[11px] text-slate-500 mt-1 line-clamp-1 font-medium">@p.ShortDescription</p>
                    </div>

                    <!-- Price & Add To Cart Button -->
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <div class="text-base font-black text-blue-600">@displayPrice.ToString("N0") đ</div>
                            @if (originalPrice > displayPrice)
                            {
                                <div class="text-xs text-slate-400 line-through">@originalPrice.ToString("N0") đ</div>
                            }
                        </div>
                        @if (minVariant != null && minVariant.StockQuantity > 0)
                        {
                            <button onclick="addToCart(@minVariant.VariantId, 1, true)" class="p-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-transform active:scale-95" title="Thêm vào giỏ hàng">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Hero Slider Carousel Logic
    let currentSlide = 0;
    const slides = document.querySelectorAll('.slider-slide');
    function showSlide(index) {
        if (!slides.length) return;
        slides.forEach(s => {
            s.classList.remove('opacity-100', 'z-10');
            s.classList.add('opacity-0', 'z-0');
        });
        currentSlide = (index + slides.length) % slides.length;
        slides[currentSlide].classList.remove('opacity-0', 'z-0');
        slides[currentSlide].classList.add('opacity-100', 'z-10');
    }
    function changeHeroSlide(step) { showSlide(currentSlide + step); }
    setInterval(() => { changeHeroSlide(1); }, 5000);
</script>
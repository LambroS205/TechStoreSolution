@model TechStore.Web.Controllers.ContactFormViewModel
@{
    ViewData["Title"] = "Liên Hệ & Hỗ Trợ Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-6xl mx-auto px-4 py-12 space-y-8">
    <!-- Header -->
    <div class="text-center space-y-2 max-w-2xl mx-auto">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Trung Tâm Hỗ Trợ</span>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Liên Hệ Với TechStore</h1>
        <p class="text-xs sm:text-sm text-slate-500">
            Chúng tôi luôn sẵn sàng lắng nghe mọi thắc mắc, phản hồi và yêu cầu tư vấn thiết bị từ quý khách 24/7.
        </p>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Contact Channels Info (1/3) -->
        <div class="space-y-6">
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-5">
                <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Kênh Hỗ Trợ Trực Tiếp</h3>

                <!-- Hotline -->
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400 font-semibold block uppercase">Tổng Đài Miễn Phí</span>
                        <strong class="text-slate-900 text-sm font-bold">1800 6868</strong>
                        <p class="text-[11px] text-slate-500 mt-0.5">8:00 - 21:30 (Thứ 2 - CN)</p>
                    </div>
                </div>

                <!-- Email -->
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400 font-semibold block uppercase">Hộp Thư Điện Tử</span>
                        <strong class="text-slate-900 text-sm font-bold">support@techstore.vn</strong>
                        <p class="text-[11px] text-slate-500 mt-0.5">Phản hồi trong 24 giờ</p>
                    </div>
                </div>

                <!-- Address -->
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400 font-semibold block uppercase">Trụ Sở Flagship Store</span>
                        <strong class="text-slate-900 text-sm font-bold">Tòa nhà TechStore</strong>
                        <p class="text-[11px] text-slate-500 mt-0.5 leading-relaxed">
                            123 Đường Công Nghệ Mới, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form (2/3) -->
        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 shadow-sm p-8 space-y-6">
            <h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Gửi Lời Nhắn Đến TechStore</h3>

            <form action="/contact" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Họ và Tên <span class="text-rose-500">*</span></label>
                        <input type="text" name="FullName" value="@Model?.FullName" required class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" placeholder="Nguyễn Văn A" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Số Điện Thoại</label>
                        <input type="tel" name="PhoneNumber" value="@Model?.PhoneNumber" class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" placeholder="0912 345 678" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Địa Chỉ Email <span class="text-rose-500">*</span></label>
                        <input type="email" name="Email" value="@Model?.Email" required class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" placeholder="email@example.com" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Chủ Đề Cần Hỗ Trợ</label>
                        <input type="text" name="Subject" value="@Model?.Subject" class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" placeholder="Tư vấn đơn hàng, bảo hành..." />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nội Dung Tin Nhắn <span class="text-rose-500">*</span></label>
                    <textarea name="Message" rows="5" required class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-bestbuy-blue" placeholder="Chi tiết nội dung cần trợ giúp hoặc yêu cầu báo giá doanh nghiệp...">@Model?.Message</textarea>
                </div>

                <button type="submit" class="w-full sm:w-auto px-8 py-3.5 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-sm rounded-xl shadow-md transition-all active:scale-95">
                    GỬI LIÊN HỆ NGAY
                </button>
            </form>
        </div>
    </div>
</div>

@model List<TechStore.Core.Entities.CustomerAddress>
@{
    ViewData["Title"] = "Sổ Địa Chỉ Nhận Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a href="/" class="hover:text-blue-600">Trang chủ</a>
                <span>/</span>
                <a href="/account/profile" class="hover:text-blue-600">Tài khoản</a>
                <span>/</span>
                <span class="text-slate-600">Sổ địa chỉ</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span>Sổ Địa Chỉ Nhận Hàng</span>
                <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-100">
                    @Model.Count địa chỉ
                </span>
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Quản lý địa chỉ giao hàng để đặt hàng nhanh chóng hơn mà không cần nhập lại thông tin</p>
        </div>

        <button type="button" onclick="openAddressModal()" class="px-4 py-2.5 bg-bestbuy-blue hover:bg-bestbuy-darkblue text-white text-xs font-bold rounded-xl shadow-xs transition-all flex items-center gap-2 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>Thêm Địa Chỉ Mới</span>
        </button>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">&times;</button>
        </div>
    }

    <!-- Address Cards Grid -->
    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            @foreach (var addr in Model)
            {
                <div class="bg-white rounded-2xl border @(addr.IsDefault ? "border-bestbuy-blue ring-2 ring-blue-100 shadow-md" : "border-slate-200 shadow-xs") p-5 flex flex-col justify-between space-y-4 hover:border-blue-400 transition-all">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <h3 class="font-extrabold text-slate-900 text-sm flex items-center gap-2">
                                <span>@addr.RecipientName</span>
                                @if (addr.IsDefault)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-100 text-bestbuy-blue">
                                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                                        Mặc định
                                    </span>
                                }
                            </h3>
                            <span class="text-xs font-semibold text-slate-500">@addr.PhoneNumber</span>
                        </div>

                        <div class="text-xs text-slate-600 leading-relaxed">
                            <p class="font-medium text-slate-800">@addr.StreetAddress</p>
                            <p class="text-slate-500">@addr.Ward, @addr.District, @addr.Province</p>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                        <div>
                            @if (!addr.IsDefault)
                            {
                                <form method="post" action="/account/addresses/set-default/@addr.AddressId" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-blue-600 hover:text-blue-800 font-bold">
                                        Đặt làm mặc định
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-[11px] text-emerald-600 font-bold flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                    Địa chỉ nhận hàng chính
                                </span>
                            }
                        </div>

                        <form method="post" action="/account/addresses/delete/@addr.AddressId" onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa chỉ này?');" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-slate-400 hover:text-rose-600 font-medium transition-colors">
                                Xóa
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center space-y-4">
            <div class="w-16 h-16 mx-auto rounded-full bg-blue-50 text-bestbuy-blue flex items-center justify-center">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-800">Bạn chưa có địa chỉ nhận hàng nào</h3>
                <p class="text-xs text-slate-400 max-w-md mx-auto">Thêm địa chỉ giao hàng để hệ thống tự động điền sẵn thông tin khi thanh toán đơn hàng tiếp theo!</p>
            </div>
            <button type="button" onclick="openAddressModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-bestbuy-blue hover:bg-bestbuy-darkblue text-white text-xs font-bold rounded-xl shadow-xs transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                <span>Thêm Địa Chỉ Đầu Tiên</span>
            </button>
        </div>
    }
</div>

<!-- Add Address Modal -->
<div id="addressModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 space-y-5 shadow-2xl border border-slate-100">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-slate-900">Thêm Địa Chỉ Nhận Hàng Mới</h3>
            <button type="button" onclick="closeAddressModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-lg">&times;</button>
        </div>

        <form method="post" action="/account/addresses/create" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Họ Tên Người Nhận <span class="text-rose-500">*</span></label>
                    <input type="text" name="RecipientName" required placeholder="VD: Nguyễn Văn A" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Số Điện Thoại <span class="text-rose-500">*</span></label>
                    <input type="tel" name="PhoneNumber" required placeholder="VD: 0909123456" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-900 focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tỉnh / TP <span class="text-rose-500">*</span></label>
                    <input type="text" name="Province" required placeholder="Hồ Chí Minh" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-900 focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Quận / Huyện <span class="text-rose-500">*</span></label>
                    <input type="text" name="District" required placeholder="Quận 1" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-900 focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Phường / Xã <span class="text-rose-500">*</span></label>
                    <input type="text" name="Ward" required placeholder="Bến Nghé" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-900 focus:ring-2 focus:ring-blue-600 focus:outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Địa Chỉ Chi Tiết (Số nhà, Tên đường) <span class="text-rose-500">*</span></label>
                <input type="text" name="StreetAddress" required placeholder="VD: 123 Đường Lê Lợi" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-900 focus:ring-2 focus:ring-blue-600 focus:outline-none" />
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="IsDefault" name="IsDefault" value="true" class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300" />
                <label for="IsDefault" class="text-xs font-semibold text-slate-700">
                    Đặt làm địa chỉ nhận hàng mặc định cho các đơn mua tiếp theo
                </label>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeAddressModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
                    Hủy
                </button>
                <button type="submit" class="px-5 py-2 bg-bestbuy-blue hover:bg-bestbuy-darkblue text-white text-xs font-bold rounded-xl transition-colors">
                    Lưu Địa Chỉ
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddressModal() {
        document.getElementById('addressModal').classList.remove('hidden');
    }
    function closeAddressModal() {
        document.getElementById('addressModal').classList.add('hidden');
    }
</script>

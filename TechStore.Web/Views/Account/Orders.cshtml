@model List<TechStore.Core.Entities.Order>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentStatus = ViewBag.CurrentStatus as string ?? "All";

    int totalCount = ViewBag.TotalOrdersCount ?? Model.Count;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int confirmedCount = ViewBag.ConfirmedCount ?? 0;
    int processingCount = ViewBag.ProcessingCount ?? 0;
    int shippingCount = ViewBag.ShippingCount ?? 0;
    int deliveredCount = ViewBag.DeliveredCount ?? 0;
    int cancelledCount = ViewBag.CancelledCount ?? 0;
}

<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a href="/" class="hover:text-blue-600">Trang chủ</a>
                <span>/</span>
                <a href="/account/profile" class="hover:text-blue-600">Tài khoản</a>
                <span>/</span>
                <span class="text-slate-600">Lịch sử đơn hàng</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900">Đơn Hàng Của Tôi</h1>
        </div>
        <a href="/products" class="px-4 py-2 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 text-xs font-black rounded-xl transition-colors shadow-sm shrink-0">
            Tiếp Tục Mua Sắm
        </a>
    </div>

    <!-- Status Filter Tabs with Actual Counts -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 text-xs font-semibold no-scrollbar">
        <a href="/account/orders?status=All" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "All" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Tất Cả (@totalCount)
        </a>
        <a href="/account/orders?status=Pending" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Pending" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Chờ Xác Nhận (@pendingCount)
        </a>
        <a href="/account/orders?status=Confirmed" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Confirmed" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Đã Xác Nhận (@confirmedCount)
        </a>
        <a href="/account/orders?status=Processing" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Processing" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Đang Đóng Gói (@processingCount)
        </a>
        <a href="/account/orders?status=Shipping" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Shipping" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Đang Giao Hàng (@shippingCount)
        </a>
        <a href="/account/orders?status=Delivered" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Delivered" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Đã Giao Thành Công (@deliveredCount)
        </a>
        <a href="/account/orders?status=Cancelled" class="px-4 py-2 rounded-xl transition-colors whitespace-nowrap @(currentStatus == "Cancelled" ? "bg-bestbuy-blue text-white font-bold" : "bg-white text-slate-600 hover:bg-slate-100")">
            Đã Hủy (@cancelledCount)
        </a>
    </div>

    <!-- Orders List -->
    <div class="space-y-4">
        @if (Model.Count == 0)
        {
            <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center space-y-4 shadow-sm">
                <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-800">Không có đơn hàng nào trong mục này</h3>
                    <p class="text-xs text-slate-400 mt-1">Khám phá hàng ngàn thiết bị công nghệ chính hãng với ưu đãi hấp dẫn!</p>
                </div>
                <div>
                    <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 bg-bestbuy-yellow hover:bg-yellow-400 text-slate-950 font-black text-xs rounded-xl shadow-md transition-all">
                        <span>Khám Phá Sản Phẩm Ngay</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var o in Model)
            {
                <div class="bg-white rounded-3xl border border-slate-200 shadow-xs hover:shadow-sm transition-shadow p-5 space-y-4">
                    <!-- Top Info -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="font-mono font-bold text-sm text-slate-900">#@o.OrderCode</span>
                            <span class="text-slate-300">|</span>
                            <span class="text-xs text-slate-400">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <!-- Payment Status Badge -->
                            <span class="inline-block px-2.5 py-1 text-[11px] font-bold rounded-lg @(o.PaymentStatus == "Paid" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                                @(o.PaymentMethod == "VietQR" ? "VietQR" : "COD") - @(o.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                            </span>

                            <!-- Order Status Badge -->
                            <span class="inline-block px-2.5 py-1 text-[11px] font-bold rounded-lg @(o.OrderStatus switch {
                                "Pending" => "bg-blue-100 text-blue-800",
                                "Confirmed" => "bg-sky-100 text-sky-800",
                                "Processing" => "bg-amber-100 text-amber-800",
                                "Shipping" => "bg-indigo-100 text-indigo-800",
                                "Delivered" => "bg-emerald-100 text-emerald-800",
                                "Cancelled" => "bg-rose-100 text-rose-800",
                                _ => "bg-slate-100 text-slate-700"
                            })">
                                @(o.OrderStatus switch {
                                    "Pending" => "Chờ xác nhận",
                                    "Confirmed" => "Đã xác nhận",
                                    "Processing" => "Đang đóng gói",
                                    "Shipping" => "Đang giao hàng",
                                    "Delivered" => "Đã giao thành công",
                                    "Cancelled" => "Đã hủy",
                                    _ => o.OrderStatus
                                })
                            </span>
                        </div>
                    </div>

                    <!-- Items Summary -->
                    <div class="divide-y divide-slate-100">
                        @foreach (var item in o.OrderDetails)
                        {
                            <div class="py-2.5 flex items-center justify-between gap-4 text-xs">
                                <div class="min-w-0">
                                    <p class="font-bold text-slate-800 truncate">@item.ProductName</p>
                                    <p class="text-[11px] text-slate-400">@item.VariantName &bull; Số lượng: <strong class="text-slate-700">@item.Quantity</strong></p>
                                </div>
                                <div class="font-bold text-slate-900 shrink-0">
                                    @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Footer Action & Total -->
                    <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="text-xs text-slate-500">
                            Giao tới: <strong class="text-slate-700">@o.CustomerName</strong> (@o.ShippingAddress)
                        </div>
                        <div class="flex items-center justify-between sm:justify-end gap-3">
                            <div>
                                <span class="text-xs text-slate-500">Tổng tiền:</span>
                                <strong class="text-base font-black text-blue-600 ml-1">@o.TotalAmount.ToString("N0") đ</strong>
                            </div>
                            <!-- Nút Mua lại đơn này -->
                            <button type="button" onclick="reorderItems('@o.OrderCode')" class="px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-600 text-xs font-bold rounded-xl transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                <span>Mua Lại</span>
                            </button>
                            <a href="/account/order/@o.OrderCode" class="px-4 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-xl transition-colors">
                                Chi Tiết &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
    async function reorderItems(orderCode) {
        try {
            const res = await fetch(`/account/order/${orderCode}/items-json`);
            if (!res.ok) throw new Error();
            const items = await res.json();
            if (Array.isArray(items) && items.length > 0) {
                items.forEach(it => {
                    addToCart(it.variantId, it.quantity, false);
                });
                if (window.showToast) {
                    showToast(`Đã thêm ${items.length} sản phẩm từ đơn #${orderCode} vào giỏ hàng!`, 'success');
                }
                toggleCartDrawer(true);
            }
        } catch(e) {
            alert('Không thể tải sản phẩm để mua lại.');
        }
    }
</script>
}

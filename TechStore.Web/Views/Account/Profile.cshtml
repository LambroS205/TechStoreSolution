@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-6xl mx-auto px-4 py-8 space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a href="/" class="hover:text-blue-600">Trang chủ</a>
                <span>/</span>
                <span class="text-slate-600">Tài khoản của tôi</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900">Hồ Sơ & Cài Đặt Tài Khoản</h1>
        </div>
        <a href="/account/orders" class="px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            <span>Đơn Hàng Của Tôi (@Model.TotalOrders)</span>
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">&times;</button>
        </div>
    }

    <!-- VIP TechMember Privilege Card -->
    <div class="relative overflow-hidden rounded-3xl p-6 sm:p-8 text-white shadow-xl @(Model.VipTier switch {
        "Diamond" => "bg-gradient-to-r from-slate-900 via-purple-950 to-indigo-900 border border-purple-500/30",
        "Gold" => "bg-gradient-to-r from-amber-700 via-amber-600 to-yellow-600 border border-amber-400/30",
        "Silver" => "bg-gradient-to-r from-slate-800 via-slate-700 to-zinc-700 border border-slate-500/30",
        _ => "bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 border border-blue-500/30"
    })">
        <!-- Background decorative ambient circles -->
        <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-white/5 blur-2xl pointer-events-none"></div>
        <div class="absolute -left-12 -bottom-12 w-64 h-64 rounded-full bg-yellow-400/10 blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-3">
                <div class="flex items-center gap-3">
                    <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider backdrop-blur-md @(Model.VipTier switch {
                        "Diamond" => "bg-purple-500/30 text-purple-200 border border-purple-400/30",
                        "Gold" => "bg-amber-400/30 text-amber-100 border border-amber-300/30",
                        "Silver" => "bg-slate-300/30 text-slate-100 border border-slate-200/30",
                        _ => "bg-blue-400/30 text-blue-100 border border-blue-300/30"
                    })">
                        @Model.VipTierDisplayName
                    </span>
                    <span class="text-xs text-white/70">Mã KH: <strong>#TECH@(Model.UserId.ToString("D5"))</strong></span>
                </div>

                <div>
                    <h2 class="text-2xl sm:text-3xl font-black tracking-tight">@Model.FullName</h2>
                    <p class="text-xs text-white/80 mt-1">
                        Tổng tích lũy chi tiêu: <span class="text-base font-extrabold text-yellow-300">@Model.TotalSpent.ToString("N0") đ</span>
                        @if (Model.VipTier != "Diamond")
                        {
                            <span>&bull; Còn thiếu <strong class="text-white font-bold">@Model.AmountNeededForNextTier.ToString("N0") đ</strong> để thăng hạng <strong class="text-yellow-300">@Model.NextTierName</strong></span>
                        }
                        else
                        {
                            <span class="text-emerald-300 font-bold">&bull; Bạn đang giữ hạng thẻ VIP cao cấp nhất!</span>
                        }
                    </p>
                </div>

                <!-- Progress bar -->
                <div class="space-y-1.5 max-w-md">
                    <div class="flex items-center justify-between text-[11px] text-white/75 font-semibold">
                        <span>Tiến trình thăng hạng</span>
                        <span>@Model.TierProgressPercent%</span>
                    </div>
                    <div class="w-full h-2.5 rounded-full bg-white/20 overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-1000 @(Model.VipTier == "Diamond" ? "bg-gradient-to-r from-purple-400 to-pink-400" : "bg-gradient-to-r from-yellow-400 to-amber-300")" style="width: @Model.TierProgressPercent%"></div>
                    </div>
                </div>
            </div>

            <!-- Privileges highlight -->
            <div class="bg-black/25 backdrop-blur-md rounded-2xl p-4 border border-white/10 shrink-0 md:max-w-xs space-y-2">
                <span class="text-[10px] uppercase font-black tracking-wider text-yellow-400 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    Đặc Quyền Thành Viên @Model.VipTier
                </span>
                <ul class="text-xs space-y-1.5 text-white/90">
                    <li class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span>Hoàn xu TechXu: <strong>@(Model.VipTier switch { "Diamond" => "3.5%", "Gold" => "2.0%", "Silver" => "1.0%", _ => "0.5%" })</strong></span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span>Đổi trả miễn phí: <strong>@(Model.VipTier switch { "Diamond" => "60 ngày 1-đổi-1", "Gold" => "45 ngày", "Silver" => "30 ngày", _ => "15 ngày" })</strong></span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span>Ưu tiên kỹ thuật: <strong>@(Model.VipTier == "Diamond" ? "Hotline VIP 24/7" : "Hỗ trợ tiêu chuẩn")</strong></span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tổng Đơn Hàng</span>
                <h3 class="text-2xl font-black text-slate-900 mt-1">@Model.TotalOrders</h3>
                <a href="/account/orders" class="text-xs text-blue-600 font-semibold hover:underline mt-1 inline-block">Xem lịch sử đơn &rarr;</a>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Đang Xử Lý / Giao</span>
                <h3 class="text-2xl font-black text-indigo-600 mt-1">@Model.ActiveOrdersCount</h3>
                <span class="text-xs text-slate-500 mt-1 inline-block">Theo dõi tiến độ giao</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tổng Tích Lũy Mua Hàng</span>
                <h3 class="text-2xl font-black text-emerald-600 mt-1">@Model.TotalSpent.ToString("N0") <span class="text-xs font-normal text-slate-500">đ</span></h3>
                <span class="text-xs text-slate-500 mt-1 inline-block">Hạng: <strong class="text-slate-800">@Model.RoleName</strong></span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>
    </div>

    <!-- Profile & Password Forms Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Thông tin cá nhân (2/3) -->
        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-5">
            <h2 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Thông Tin Cá Nhân</h2>

            <form action="/account/update-profile" method="post" enctype="multipart/form-data" class="space-y-4">
                @Html.AntiForgeryToken()

                <div class="flex items-center gap-4 pb-2">
                    <div class="w-16 h-16 rounded-2xl bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shrink-0">
                        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="@Model.FullName" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <span class="text-2xl font-black text-blue-600">@Model.FullName.Substring(0, 1).ToUpper()</span>
                        }
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Ảnh đại diện mới:</label>
                        <input type="file" name="avatarFile" accept="image/*" class="text-xs file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 cursor-pointer" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tên Đăng Nhập</label>
                        <input type="text" value="@Model.Username" disabled class="w-full text-xs font-mono bg-slate-100 text-slate-500 border border-slate-200 rounded-xl p-3 cursor-not-allowed" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Địa Chỉ Email</label>
                        <input type="text" value="@Model.Email" disabled class="w-full text-xs bg-slate-100 text-slate-500 border border-slate-200 rounded-xl p-3 cursor-not-allowed" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Họ và Tên <span class="text-rose-500">*</span></label>
                        <input type="text" name="FullName" value="@Model.FullName" required class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Số Điện Thoại</label>
                        <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" class="w-full text-sm border border-slate-300 rounded-xl p-3 outline-none focus:ring-2 focus:ring-blue-500" placeholder="0912 345 678" />
                    </div>
                </div>

                <div class="text-[11px] text-slate-400 pt-1">
                    Ngày tham gia hệ thống: <strong class="text-slate-600">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>

                <div class="pt-2">
                    <button type="submit" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-xs transition-colors">
                        Lưu Thông Tin Cá Nhân
                    </button>
                </div>
            </form>
        </div>

        <!-- Đổi mật khẩu (1/3) -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-5">
            <h2 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3">Đổi Mật Khẩu</h2>

            <form action="/account/change-password" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Mật Khẩu Hiện Tại <span class="text-rose-500">*</span></label>
                    <input type="password" name="CurrentPassword" required class="w-full text-sm border border-slate-300 rounded-xl p-2.5 outline-none focus:ring-2 focus:ring-blue-500" placeholder="••••••••" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Mật Khẩu Mới <span class="text-rose-500">*</span></label>
                    <input type="password" name="NewPassword" required minlength="8" class="w-full text-sm border border-slate-300 rounded-xl p-2.5 outline-none focus:ring-2 focus:ring-blue-500" placeholder="Tối thiểu 8 ký tự (chữ & số)" />
                    <p class="text-[11px] text-slate-400 mt-1">Tối thiểu 8 ký tự, gồm cả chữ cái và chữ số, không chứa khoảng trắng.</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Xác Nhận Mật Khẩu Mới <span class="text-rose-500">*</span></label>
                    <input type="password" name="ConfirmPassword" required minlength="8" class="w-full text-sm border border-slate-300 rounded-xl p-2.5 outline-none focus:ring-2 focus:ring-blue-500" placeholder="Nhập lại mật khẩu mới" />
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full py-2.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-xl transition-colors">
                        Cập Nhật Mật Khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
